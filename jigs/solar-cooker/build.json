[
["variable.set", {"name": "D", "expr": "1000 mm"}],
["variable.set", {"name": "fD", "expr": "0.3"}],
["variable.set", {"name": "N", "expr": "20"}],
["variable.set", {"name": "th", "expr": "2 mm"}],
["variable.set", {"name": "pot", "expr": "2"}],
["variable.set", {"name": "elev", "expr": "50 deg"}],
["variable.set", {"name": "clearG", "expr": "150 mm"}],
["variable.set", {"name": "tabW", "expr": "15 mm"}],
["table.set", {"name": "pots", "columns": ["pot", {"name": "d", "unit": "mm"}, {"name": "h", "unit": "mm"}], "rows": [["Pot 16 cm", 160, 110], ["Pot 20 cm", 200, 130], ["Pot 24 cm", 240, 150], ["Kettle", 170, 200]]}],
["variable.set", {"name": "potD", "expr": "pots[pot].d"}],
["variable.set", {"name": "potH", "expr": "pots[pot].h"}],
["variable.set", {"name": "f", "expr": "fD * D"}],
["variable.set", {"name": "R", "expr": "D / 2"}],
["variable.set", {"name": "r0", "expr": "max(D / 20, N * 20 mm / (2 * pi))"}],
["variable.set", {"name": "depth", "expr": "D^2 / (16 * f)"}],
["variable.set", {"name": "rimAngle", "expr": "2 * atan(1 / (4 * fD))"}],
["variable.set", {"name": "tilt", "expr": "90 deg - elev"}],
["variable.set", {"name": "wa", "expr": "360 deg / N"}],
["variable.set", {"name": "Rw", "expr": "(R + 10 mm) / cos(wa / 2)"}],
["variable.set", {"name": "S0", "expr": "((r0) / 2 * sqrt(1 + ((r0) / (2 * f))^2) + f * ln(((r0) / (2 * f)) + sqrt(1 + ((r0) / (2 * f))^2)))"}],
["variable.set", {"name": "SR", "expr": "((R) / 2 * sqrt(1 + ((R) / (2 * f))^2) + f * ln(((R) / (2 * f)) + sqrt(1 + ((R) / (2 * f))^2)))"}],
["variable.set", {"name": "L", "expr": "SR - S0"}],
["variable.set", {"name": "halfR", "expr": "pi * R / N"}],
["variable.set", {"name": "half0", "expr": "pi * r0 / N"}],
["variable.set", {"name": "gap", "expr": "10 mm"}],
["variable.set", {"name": "M", "expr": "2 * pi / N * (R - L / (2 * sqrt(1 + (R / (2 * f))^2)))"}],
["variable.set", {"name": "nestP", "expr": "M + 2 * tabW + gap"}],
["variable.set", {"name": "pitch", "expr": "2 * M + 2 * tabW + 2 * gap"}],
["variable.set", {"name": "nA", "expr": "ceil(N / 2)"}],
["variable.set", {"name": "nB", "expr": "floor(N / 2)"}],
["variable.set", {"name": "seg", "expr": "(R - r0) / 11"}],
["variable.set", {"name": "tc", "expr": "min(tabW / 2, seg / 4)"}],
["variable.set", {"name": "hoopH", "expr": "25 mm"}],
["variable.set", {"name": "hoopT", "expr": "4 mm"}],
["variable.set", {"name": "Rh", "expr": "R + 1 mm + hoopT"}],
["variable.set", {"name": "Yu", "expr": "Rh + 31 mm"}],
["variable.set", {"name": "rhoMax", "expr": "sqrt(Rh^2 + (f - depth + hoopH)^2)"}],
["variable.set", {"name": "baseH", "expr": "60 mm"}],
["variable.set", {"name": "zF", "expr": "baseH + clearG + rhoMax"}],
["variable.set", {"name": "ringT", "expr": "4 mm"}],
["variable.set", {"name": "rIn", "expr": "potD / 2 - 20 mm"}],
["variable.set", {"name": "rOut", "expr": "potD / 2 + 15 mm"}],
["variable.set", {"name": "potZ", "expr": "zF - potH / 4"}],
["variable.set", {"name": "ringZ", "expr": "potZ - ringT"}],
["variable.set", {"name": "zTop", "expr": "potZ + potH + 46 mm"}],
["variable.set", {"name": "footL", "expr": "0.6 * Yu"}],
["variable.set", {"name": "X0", "expr": "max(rhoMax, footL) + 150 mm"}],
["variable.set", {"name": "Y0", "expr": "-(N - 1) * pitch / 4"}],
["sketch.create", {"name": "Meridian", "plane": "zx"}],
["sketch.curve", {"sketch": "Meridian", "x": "t^2 / (4 * f)", "y": "t", "t": ["r0", "R"]}],
["sketch.curve", {"sketch": "Meridian", "x": "t^2 / (4 * f) + th", "y": "t", "t": ["r0", "R"]}],
["sketch.line", {"sketch": "Meridian", "from": "e1", "to": "e4"}],
["sketch.line", {"sketch": "Meridian", "from": "e2", "to": "e5"}],
["feature.revolve", {"sketch": "Meridian", "axis": "x", "name": "DishFull"}],
["feature.transform", {"source": "DishFull", "keep": true, "name": "DishCopy"}],
["sketch.create", {"name": "Wedge", "plane": "xy", "offset": "-10 mm"}],
["sketch.path", {"sketch": "Wedge", "start": ["r0 / 2", "0 mm"], "closed": true, "segments": [{"line": ["Rw", "0 mm"]}, {"line": ["Rw * cos(wa)", "Rw * sin(wa)"]}, {"line": ["r0 / 2 * cos(wa)", "r0 / 2 * sin(wa)"]}]}],
["sketch.pattern", {"sketch": "Wedge", "entities": ["e3", "e5", "e7", "e8"], "angle": "2 * wa", "center": ["0 mm", "0 mm"], "count": "nB"}],
["feature.extrude", {"sketch": "Wedge", "distance": "depth + th + 20 mm", "name": "Wedges"}],
["feature.boolean", {"op": "subtract", "target": "DishFull", "tool": "Wedges", "keepTool": true, "name": "DishA0"}],
["feature.boolean", {"op": "intersect", "target": "DishCopy", "tool": "Wedges", "name": "DishB0"}],
["sketch.create", {"name": "HoopSketch", "plane": "zx"}],
["sketch.path", {"sketch": "HoopSketch", "start": ["depth - hoopH", "R + 1 mm"], "closed": true, "segments": [{"line": ["depth + th", "R + 1 mm"]}, {"line": ["depth + th", "Rh"]}, {"line": ["depth - hoopH", "Rh"]}]}],
["feature.revolve", {"sketch": "HoopSketch", "axis": "x", "name": "Hoop"}],
["feature.block", {"size": ["30 mm", "Rh + 6 mm - (R + 1 mm)", "f + 12 mm - (depth - hoopH)"], "position": ["-15 mm", "R + 1 mm", "depth - hoopH"], "name": "Bracket"}],
["feature.pattern", {"source": "Bracket", "count": "2", "angle": "180 deg", "axis": [0, 0, 1], "name": "Brackets"}],
["feature.cylinder", {"radius": "8 mm", "height": "Yu - 15.5 mm - (Rh + 4 mm)", "axis": [0, 1, 0], "position": ["0 mm", "Rh + 4 mm", "f"], "name": "Pin"}],
["feature.pattern", {"source": "Pin", "count": "2", "angle": "180 deg", "axis": [0, 0, 1], "name": "Pins"}],
["feature.boolean", {"op": "union", "target": "Hoop", "tool": "Brackets", "name": "HoopBrackets"}],
["feature.boolean", {"op": "union", "target": "HoopBrackets", "tool": "Pins", "name": "Mount0"}],
["sketch.create", {"name": "FlangeSketch", "plane": "zx"}],
["sketch.curve", {"sketch": "FlangeSketch", "x": "t^2 / (4 * f) - 3.2 mm", "y": "t", "t": ["r0 - 15 mm", "r0 + 40 mm"]}],
["sketch.curve", {"sketch": "FlangeSketch", "x": "t^2 / (4 * f) - 0.2 mm", "y": "t", "t": ["r0 - 15 mm", "r0 + 40 mm"]}],
["sketch.line", {"sketch": "FlangeSketch", "from": "e1", "to": "e4"}],
["sketch.line", {"sketch": "FlangeSketch", "from": "e2", "to": "e5"}],
["feature.revolve", {"sketch": "FlangeSketch", "axis": "x", "name": "Flange0"}],
["feature.transform", {"angle": "tilt", "axis": [0, 1, 0], "pivot": ["0 mm", "0 mm", "f"], "translate": ["0 mm", "0 mm", "zF - f"], "source": "DishA0", "name": "DishA"}],
["feature.transform", {"angle": "tilt", "axis": [0, 1, 0], "pivot": ["0 mm", "0 mm", "f"], "translate": ["0 mm", "0 mm", "zF - f"], "source": "DishB0", "name": "DishB"}],
["feature.transform", {"angle": "tilt", "axis": [0, 1, 0], "pivot": ["0 mm", "0 mm", "f"], "translate": ["0 mm", "0 mm", "zF - f"], "source": "Mount0", "name": "Mount"}],
["feature.transform", {"angle": "tilt", "axis": [0, 1, 0], "pivot": ["0 mm", "0 mm", "f"], "translate": ["0 mm", "0 mm", "zF - f"], "source": "Flange0", "name": "Flange"}],
["body.appearance", {"body": "DishA", "color": "#B9BEC4", "metallic": 0.8, "roughness": 0.3}],
["body.appearance", {"body": "DishB", "color": "#E8DFCC", "roughness": 0.6}],
["body.appearance", {"body": "Mount", "color": "#7D858C", "metallic": 0.7, "roughness": 0.4}],
["body.appearance", {"body": "Flange", "color": "#B9BEC4", "metallic": 0.8, "roughness": 0.3}],
["set.define", {"name": "Dish", "kind": "body", "where": {"any": [{"in": "DishA"}, {"in": "DishB"}]}}],
["set.define", {"name": "Reflector", "kind": "body", "where": {"any": [{"set": "Dish"}, {"in": "Mount"}, {"in": "Flange"}]}}],
["sketch.create", {"name": "Gore", "plane": "xy"}],
["sketch.curve", {"sketch": "Gore", "x": "X0 + ((t) / 2 * sqrt(1 + ((t) / (2 * f))^2) + f * ln(((t) / (2 * f)) + sqrt(1 + ((t) / (2 * f))^2))) - S0", "y": "Y0 - pi * t / N", "t": ["r0", "R"]}],
["sketch.curve", {"sketch": "Gore", "x": "X0 + ((t) / 2 * sqrt(1 + ((t) / (2 * f))^2) + f * ln(((t) / (2 * f)) + sqrt(1 + ((t) / (2 * f))^2))) - S0", "y": "Y0 + pi * t / N", "t": ["r0 + 0 * seg", "r0 + 1 * seg"]}],
["sketch.curve", {"sketch": "Gore", "x": "X0 + ((t) / 2 * sqrt(1 + ((t) / (2 * f))^2) + f * ln(((t) / (2 * f)) + sqrt(1 + ((t) / (2 * f))^2))) - S0", "y": "Y0 + pi * t / N", "t": ["r0 + 2 * seg", "r0 + 3 * seg"]}],
["sketch.curve", {"sketch": "Gore", "x": "X0 + ((t) / 2 * sqrt(1 + ((t) / (2 * f))^2) + f * ln(((t) / (2 * f)) + sqrt(1 + ((t) / (2 * f))^2))) - S0", "y": "Y0 + pi * t / N", "t": ["r0 + 4 * seg", "r0 + 5 * seg"]}],
["sketch.curve", {"sketch": "Gore", "x": "X0 + ((t) / 2 * sqrt(1 + ((t) / (2 * f))^2) + f * ln(((t) / (2 * f)) + sqrt(1 + ((t) / (2 * f))^2))) - S0", "y": "Y0 + pi * t / N", "t": ["r0 + 6 * seg", "r0 + 7 * seg"]}],
["sketch.curve", {"sketch": "Gore", "x": "X0 + ((t) / 2 * sqrt(1 + ((t) / (2 * f))^2) + f * ln(((t) / (2 * f)) + sqrt(1 + ((t) / (2 * f))^2))) - S0", "y": "Y0 + pi * t / N", "t": ["r0 + 8 * seg", "r0 + 9 * seg"]}],
["sketch.curve", {"sketch": "Gore", "x": "X0 + ((t) / 2 * sqrt(1 + ((t) / (2 * f))^2) + f * ln(((t) / (2 * f)) + sqrt(1 + ((t) / (2 * f))^2))) - S0", "y": "Y0 + pi * t / N", "t": ["r0 + 10 * seg", "r0 + 11 * seg"]}],
["sketch.curve", {"sketch": "Gore", "x": "X0 + ((t) / 2 * sqrt(1 + ((t) / (2 * f))^2) + f * ln(((t) / (2 * f)) + sqrt(1 + ((t) / (2 * f))^2))) - S0", "y": "Y0 + pi * t / N + tabW", "t": ["r0 + 1 * seg + tc", "r0 + 2 * seg - tc"]}],
["sketch.line", {"sketch": "Gore", "from": "e5", "to": "e22"}],
["sketch.line", {"sketch": "Gore", "from": "e23", "to": "e7"}],
["sketch.curve", {"sketch": "Gore", "x": "X0 + ((t) / 2 * sqrt(1 + ((t) / (2 * f))^2) + f * ln(((t) / (2 * f)) + sqrt(1 + ((t) / (2 * f))^2))) - S0", "y": "Y0 + pi * t / N + tabW", "t": ["r0 + 3 * seg + tc", "r0 + 4 * seg - tc"]}],
["sketch.line", {"sketch": "Gore", "from": "e8", "to": "e27"}],
["sketch.line", {"sketch": "Gore", "from": "e28", "to": "e10"}],
["sketch.curve", {"sketch": "Gore", "x": "X0 + ((t) / 2 * sqrt(1 + ((t) / (2 * f))^2) + f * ln(((t) / (2 * f)) + sqrt(1 + ((t) / (2 * f))^2))) - S0", "y": "Y0 + pi * t / N + tabW", "t": ["r0 + 5 * seg + tc", "r0 + 6 * seg - tc"]}],
["sketch.line", {"sketch": "Gore", "from": "e11", "to": "e32"}],
["sketch.line", {"sketch": "Gore", "from": "e33", "to": "e13"}],
["sketch.curve", {"sketch": "Gore", "x": "X0 + ((t) / 2 * sqrt(1 + ((t) / (2 * f))^2) + f * ln(((t) / (2 * f)) + sqrt(1 + ((t) / (2 * f))^2))) - S0", "y": "Y0 + pi * t / N + tabW", "t": ["r0 + 7 * seg + tc", "r0 + 8 * seg - tc"]}],
["sketch.line", {"sketch": "Gore", "from": "e14", "to": "e37"}],
["sketch.line", {"sketch": "Gore", "from": "e38", "to": "e16"}],
["sketch.curve", {"sketch": "Gore", "x": "X0 + ((t) / 2 * sqrt(1 + ((t) / (2 * f))^2) + f * ln(((t) / (2 * f)) + sqrt(1 + ((t) / (2 * f))^2))) - S0", "y": "Y0 + pi * t / N + tabW", "t": ["r0 + 9 * seg + tc", "r0 + 10 * seg - tc"]}],
["sketch.line", {"sketch": "Gore", "from": "e17", "to": "e42"}],
["sketch.line", {"sketch": "Gore", "from": "e43", "to": "e19"}],
["sketch.line", {"sketch": "Gore", "from": "e1", "to": "e4"}],
["sketch.line", {"sketch": "Gore", "from": "e2", "to": "e20"}],
["sketch.circle", {"sketch": "Gore", "center": ["X0 + 8 mm", "Y0"], "radius": "2 mm"}],
["feature.extrude", {"sketch": "Gore", "distance": "th", "name": "Petal"}],
["feature.transform", {"source": "Petal", "angle": "180 deg", "pivot": ["X0 + L / 2", "Y0", "0 mm"], "translate": ["0 mm", "nestP", "0 mm"], "keep": true, "name": "Petal2"}],
["feature.pattern", {"source": "Petal", "count": "nA", "step": ["0 mm", "pitch", "0 mm"], "name": "PetalsA"}],
["feature.pattern", {"source": "Petal2", "count": "nB", "step": ["0 mm", "pitch", "0 mm"], "name": "PetalsB"}],
["body.appearance", {"body": "PetalsA", "color": "#B9BEC4", "metallic": 0.8, "roughness": 0.3}],
["body.appearance", {"body": "PetalsB", "color": "#E8DFCC", "roughness": 0.6}],
["feature.cylinder", {"radius": "150 mm", "height": "22 mm", "name": "Turntable"}],
["feature.block", {"size": ["80 mm", "2 * Yu + 80 mm", "40 mm"], "position": ["-40 mm", "-Yu - 40 mm", "20 mm"], "name": "BeamY"}],
["feature.block", {"size": ["2 * footL", "80 mm", "40 mm"], "position": ["-footL", "-40 mm", "20 mm"], "name": "BeamX"}],
["feature.block", {"size": ["30 mm", "30 mm", "zTop + 30 mm - (baseH - 2 mm)"], "position": ["-15 mm", "Yu - 15 mm", "baseH - 2 mm"], "name": "Upright"}],
["feature.pattern", {"source": "Upright", "count": "2", "angle": "180 deg", "axis": [0, 0, 1], "name": "Uprights"}],
["feature.block", {"size": ["30 mm", "2 * Yu + 30 mm", "30 mm"], "position": ["-15 mm", "-Yu - 15 mm", "zTop"], "name": "Crossbar"}],
["feature.boolean", {"op": "union", "target": "Turntable", "tool": "BeamY", "name": "Base1"}],
["feature.boolean", {"op": "union", "target": "Base1", "tool": "BeamX", "name": "Base"}],
["feature.boolean", {"op": "union", "target": "Base", "tool": "Uprights", "name": "Fork"}],
["feature.boolean", {"op": "union", "target": "Fork", "tool": "Crossbar", "name": "Frame"}],
["body.appearance", {"body": "Frame", "color": "#7D858C", "metallic": 0.7, "roughness": 0.4}],
["sketch.create", {"name": "RingSketch", "plane": "xy", "offset": "ringZ"}],
["sketch.circle", {"sketch": "RingSketch", "center": ["0 mm", "0 mm"], "radius": "rOut"}],
["sketch.circle", {"sketch": "RingSketch", "center": ["0 mm", "0 mm"], "radius": "rIn"}],
["feature.extrude", {"sketch": "RingSketch", "distance": "ringT", "name": "Holder"}],
["body.appearance", {"body": "Holder", "color": "#7D858C", "metallic": 0.7, "roughness": 0.4}],
["feature.cylinder", {"radius": "4.5 mm", "height": "zTop - (ringZ + ringT)", "position": ["0 mm", "potD / 2 + 8 mm", "ringZ + ringT"], "name": "Hanger"}],
["feature.pattern", {"source": "Hanger", "count": "2", "angle": "180 deg", "axis": [0, 0, 1], "name": "Hangers"}],
["body.appearance", {"body": "Hangers", "color": "#7D858C", "metallic": 0.7, "roughness": 0.4}],
["feature.cylinder", {"radius": "potD / 2", "height": "potH", "position": ["0 mm", "0 mm", "potZ"], "name": "PotBody"}],
["feature.cylinder", {"radius": "potD / 2 + 2 mm", "height": "6 mm", "position": ["0 mm", "0 mm", "potZ + potH"], "name": "Lid"}],
["feature.boolean", {"op": "union", "target": "PotBody", "tool": "Lid", "name": "Pot"}],
["body.appearance", {"body": "Pot", "color": "#7A5638", "roughness": 0.6}],
["set.define", {"name": "Fixed", "kind": "body", "where": {"any": [{"in": "Frame"}, {"in": "Holder"}, {"in": "Hangers"}, {"in": "Pot"}]}}],
["set.define", {"name": "Cut sheet: petals", "kind": "face", "where": {"any": [{"in": "PetalsA", "normal": {"along": "z"}}, {"in": "PetalsB", "normal": {"along": "z"}}]}}],
["set.define", {"name": "Steel parts", "kind": "face", "where": {"in": "Holder", "normal": {"along": "z"}}}],
["assert.add", {"name": "focus in pot (z low)", "measure": "boxMin", "of": "Pot", "axis": "z", "max": "zF"}],
["assert.add", {"name": "focus in pot (z high)", "measure": "boxMax", "of": "Pot", "axis": "z", "min": "zF"}],
["assert.add", {"name": "focus in pot (x low)", "measure": "boxMin", "of": "Pot", "axis": "x", "max": "0 mm"}],
["assert.add", {"name": "focus in pot (x high)", "measure": "boxMax", "of": "Pot", "axis": "x", "min": "0 mm"}],
["assert.add", {"name": "focus in pot (y low)", "measure": "boxMin", "of": "Pot", "axis": "y", "max": "0 mm"}],
["assert.add", {"name": "focus in pot (y high)", "measure": "boxMax", "of": "Pot", "axis": "y", "min": "0 mm"}],
["assert.add", {"name": "pot level", "measure": "extent", "of": "Pot", "axis": "z", "eq": "potH + 6 mm", "tol": "0.01 mm"}],
["assert.add", {"name": "ring shades at most 10 %", "measure": "extent", "of": "Holder", "axis": "x", "max": "sqrt(0.1) * D"}],
["assert.add", {"name": "petal length is the arc length", "measure": "extent", "of": "PetalsA", "axis": "x", "eq": "(R - r0) / 48 * (1 * sqrt(1 + ((r0 + 0 * (R - r0) / 16) / (2 * f))^2) + 4 * sqrt(1 + ((r0 + 1 * (R - r0) / 16) / (2 * f))^2) + 2 * sqrt(1 + ((r0 + 2 * (R - r0) / 16) / (2 * f))^2) + 4 * sqrt(1 + ((r0 + 3 * (R - r0) / 16) / (2 * f))^2) + 2 * sqrt(1 + ((r0 + 4 * (R - r0) / 16) / (2 * f))^2) + 4 * sqrt(1 + ((r0 + 5 * (R - r0) / 16) / (2 * f))^2) + 2 * sqrt(1 + ((r0 + 6 * (R - r0) / 16) / (2 * f))^2) + 4 * sqrt(1 + ((r0 + 7 * (R - r0) / 16) / (2 * f))^2) + 2 * sqrt(1 + ((r0 + 8 * (R - r0) / 16) / (2 * f))^2) + 4 * sqrt(1 + ((r0 + 9 * (R - r0) / 16) / (2 * f))^2) + 2 * sqrt(1 + ((r0 + 10 * (R - r0) / 16) / (2 * f))^2) + 4 * sqrt(1 + ((r0 + 11 * (R - r0) / 16) / (2 * f))^2) + 2 * sqrt(1 + ((r0 + 12 * (R - r0) / 16) / (2 * f))^2) + 4 * sqrt(1 + ((r0 + 13 * (R - r0) / 16) / (2 * f))^2) + 2 * sqrt(1 + ((r0 + 14 * (R - r0) / 16) / (2 * f))^2) + 4 * sqrt(1 + ((r0 + 15 * (R - r0) / 16) / (2 * f))^2) + 1 * sqrt(1 + ((r0 + 16 * (R - r0) / 16) / (2 * f))^2))", "tol": "0.05 mm"}],
["assert.add", {"name": "petals cover the full circle", "measure": "volume", "of": {"set": "Dish"}, "eq": "pi * th * (R^2 - r0^2)", "tol": "pi * th * (R^2 - r0^2) / 10000"}],
["assert.add", {"name": "dish depth", "measure": "boxMax", "of": {"set": "Dish"}, "axis": "z", "eq": "zF + R * sin(tilt) + (D^2 / (16 * f) + th - f) * cos(tilt)", "tol": "0.05 mm"}],
["assert.add", {"name": "reflector clear of frame and pot", "measure": "overlap", "of": {"set": "Fixed"}, "to": {"set": "Reflector"}, "is": false}],
["assert.add", {"name": "reflector above the base", "measure": "boxMin", "of": {"set": "Reflector"}, "axis": "z", "min": "baseH + clearG / 2"}],
["assert.add", {"name": "nested petals clear", "measure": "clearance", "from": "PetalsA", "to": "PetalsB", "min": "gap / 2"}],
["variable.publish", {"name": "D", "label": "Dish diameter", "group": "Dish", "order": 1, "min": "3.2 * (potD + 30 mm)", "max": "min(1600 mm, 7 * potD)", "step": "10 mm", "unit": "mm", "description": "Diameter of the dish's aperture: at least 3.2 x (pot + 30 mm), so the pot's ring shades at most 10 %; at most 7 x the pot (and 1.6 m), so the petals can stay narrower than the pot"}],
["variable.publish", {"name": "fD", "label": "Focal ratio f/D", "group": "Dish", "order": 2, "min": "0.25", "max": "0.4", "step": "0.01", "description": "Focal length over diameter: 0.25 puts the focus in the rim plane (a deep dish), 0.4 is shallow"}],
["variable.publish", {"name": "N", "label": "Petals", "group": "Dish", "order": 3, "kind": "integer", "min": "max(8, ceil(pi * D / potD))", "max": "28", "description": "Number of flat petals (gores). At least pi x D / pot: a flat petal reflects a line as wide as itself, so no petal may be wider than the pot"}],
