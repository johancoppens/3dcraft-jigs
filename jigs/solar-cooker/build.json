[
["variable.set", {"name": "D", "expr": "1000 mm"}],
["variable.set", {"name": "fD", "expr": "0.3"}],
["variable.set", {"name": "N", "expr": "12"}],
["variable.set", {"name": "th", "expr": "2 mm"}],
["variable.set", {"name": "pot", "expr": "2"}],
["variable.set", {"name": "standH", "expr": "600 mm"}],
["variable.set", {"name": "tabW", "expr": "15 mm"}],
["table.set", {"name": "pots", "columns": ["pot", {"name": "d", "unit": "mm"}, {"name": "h", "unit": "mm"}], "rows": [["Pot 16 cm", 160, 110], ["Pot 20 cm", 200, 130], ["Pot 24 cm", 240, 150], ["Kettle", 170, 200]]}],
["variable.set", {"name": "potD", "expr": "pots[pot].d"}],
["variable.set", {"name": "potH", "expr": "pots[pot].h"}],
["variable.set", {"name": "f", "expr": "fD * D"}],
["variable.set", {"name": "R", "expr": "D / 2"}],
["variable.set", {"name": "r0", "expr": "D / 20"}],
["variable.set", {"name": "depth", "expr": "D^2 / (16 * f)"}],
["variable.set", {"name": "rimAngle", "expr": "2 * atan(1 / (4 * fD))"}],
["variable.set", {"name": "S0", "expr": "((r0) / 2 * sqrt(1 + ((r0) / (2 * f))^2) + f * ln(((r0) / (2 * f)) + sqrt(1 + ((r0) / (2 * f))^2)))"}],
["variable.set", {"name": "SR", "expr": "((R) / 2 * sqrt(1 + ((R) / (2 * f))^2) + f * ln(((R) / (2 * f)) + sqrt(1 + ((R) / (2 * f))^2)))"}],
["variable.set", {"name": "L", "expr": "SR - S0"}],
["variable.set", {"name": "halfR", "expr": "pi * R / N"}],
["variable.set", {"name": "half0", "expr": "pi * r0 / N"}],
["variable.set", {"name": "gap", "expr": "10 mm"}],
["variable.set", {"name": "M", "expr": "2 * pi / N * (R - L / (2 * sqrt(1 + (R / (2 * f))^2)))"}],
["variable.set", {"name": "nestP", "expr": "M + 2 * tabW + gap"}],
["variable.set", {"name": "pitch", "expr": "2 * M + 2 * tabW + 2 * gap"}],
["variable.set", {"name": "nA", "expr": "ceil(N / 2)"}],
["variable.set", {"name": "seg", "expr": "(R - r0) / 11"}],
["variable.set", {"name": "tc", "expr": "min(tabW / 2, seg / 4)"}],
["variable.set", {"name": "nB", "expr": "floor(N / 2)"}],
["variable.set", {"name": "ringT", "expr": "4 mm"}],
["variable.set", {"name": "rIn", "expr": "potD / 2 - 20 mm"}],
["variable.set", {"name": "rOut", "expr": "potD / 2 + 15 mm"}],
["variable.set", {"name": "potZ", "expr": "f - potH / 4"}],
["variable.set", {"name": "ringZ", "expr": "potZ - ringT"}],
["variable.set", {"name": "rod", "expr": "5 mm"}],
["variable.set", {"name": "legX0", "expr": "R + rod + 0.5 mm"}],
["variable.set", {"name": "legZ0", "expr": "depth + th + 2 * rod + 2 mm"}],
["variable.set", {"name": "legX1", "expr": "rOut - 8 mm"}],
["variable.set", {"name": "legZ1", "expr": "ringZ - rod + 1.5 mm"}],
["variable.set", {"name": "legLen", "expr": "sqrt((legX1 - legX0)^2 + (legZ1 - legZ0)^2)"}],
["variable.set", {"name": "postR", "expr": "20 mm"}],
["variable.set", {"name": "hubR", "expr": "r0 + 25 mm"}],
["variable.set", {"name": "hubT", "expr": "10 mm"}],
["variable.set", {"name": "hubZ", "expr": "r0^2 / (4 * f)"}],
["variable.set", {"name": "footL", "expr": "0.45 * D"}],
["variable.set", {"name": "footR", "expr": "15 mm"}],
["variable.set", {"name": "X0", "expr": "max(R, footL) + 100 mm"}],
["variable.set", {"name": "Y0", "expr": "-(N - 1) * pitch / 4"}],
["variable.set", {"name": "G", "expr": "-standH"}],
["sketch.create", {"name": "Meridian", "plane": "zx"}],
["sketch.curve", {"sketch": "Meridian", "x": "t^2 / (4 * f)", "y": "t", "t": ["r0", "R"]}],
["sketch.curve", {"sketch": "Meridian", "x": "t^2 / (4 * f) + th", "y": "t", "t": ["r0", "R"]}],
["sketch.line", {"sketch": "Meridian", "from": "e1", "to": "e4"}],
["sketch.line", {"sketch": "Meridian", "from": "e2", "to": "e5"}],
["feature.revolve", {"sketch": "Meridian", "axis": "x", "angle": "360 deg / N", "name": "DishPetal"}],
["feature.transform", {"source": "DishPetal", "angle": "360 deg / N", "axis": [0, 0, 1], "keep": true, "name": "DishPetal2"}],
["feature.transform", {"source": "DishPetal", "angle": "(N - 1) * 360 deg / N", "axis": [0, 0, 1], "keep": true, "name": "DishLast", "when": "mod(N, 2) == 1"}],
["feature.pattern", {"source": "DishPetal", "count": "nB", "angle": "720 deg / N", "axis": [0, 0, 1], "name": "DishA"}],
["feature.pattern", {"source": "DishPetal2", "count": "nB", "angle": "720 deg / N", "axis": [0, 0, 1], "name": "DishB"}],
["body.appearance", {"body": "DishA", "color": "#B9BEC4", "metallic": 0.8, "roughness": 0.3}],
["body.appearance", {"body": "DishB", "color": "#E8DFCC", "roughness": 0.5}],
["body.appearance", {"body": "DishLast", "color": "#B9BEC4", "metallic": 0.8, "roughness": 0.3}],
["set.define", {"name": "Dish", "kind": "body", "where": {"any": [{"in": "DishA"}, {"in": "DishB"}, {"in": "DishLast"}]}}],
["sketch.create", {"name": "Gore", "plane": "xy", "offset": "G"}],
["sketch.curve", {"sketch": "Gore", "x": "X0 + ((t) / 2 * sqrt(1 + ((t) / (2 * f))^2) + f * ln(((t) / (2 * f)) + sqrt(1 + ((t) / (2 * f))^2))) - S0", "y": "Y0 - pi * t / N", "t": ["r0", "R"]}],
["sketch.curve", {"sketch": "Gore", "x": "X0 + ((t) / 2 * sqrt(1 + ((t) / (2 * f))^2) + f * ln(((t) / (2 * f)) + sqrt(1 + ((t) / (2 * f))^2))) - S0", "y": "Y0 + pi * t / N", "t": ["r0 + 0 * seg", "r0 + 1 * seg"]}],
["sketch.curve", {"sketch": "Gore", "x": "X0 + ((t) / 2 * sqrt(1 + ((t) / (2 * f))^2) + f * ln(((t) / (2 * f)) + sqrt(1 + ((t) / (2 * f))^2))) - S0", "y": "Y0 + pi * t / N", "t": ["r0 + 2 * seg", "r0 + 3 * seg"]}],
["sketch.curve", {"sketch": "Gore", "x": "X0 + ((t) / 2 * sqrt(1 + ((t) / (2 * f))^2) + f * ln(((t) / (2 * f)) + sqrt(1 + ((t) / (2 * f))^2))) - S0", "y": "Y0 + pi * t / N", "t": ["r0 + 4 * seg", "r0 + 5 * seg"]}],
["sketch.curve", {"sketch": "Gore", "x": "X0 + ((t) / 2 * sqrt(1 + ((t) / (2 * f))^2) + f * ln(((t) / (2 * f)) + sqrt(1 + ((t) / (2 * f))^2))) - S0", "y": "Y0 + pi * t / N", "t": ["r0 + 6 * seg", "r0 + 7 * seg"]}],
["sketch.curve", {"sketch": "Gore", "x": "X0 + ((t) / 2 * sqrt(1 + ((t) / (2 * f))^2) + f * ln(((t) / (2 * f)) + sqrt(1 + ((t) / (2 * f))^2))) - S0", "y": "Y0 + pi * t / N", "t": ["r0 + 8 * seg", "r0 + 9 * seg"]}],
["sketch.curve", {"sketch": "Gore", "x": "X0 + ((t) / 2 * sqrt(1 + ((t) / (2 * f))^2) + f * ln(((t) / (2 * f)) + sqrt(1 + ((t) / (2 * f))^2))) - S0", "y": "Y0 + pi * t / N", "t": ["r0 + 10 * seg", "r0 + 11 * seg"]}],
["sketch.curve", {"sketch": "Gore", "x": "X0 + ((t) / 2 * sqrt(1 + ((t) / (2 * f))^2) + f * ln(((t) / (2 * f)) + sqrt(1 + ((t) / (2 * f))^2))) - S0", "y": "Y0 + pi * t / N + tabW", "t": ["r0 + 1 * seg + tc", "r0 + 2 * seg - tc"]}],
["sketch.line", {"sketch": "Gore", "from": "e5", "to": "e22"}],
["sketch.line", {"sketch": "Gore", "from": "e23", "to": "e7"}],
["sketch.curve", {"sketch": "Gore", "x": "X0 + ((t) / 2 * sqrt(1 + ((t) / (2 * f))^2) + f * ln(((t) / (2 * f)) + sqrt(1 + ((t) / (2 * f))^2))) - S0", "y": "Y0 + pi * t / N + tabW", "t": ["r0 + 3 * seg + tc", "r0 + 4 * seg - tc"]}],
["sketch.line", {"sketch": "Gore", "from": "e8", "to": "e27"}],
["sketch.line", {"sketch": "Gore", "from": "e28", "to": "e10"}],
["sketch.curve", {"sketch": "Gore", "x": "X0 + ((t) / 2 * sqrt(1 + ((t) / (2 * f))^2) + f * ln(((t) / (2 * f)) + sqrt(1 + ((t) / (2 * f))^2))) - S0", "y": "Y0 + pi * t / N + tabW", "t": ["r0 + 5 * seg + tc", "r0 + 6 * seg - tc"]}],
["sketch.line", {"sketch": "Gore", "from": "e11", "to": "e32"}],
["sketch.line", {"sketch": "Gore", "from": "e33", "to": "e13"}],
["sketch.curve", {"sketch": "Gore", "x": "X0 + ((t) / 2 * sqrt(1 + ((t) / (2 * f))^2) + f * ln(((t) / (2 * f)) + sqrt(1 + ((t) / (2 * f))^2))) - S0", "y": "Y0 + pi * t / N + tabW", "t": ["r0 + 7 * seg + tc", "r0 + 8 * seg - tc"]}],
["sketch.line", {"sketch": "Gore", "from": "e14", "to": "e37"}],
["sketch.line", {"sketch": "Gore", "from": "e38", "to": "e16"}],
["sketch.curve", {"sketch": "Gore", "x": "X0 + ((t) / 2 * sqrt(1 + ((t) / (2 * f))^2) + f * ln(((t) / (2 * f)) + sqrt(1 + ((t) / (2 * f))^2))) - S0", "y": "Y0 + pi * t / N + tabW", "t": ["r0 + 9 * seg + tc", "r0 + 10 * seg - tc"]}],
["sketch.line", {"sketch": "Gore", "from": "e17", "to": "e42"}],
["sketch.line", {"sketch": "Gore", "from": "e43", "to": "e19"}],
["sketch.line", {"sketch": "Gore", "from": "e1", "to": "e4"}],
["sketch.line", {"sketch": "Gore", "from": "e2", "to": "e20"}],
["feature.extrude", {"sketch": "Gore", "distance": "th", "name": "Petal"}],
["feature.transform", {"source": "Petal", "angle": "180 deg", "pivot": ["X0 + L / 2", "Y0", "G"], "translate": ["0 mm", "nestP", "0 mm"], "keep": true, "name": "Petal2"}],
["feature.pattern", {"source": "Petal", "count": "nA", "step": ["0 mm", "pitch", "0 mm"], "name": "PetalsA"}],
["feature.pattern", {"source": "Petal2", "count": "nB", "step": ["0 mm", "pitch", "0 mm"], "name": "PetalsB"}],
["body.appearance", {"body": "PetalsA", "color": "#B9BEC4", "metallic": 0.8, "roughness": 0.3}],
["body.appearance", {"body": "PetalsB", "color": "#E8DFCC", "roughness": 0.5}],
["sketch.create", {"name": "RingSketch", "plane": "xy", "offset": "ringZ"}],
["sketch.circle", {"sketch": "RingSketch", "center": ["0 mm", "0 mm"], "radius": "rOut"}],
["sketch.circle", {"sketch": "RingSketch", "center": ["0 mm", "0 mm"], "radius": "rIn"}],
["feature.extrude", {"sketch": "RingSketch", "distance": "ringT", "name": "Ring"}],
["feature.cylinder", {"radius": "rod", "height": "legLen", "position": ["legX0", "0 mm", "legZ0"], "axis": ["legX1 - legX0", "0 mm", "legZ1 - legZ0"], "name": "Leg"}],
["feature.pattern", {"source": "Leg", "count": "3", "angle": "120 deg", "axis": [0, 0, 1], "name": "Legs"}],
["feature.boolean", {"op": "union", "target": "Ring", "tool": "Legs", "name": "Holder"}],
["body.appearance", {"body": "Holder", "color": "#7D858C", "metallic": 0.7, "roughness": 0.4}],
["feature.cylinder", {"radius": "potD / 2", "height": "potH", "position": ["0 mm", "0 mm", "potZ"], "name": "PotBody"}],
["feature.cylinder", {"radius": "potD / 2 + 3 mm", "height": "6 mm", "position": ["0 mm", "0 mm", "potZ + potH"], "name": "Lid"}],
["feature.boolean", {"op": "union", "target": "PotBody", "tool": "Lid", "name": "Pot"}],
["body.appearance", {"body": "Pot", "color": "#7A5638", "roughness": 0.7}],
["feature.cylinder", {"radius": "postR", "height": "standH + hubZ - hubT", "position": ["0 mm", "0 mm", "G"], "name": "Post"}],
["feature.cylinder", {"radius": "hubR", "height": "hubT", "position": ["0 mm", "0 mm", "hubZ - hubT"], "name": "Hub"}],
["feature.cylinder", {"radius": "footR", "height": "footL", "position": ["0 mm", "0 mm", "G + footR"], "axis": [1, 0, 0], "name": "Foot"}],
["feature.pattern", {"source": "Foot", "count": "3", "angle": "120 deg", "axis": [0, 0, 1], "point": [0, 0, 0], "name": "Feet"}],
["feature.boolean", {"op": "union", "target": "Post", "tool": "Hub", "name": "PostHub"}],
["feature.boolean", {"op": "union", "target": "PostHub", "tool": "Feet", "name": "Stand"}],
["body.appearance", {"body": "Stand", "color": "#7D858C", "metallic": 0.7, "roughness": 0.4}],
["set.define", {"name": "Cut sheet", "kind": "face", "where": {"any": [{"in": "PetalsA", "normal": {"along": "z"}}, {"in": "PetalsB", "normal": {"along": "z"}}, {"in": "Holder", "normal": {"along": "z"}}]}}],
["assert.add", {"name": "focus in pot (z low)", "measure": "boxMin", "of": "Pot", "axis": "z", "max": "f"}],
["assert.add", {"name": "focus in pot (z high)", "measure": "boxMax", "of": "Pot", "axis": "z", "min": "f"}],
["assert.add", {"name": "focus in pot (x)", "measure": "boxMin", "of": "Pot", "axis": "x", "max": "0 mm"}],
["assert.add", {"name": "focus in pot (y)", "measure": "boxMax", "of": "Pot", "axis": "y", "min": "0 mm"}],
["assert.add", {"name": "pot shades at most 10 %", "measure": "extent", "of": "Pot", "axis": "x", "max": "sqrt(0.1) * D"}],
["assert.add", {"name": "petal length is the arc length", "measure": "extent", "of": "PetalsA", "axis": "x", "eq": "(R - r0) / 48 * (1 * sqrt(1 + ((r0 + 0 * (R - r0) / 16) / (2 * f))^2) + 4 * sqrt(1 + ((r0 + 1 * (R - r0) / 16) / (2 * f))^2) + 2 * sqrt(1 + ((r0 + 2 * (R - r0) / 16) / (2 * f))^2) + 4 * sqrt(1 + ((r0 + 3 * (R - r0) / 16) / (2 * f))^2) + 2 * sqrt(1 + ((r0 + 4 * (R - r0) / 16) / (2 * f))^2) + 4 * sqrt(1 + ((r0 + 5 * (R - r0) / 16) / (2 * f))^2) + 2 * sqrt(1 + ((r0 + 6 * (R - r0) / 16) / (2 * f))^2) + 4 * sqrt(1 + ((r0 + 7 * (R - r0) / 16) / (2 * f))^2) + 2 * sqrt(1 + ((r0 + 8 * (R - r0) / 16) / (2 * f))^2) + 4 * sqrt(1 + ((r0 + 9 * (R - r0) / 16) / (2 * f))^2) + 2 * sqrt(1 + ((r0 + 10 * (R - r0) / 16) / (2 * f))^2) + 4 * sqrt(1 + ((r0 + 11 * (R - r0) / 16) / (2 * f))^2) + 2 * sqrt(1 + ((r0 + 12 * (R - r0) / 16) / (2 * f))^2) + 4 * sqrt(1 + ((r0 + 13 * (R - r0) / 16) / (2 * f))^2) + 2 * sqrt(1 + ((r0 + 14 * (R - r0) / 16) / (2 * f))^2) + 4 * sqrt(1 + ((r0 + 15 * (R - r0) / 16) / (2 * f))^2) + 1 * sqrt(1 + ((r0 + 16 * (R - r0) / 16) / (2 * f))^2))", "tol": "0.05 mm"}],
["assert.add", {"name": "petals cover the full circle", "measure": "volume", "of": {"set": "Dish"}, "eq": "pi * th * (R^2 - r0^2)", "tol": "pi * th * (R^2 - r0^2) / 10000"}],
["assert.add", {"name": "dish depth", "measure": "boxMax", "of": "DishA", "axis": "z", "eq": "D^2 / (16 * f) + th", "tol": "0.05 mm"}],
["assert.add", {"name": "holder clear of dish", "measure": "overlap", "of": ["Holder"], "to": {"set": "Dish"}, "is": false}],
["assert.add", {"name": "nested petals clear", "measure": "clearance", "from": "PetalsA", "to": "PetalsB", "min": "gap / 2"}],
["assert.add", {"name": "pot clear of dish", "measure": "overlap", "of": ["Pot"], "to": {"set": "Dish"}, "is": false}],
["variable.publish", {"name": "D", "label": "Dish diameter", "group": "Dish", "order": 1, "min": "3.2 * (potD + 30 mm)", "max": "1600 mm", "step": "10 mm", "unit": "mm", "description": "Diameter of the dish's aperture; at least 3.2 x (pot + 30 mm) so the pot and its ring shade at most 10 %"}],
["variable.publish", {"name": "fD", "label": "Focal ratio f/D", "group": "Dish", "order": 2, "min": "0.25", "max": "0.4", "step": "0.01", "description": "Focal length over diameter: 0.25 puts the focus in the rim plane (a deep dish), 0.4 is shallow"}],
["variable.publish", {"name": "N", "label": "Petals", "group": "Dish", "order": 3, "kind": "integer", "min": "8", "max": "24", "description": "Number of flat petals (gores) the dish is made of"}],
["variable.publish", {"name": "th", "label": "Sheet thickness", "group": "Dish", "order": 4, "min": "0.5 mm", "max": "4 mm", "step": "0.1 mm", "unit": "mm", "description": "Cardboard, aluminium or polypropylene sheet under the foil"}],
["variable.publish", {"name": "tabW", "label": "Glue tab", "group": "Dish", "order": 5, "min": "8 mm", "max": "25 mm", "step": "1 mm", "unit": "mm", "description": "Width of the tab along one edge of each petal, for glue or rivets"}],
["variable.publish", {"name": "pot", "label": "Pot", "group": "Pot and stand", "order": 1, "kind": "choice", "choicesFrom": "pots", "description": "The pot or kettle the holder takes"}],
["variable.publish", {"name": "standH", "label": "Stand height", "group": "Pot and stand", "order": 2, "min": "300 mm", "max": "1000 mm", "step": "10 mm", "unit": "mm", "description": "Height of the dish's centre above the ground"}],
["document.info", {"title": "Parabolic solar cooker", "description": "A parabolic solar cooker whose dish is made of flat petals (gores) cut from cardboard, aluminium or polypropylene sheet and covered with reflective foil. Each petal's outline is drawn from the paraboloid's arc length, so N petals bend into the exact dish z = r^2 / 4f. A ring on three legs holds the pot at the focus. Set the diameter, the focal ratio, the number of petals, the sheet, the tab and the pot. Export the cut sheet with File > Export... (DXF or SVG, set Cut sheet). Never look into the focus: wear sunglasses, it gets very hot.", "author": "3DCraft Jigs", "licence": "CC-BY-4.0", "url": "https://github.com/johancoppens/3dcraft-jigs/tree/main/jigs/solar-cooker", "tags": ["solar cooker", "parabolic dish", "gores", "cut sheet", "laser cutting", "formula"]}],
["jig.export", {"path": "dist/solar-cooker.3dcraftjig"}]
]
