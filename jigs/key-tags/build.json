[
["variable.set", {"name": "shape", "expr": "1"}],
["variable.set", {"name": "width", "expr": "50 mm"}],
["variable.set", {"name": "height", "expr": "20 mm"}],
["variable.set", {"name": "cornerR", "expr": "5 mm"}],
["variable.set", {"name": "holeD", "expr": "5 mm"}],
["variable.set", {"name": "margin", "expr": "3 mm"}],
["variable.set", {"name": "thick", "expr": "3 mm"}],
["variable.set", {"name": "cols", "expr": "2"}],
["variable.set", {"name": "rows", "expr": "3"}],
["variable.set", {"name": "gap", "expr": "5 mm"}],
["variable.set", {"name": "kerf", "expr": "0.15 mm"}],
["variable.set", {"name": "hk", "expr": "kerf / 2"}],
["variable.set", {"name": "rr", "expr": "clamp(cornerR, 0.5 mm, min(width, height) / 2 - 0.5 mm)"}],
["variable.set", {"name": "holeX", "expr": "choose(shape, -width / 2 + margin + holeD / 2, -width / 2 + margin + holeD / 2, -width / 2 + (holeD / 2 + margin) / sin(60 deg))"}],
["variable.set", {"name": "tagH", "expr": "choose(shape, height, width, width * sin(60 deg))"}],
["variable.set", {"name": "pitchX", "expr": "width + kerf + gap"}],
["variable.set", {"name": "pitchY", "expr": "tagH + kerf + gap"}],
["variable.set", {"name": "hexR", "expr": "width / 2 + hk / cos(30 deg)"}],
["feature.block", {"name": "Rect", "size": ["width + kerf", "height + kerf", "thick"], "position": ["-width / 2 - hk", "-height / 2 - hk", "0 mm"]}],
["feature.fillet", {"name": "RectRound", "edges": [["F1:face(2)", "F1:face(4)"], ["F1:face(2)", "F1:face(5)"], ["F1:face(3)", "F1:face(4)"], ["F1:face(3)", "F1:face(5)"]], "radius": "rr + hk"}],
["feature.cylinder", {"name": "RectHole", "radius": "holeD / 2 - hk", "height": "thick + 2 mm", "position": ["holeX", "0 mm", "-1 mm"]}],
["feature.boolean", {"op": "subtract", "target": "RectRound", "tool": "RectHole", "name": "RectTag"}],
["feature.pattern", {"name": "RectRow", "source": "RectTag", "count": "cols", "step": ["pitchX", "0 mm", "0 mm"]}],
["feature.pattern", {"name": "RectSheet", "source": "RectRow", "count": "rows", "step": ["0 mm", "-pitchY", "0 mm"]}],
["feature.cylinder", {"name": "Disc", "radius": "width / 2 + hk", "height": "thick"}],
["feature.cylinder", {"name": "DiscHole", "radius": "holeD / 2 - hk", "height": "thick + 2 mm", "position": ["holeX", "0 mm", "-1 mm"]}],
["feature.boolean", {"op": "subtract", "target": "Disc", "tool": "DiscHole", "name": "DiscTag"}],
["feature.pattern", {"name": "DiscRow", "source": "DiscTag", "count": "cols", "step": ["pitchX", "0 mm", "0 mm"]}],
["feature.pattern", {"name": "DiscSheet", "source": "DiscRow", "count": "rows", "step": ["0 mm", "-pitchY", "0 mm"]}],
["sketch.create", {"name": "Hexagon"}],
["sketch.polyline", {"sketch": "Hexagon", "closed": true, "points": [["hexR", "0 mm"], ["hexR * cos(60 deg)", "hexR * sin(60 deg)"], ["-hexR * cos(60 deg)", "hexR * sin(60 deg)"], ["-hexR", "0 mm"], ["-hexR * cos(60 deg)", "-hexR * sin(60 deg)"], ["hexR * cos(60 deg)", "-hexR * sin(60 deg)"]]}],
["feature.extrude", {"sketch": "Hexagon", "distance": "thick", "name": "Hex"}],
["feature.cylinder", {"name": "HexHole", "radius": "holeD / 2 - hk", "height": "thick + 2 mm", "position": ["holeX", "0 mm", "-1 mm"]}],
["feature.boolean", {"op": "subtract", "target": "Hex", "tool": "HexHole", "name": "HexTag"}],
["feature.pattern", {"name": "HexRow", "source": "HexTag", "count": "cols", "step": ["pitchX", "0 mm", "0 mm"]}],
["feature.pattern", {"name": "HexSheet", "source": "HexRow", "count": "rows", "step": ["0 mm", "-pitchY", "0 mm"]}],
["feature.when", {"feature": "Rect", "expr": "shape == 1"}],
["feature.when", {"feature": "RectRound", "expr": "shape == 1"}],
["feature.when", {"feature": "RectHole", "expr": "shape == 1"}],
["feature.when", {"feature": "RectTag", "expr": "shape == 1"}],
["feature.when", {"feature": "RectRow", "expr": "shape == 1"}],
["feature.when", {"feature": "RectSheet", "expr": "shape == 1"}],
["feature.when", {"feature": "Disc", "expr": "shape == 2"}],
["feature.when", {"feature": "DiscHole", "expr": "shape == 2"}],
["feature.when", {"feature": "DiscTag", "expr": "shape == 2"}],
["feature.when", {"feature": "DiscRow", "expr": "shape == 2"}],
["feature.when", {"feature": "DiscSheet", "expr": "shape == 2"}],
["feature.when", {"feature": "Hexagon", "expr": "shape == 3"}],
["feature.when", {"feature": "Hex", "expr": "shape == 3"}],
["feature.when", {"feature": "HexHole", "expr": "shape == 3"}],
["feature.when", {"feature": "HexTag", "expr": "shape == 3"}],
["feature.when", {"feature": "HexRow", "expr": "shape == 3"}],
["feature.when", {"feature": "HexSheet", "expr": "shape == 3"}],
["body.appearance", {"body": "RectSheet", "color": "#d9b27c", "roughness": 0.8}],
["body.appearance", {"body": "DiscSheet", "color": "#d9b27c", "roughness": 0.8}],
["body.appearance", {"body": "HexSheet", "color": "#d9b27c", "roughness": 0.8}],
["assert.add", {"name": "one sheet", "measure": "count", "of": {"kind": "body"}, "eq": "1"}],
["set.define", {"name": "Cut sheet", "kind": "face", "where": {"normal": {"along": "z"}}}],
["variable.publish", {"name": "shape", "label": "Shape", "description": "Rounded rectangle (width x height), circle (diameter = width) or hexagon (width corner to corner)", "group": "Tag", "order": 1, "kind": "choice", "choices": ["Rounded rectangle", "Circle", "Hexagon"]}],
["variable.publish", {"name": "width", "label": "Width", "description": "Width of a tag (the diameter of a circle, corner to corner of a hexagon)", "group": "Tag", "order": 2, "min": "20 mm", "max": "80 mm", "step": "1 mm", "unit": "mm"}],
["variable.publish", {"name": "height", "label": "Height", "description": "Height of a rounded rectangle (not used by the circle and the hexagon)", "group": "Tag", "order": 3, "min": "12 mm", "max": "50 mm", "step": "1 mm", "unit": "mm"}],
["variable.publish", {"name": "cornerR", "label": "Corner radius", "description": "Radius of the rectangle's corners; kept below half the smaller side", "group": "Tag", "order": 4, "min": "0.5 mm", "max": "25 mm", "step": "0.5 mm", "unit": "mm"}],
["variable.publish", {"name": "holeD", "label": "Ring hole", "description": "Diameter of the hole for the key ring", "group": "Hole", "order": 1, "min": "2 mm", "max": "min(8 mm, 12 mm - 2 * margin)", "step": "0.5 mm", "unit": "mm"}],
["variable.publish", {"name": "margin", "label": "Hole margin", "description": "Material between the hole and the edge of the tag", "group": "Hole", "order": 2, "min": "1.5 mm", "max": "5 mm", "step": "0.5 mm", "unit": "mm"}],
["variable.publish", {"name": "cols", "label": "Columns", "description": "Tags side by side on the sheet", "group": "Sheet", "order": 1, "kind": "integer", "min": "1", "max": "6"}],
["variable.publish", {"name": "rows", "label": "Rows", "description": "Rows of tags on the sheet", "group": "Sheet", "order": 2, "kind": "integer", "min": "1", "max": "6"}],
["variable.publish", {"name": "thick", "label": "Sheet thickness", "description": "Thickness of the plywood or acrylic (only for the 3D view and a 3D-printed tag)", "group": "Material", "order": 1, "min": "1.5 mm", "max": "6 mm", "step": "0.5 mm", "unit": "mm"}],
["variable.publish", {"name": "kerf", "label": "Kerf", "description": "Width of the laser cut; outlines grow and holes shrink by half of it", "group": "Laser", "order": 1, "min": "0 mm", "max": "0.3 mm", "step": "0.01 mm", "unit": "mm"}],
["document.info", {"title": "Key tags", "description": "A sheet of key tags or name-tag blanks to laser-cut (or 3D-print): a rounded rectangle, a circle or a hexagon with a key-ring hole, as many columns and rows as you like (one per student), kerf included. To cut it: File > Export..., choose SVG or DXF and the face set \"Cut sheet\" (file.export {\"path\": \"tags.svg\", \"set\": \"Cut sheet\"}); engrave names on the tags in your laser software.", "author": "3DCraft Jigs", "licence": "CC-BY-4.0", "url": "https://github.com/johancoppens/3dcraft-jigs/tree/main/jigs/key-tags", "tags": ["laser", "key tag", "name tag", "keychain", "sheet", "classroom"]}],
["jig.export", {"path": "dist/key-tags.3dcraftjig"}]
]
