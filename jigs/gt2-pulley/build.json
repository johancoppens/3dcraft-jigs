["variable.publish", {"name": "teeth", "label": "Teeth", "description": "Number of teeth (GT2, 2 mm pitch)", "group": "Pulley", "order": 1, "kind": "integer", "min": "12", "max": "60"}],
["variable.publish", {"name": "beltWidth", "label": "Belt width", "description": "Width of the belt; the toothed part is 1 mm longer", "group": "Pulley", "order": 2, "min": "4 mm", "max": "20 mm", "step": "0.5 mm", "unit": "mm"}],
["variable.publish", {"name": "beltFit", "label": "Belt fit", "description": "Extra width of each groove (printer tuning); 0.2 mm fits most printers", "group": "Pulley", "order": 3, "min": "0 mm", "max": "0.3 mm", "step": "0.01 mm", "unit": "mm"}],
["variable.publish", {"name": "bore", "label": "Bore", "description": "Diameter of the shaft hole", "group": "Bore and hub", "order": 1, "min": "2 mm", "max": "OD - 4 mm", "step": "0.1 mm", "unit": "mm"}],
["variable.publish", {"name": "hub", "label": "Hub", "description": "A hub below the pulley, which holds the set screws", "group": "Bore and hub", "order": 4, "kind": "boolean"}],
["variable.publish", {"name": "hubD", "label": "Hub diameter", "description": "Outside diameter of the hub; at least the bore + 4 mm, and room for the keyway and the nut slots", "group": "Bore and hub", "order": 5, "min": "max(8 mm, max(bore + 4 mm + if(boreType == 3, 2 * keyT, 0 mm), if(setScrew && nut, 2 * (nutIn + nutT + 1 mm), 0 mm)))", "max": "60 mm", "step": "0.5 mm", "unit": "mm"}],
