[
["variable.set", {"name": "teeth", "expr": "20"}],
["variable.set", {"name": "beltWidth", "expr": "6 mm"}],
["variable.set", {"name": "bore", "expr": "5 mm"}],
["variable.set", {"name": "beltFit", "expr": "0.2 mm"}],
["variable.set", {"name": "flanges", "expr": "1"}],
["variable.set", {"name": "hub", "expr": "1"}],
["variable.set", {"name": "hubD", "expr": "16 mm"}],
["variable.set", {"name": "hubL", "expr": "7 mm"}],
["variable.set", {"name": "pitch", "expr": "2 mm"}],
["variable.set", {"name": "pld", "expr": "0.254 mm"}],
["variable.set", {"name": "PD", "expr": "teeth * pitch / pi"}],
["variable.set", {"name": "OD", "expr": "PD - 2 * pld"}],
["variable.set", {"name": "R", "expr": "OD / 2"}],
["variable.set", {"name": "s", "expr": "(1.494 mm + beltFit) / (1.494 mm)"}],
["variable.set", {"name": "hw", "expr": "0.747183 mm * s"}],
["variable.set", {"name": "d", "expr": "sqrt(R * R - hw * hw)"}],
["variable.set", {"name": "th", "expr": "360 deg / teeth"}],
["variable.set", {"name": "L", "expr": "beltWidth + 1 mm"}],
["variable.set", {"name": "rootR", "expr": "d - 0.76447 mm"}],
["variable.set", {"name": "flangeT", "expr": "1 mm"}],
["variable.set", {"name": "lip", "expr": "2 mm"}],
["variable.set", {"name": "fR", "expr": "if(flanges, R + lip, rootR - 0.5 mm)"}],
["variable.set", {"name": "f1z", "expr": "if(flanges, -flangeT, L / 4 - flangeT / 2)"}],
["variable.set", {"name": "f2z", "expr": "if(flanges, L, 3 * L / 4 - flangeT / 2)"}],
["variable.set", {"name": "hubR", "expr": "if(hub, hubD / 2, rootR - 0.7 mm)"}],
["variable.set", {"name": "hubH", "expr": "if(hub, hubL, L / 4)"}],
["variable.set", {"name": "hubZ", "expr": "if(hub, if(flanges, -flangeT, 0 mm) - hubL, 3 * L / 8)"}],
["variable.set", {"name": "boreZ", "expr": "-flangeT - hubL - 1 mm"}],
["variable.set", {"name": "boreH", "expr": "L + 2 * flangeT + hubL + 2 mm"}],
["sketch.create", {"name": "ToothSketch", "plane": "xy"}],
["sketch.polyline", {"sketch": "ToothSketch", "points": [["0.747183 mm * s", "d - 0 mm"], ["0.647876 mm * s", "d - 0.037218 mm"], ["0.598311 mm * s", "d - 0.130528 mm"], ["0.578556 mm * s", "d - 0.238423 mm"], ["0.547158 mm * s", "d - 0.343077 mm"], ["0.504649 mm * s", "d - 0.443762 mm"], ["0.451556 mm * s", "d - 0.53975 mm"], ["0.358229 mm * s", "d - 0.636924 mm"], ["0.2484 mm * s", "d - 0.707276 mm"], ["0.127259 mm * s", "d - 0.750044 mm"], ["0 mm * s", "d - 0.76447 mm"], ["(-0.127259 mm) * s", "d - 0.750044 mm"], ["(-0.2484 mm) * s", "d - 0.707276 mm"], ["(-0.358229 mm) * s", "d - 0.636924 mm"], ["(-0.451556 mm) * s", "d - 0.53975 mm"], ["(-0.504797 mm) * s", "d - 0.443762 mm"], ["(-0.547291 mm) * s", "d - 0.343077 mm"], ["(-0.578605 mm) * s", "d - 0.238423 mm"], ["(-0.598311 mm) * s", "d - 0.130528 mm"], ["(-0.648009 mm) * s", "d - 0.037218 mm"], ["(-0.747183 mm) * s", "d - 0 mm"]]}],
["sketch.arc", {"sketch": "ToothSketch", "center": ["0 mm", "0 mm"], "start": "e21", "end": ["hw * cos(th) - d * sin(th)", "hw * sin(th) + d * cos(th)"]}],
["sketch.pattern", {"sketch": "ToothSketch", "entities": ["e22", "e23", "e24", "e25", "e26", "e27", "e28", "e29", "e30", "e31", "e32", "e33", "e34", "e35", "e36", "e37", "e38", "e39", "e40", "e41", "e44"], "chain": ["e1", "e43"], "angle": "th", "center": "e42", "count": "teeth"}],
["feature.extrude", {"sketch": "ToothSketch", "distance": "L", "name": "Toothed"}],
["feature.cylinder", {"name": "Flange1", "radius": "fR", "height": "flangeT", "position": ["0 mm", "0 mm", "f1z"]}],
["feature.cylinder", {"name": "Flange2", "radius": "fR", "height": "flangeT", "position": ["0 mm", "0 mm", "f2z"]}],
["feature.cylinder", {"name": "Hub", "radius": "hubR", "height": "hubH", "position": ["0 mm", "0 mm", "hubZ"]}],
["feature.boolean", {"op": "union", "target": "Toothed", "tool": "Flange1", "name": "U1"}],
["feature.boolean", {"op": "union", "target": "U1", "tool": "Flange2", "name": "U2"}],
["feature.boolean", {"op": "union", "target": "U2", "tool": "Hub", "name": "U3"}],
["feature.cylinder", {"name": "BoreTool", "radius": "bore / 2", "height": "boreH", "position": ["0 mm", "0 mm", "boreZ"]}],
["feature.boolean", {"op": "subtract", "target": "U3", "tool": "BoreTool", "name": "Pulley"}],
["body.appearance", {"body": "Pulley", "color": "#c9ccd1", "metallic": 0.6, "roughness": 0.4}],
["variable.publish", {"name": "teeth", "label": "Teeth", "description": "Number of teeth (GT2, 2 mm pitch)", "group": "Pulley", "order": 1, "kind": "integer", "min": "12", "max": "60"}],
["variable.publish", {"name": "beltWidth", "label": "Belt width", "description": "Width of the belt; the toothed part is 1 mm longer", "group": "Pulley", "order": 2, "min": "4 mm", "max": "20 mm", "step": "0.5 mm", "unit": "mm"}],
["variable.publish", {"name": "beltFit", "label": "Belt fit", "description": "Extra width of each groove (printer tuning); 0.2 mm fits most printers", "group": "Pulley", "order": 3, "min": "0 mm", "max": "0.3 mm", "step": "0.01 mm", "unit": "mm"}],
["variable.publish", {"name": "bore", "label": "Bore", "description": "Diameter of the shaft hole", "group": "Bore and hub", "order": 1, "min": "2 mm", "max": "OD - 4 mm", "step": "0.1 mm", "unit": "mm"}],
["variable.publish", {"name": "hub", "label": "Hub", "description": "A hub below the pulley (for a set screw you drill)", "group": "Bore and hub", "order": 2, "kind": "boolean"}],
["variable.publish", {"name": "hubD", "label": "Hub diameter", "description": "Outside diameter of the hub", "group": "Bore and hub", "order": 3, "min": "max(8 mm, bore + 4 mm)", "max": "60 mm", "step": "0.5 mm", "unit": "mm"}],
["variable.publish", {"name": "hubL", "label": "Hub length", "description": "Length of the hub", "group": "Bore and hub", "order": 4, "min": "3 mm", "max": "20 mm", "step": "0.5 mm", "unit": "mm"}],
["variable.publish", {"name": "flanges", "label": "Flanges", "description": "A 1 mm flange on each side, 2 mm above the teeth, that keeps the belt on", "group": "Flanges", "order": 1, "kind": "boolean"}],
["document.info", {"title": "GT2 pulley (2 mm pitch)", "description": "A timing pulley for GT2 belts with 2 mm pitch: set the teeth, the belt width and the bore, with or without flanges and a hub. Pitch diameter = teeth x 2 mm / pi; the outside diameter is 0.508 mm less. Belt fit widens the grooves for 3D printing. Export it with File > Export... (STL or 3MF to print, STEP for CAD). Tooth outline from droftarts' Parametric Pulley (thingiverse.com/thing:16627), CC BY-SA 4.0; this Jig is shared under the same licence.", "author": "3DCraft Jigs (tooth outline: droftarts, thing:16627)", "licence": "CC-BY-SA-4.0", "url": "https://github.com/johancoppens/3dcraft-jigs/tree/main/jigs/gt2-pulley", "tags": ["pulley", "GT2", "timing belt", "3D printing"]}],
["jig.export", {"path": "dist/gt2-pulley.3dcraftjig"}]
]
