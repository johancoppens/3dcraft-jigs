["sketch.pattern", {"sketch": "ToothSketch", "entities": ["e22", "e23", "e24", "e25", "e26", "e27", "e28", "e29", "e30", "e31", "e32", "e33", "e34", "e35", "e36", "e37", "e38", "e39", "e40", "e41", "e44"], "chain": ["e1", "e43"], "angle": "th", "center": "e42", "count": "teeth"}],
