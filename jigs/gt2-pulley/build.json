["variable.publish", {"name": "nut", "label": "Captive nut", "group": "Set screw", "order": 4, "kind": "boolean", "description": "A slot for a hex nut behind each screw, open at the end of the hub: push the nut in, then drive the screw through it"}],
["document.info", {"title": "GT2 pulley (2 mm pitch)", "description": "A timing pulley for GT2 belts with 2 mm pitch: set the teeth, the belt width and the bore (round, D-shaft or keyway), with or without flanges and a hub with one or two set screws (M2.5, M3 or M4, optionally in captive nuts). Pitch diameter = teeth x 2 mm / pi; the outside diameter is 0.508 mm less. Belt fit widens the grooves for 3D printing. Export it with File > Export... (STL or 3MF to print, STEP for CAD). Tooth outline from droftarts' Parametric Pulley (thingiverse.com/thing:16627), CC BY-SA 4.0; this Jig is shared under the same licence.", "author": "3DCraft Jigs (tooth outline: droftarts, thing:16627)", "licence": "CC-BY-SA-4.0", "url": "https://github.com/johancoppens/3dcraft-jigs/tree/main/jigs/gt2-pulley", "tags": ["pulley", "GT2", "timing belt", "3D printing"]}],
["jig.export", {"path": "dist/gt2-pulley.3dcraftjig"}]
]
