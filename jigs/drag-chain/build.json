[
["variable.set", {"name": "innerW", "expr": "15 mm"}],
["variable.set", {"name": "innerH", "expr": "10 mm"}],
["variable.set", {"name": "pitch", "expr": "22 mm"}],
["variable.set", {"name": "length", "expr": "500 mm"}],
["variable.set", {"name": "radius", "expr": "45 mm"}],
["variable.set", {"name": "layout", "expr": "1"}],
["variable.set", {"name": "ts", "expr": "clamp(0.12 * innerH + 1 mm, 1.6 mm, 3 mm)"}],
["variable.set", {"name": "tb", "expr": "ts"}],
["variable.set", {"name": "g", "expr": "0.3 mm"}],
["variable.set", {"name": "cl", "expr": "0.15 mm"}],
["variable.set", {"name": "h", "expr": "innerH + 2 * tb"}],
["variable.set", {"name": "W", "expr": "innerW + 2 * (2 * ts + g)"}],
["variable.set", {"name": "c", "expr": "0.12 * pitch"}],
["variable.set", {"name": "pr", "expr": "0.22 * h"}],
["variable.set", {"name": "pl", "expr": "ts + g - 0.4 mm"}],
["variable.set", {"name": "pc", "expr": "min(0.3 * pr, 0.4 * pl)"}],
["variable.set", {"name": "rf", "expr": "0.45 * tb"}],
["variable.set", {"name": "bent", "expr": "layout == 1"}],
["variable.set", {"name": "nb", "expr": "max(2, round(pi * radius / pitch))"}],
["variable.set", {"name": "th", "expr": "180 deg / nb"}],
["variable.set", {"name": "Rb", "expr": "pitch / (2 * sin(th / 2))"}],
["variable.set", {"name": "nL", "expr": "max(1, round(length / pitch))"}],
["variable.set", {"name": "n1", "expr": "if(bent, ceil((nL - nb) / 2), nL)"}],
["variable.set", {"name": "n2", "expr": "nL - nb - n1"}],
["variable.set", {"name": "x0", "expr": "n1 * pitch"}],
["variable.set", {"name": "dArea", "expr": "(pitch / 2 + c) * h + pi * h * h / 8"}],
["variable.set", {"name": "vSide", "expr": "ts * (dArea - pi * (pr + cl) ^ 2) + ts * dArea + 2 * c * g * h + pi * pr * pr * pl - pi * pc * pc * (pr - pc / 3)"}],
["variable.set", {"name": "vLink", "expr": "2 * vSide + 2 * c * innerW * tb"}],
["variable.set", {"name": "vTop", "expr": "2 * c * innerW * tb - 2 * (1 - pi / 4) * rf * rf * innerW"}],
["sketch.create", {"name": "OuterSketch", "plane": "zx"}],
["sketch.path", {"sketch": "OuterSketch", "start": ["-h / 2", "pitch / 2 - c"], "segments": [{"line": ["-h / 2", "pitch"]}, {"arc": ["h / 2", "pitch"], "center": ["0 mm", "pitch"], "clockwise": true}, {"line": ["h / 2", "pitch / 2 - c"]}, {"line": "start"}]}],
["feature.extrude", {"sketch": "OuterSketch", "distance": "ts", "name": "Outer"}],
["sketch.create", {"name": "InnerSketch", "plane": "zx", "offset": "ts + g"}],
["sketch.path", {"sketch": "InnerSketch", "start": ["-h / 2", "pitch / 2 + c"], "segments": [{"line": ["-h / 2", "0 mm"]}, {"arc": ["h / 2", "0 mm"], "center": ["0 mm", "0 mm"], "clockwise": false}, {"line": ["h / 2", "pitch / 2 + c"]}, {"line": "start"}]}],
["feature.extrude", {"sketch": "InnerSketch", "distance": "ts", "name": "Inner"}],
["feature.block", {"name": "Web", "size": ["(pitch / 2 + c) - (pitch / 2 - c)", "(ts + g) - (ts)", "(h / 2) - (-h / 2)"], "position": ["pitch / 2 - c", "ts", "-h / 2"]}],
["feature.cylinder", {"name": "PinBody", "radius": "pr", "height": "pl", "position": ["0 mm", "ts + g", "0 mm"], "axis": [0, -1, 0]}],
["feature.chamfer", {"name": "Pin", "edges": [["F6:face(0)", "F6:face(2)"]], "distance": "pc"}],
["feature.boolean", {"op": "union", "target": "Outer", "tool": "Web", "name": "W1"}],
["feature.boolean", {"op": "union", "target": "W1", "tool": "Inner", "name": "W2"}],
["feature.boolean", {"op": "union", "target": "W2", "tool": "Pin", "name": "W3"}],
["feature.cylinder", {"name": "Hole", "radius": "pr + cl", "height": "ts + 2 mm", "position": ["pitch", "-1 mm", "0 mm"], "axis": [0, 1, 0]}],
["feature.boolean", {"op": "subtract", "target": "W3", "tool": "Hole", "name": "WallL"}],
["feature.mirror", {"source": "WallL", "normal": [0, 1, 0], "point": ["0 mm", "W / 2", "0 mm"], "keep": true, "name": "WallR"}],
["feature.block", {"name": "BottomBridge", "size": ["(pitch / 2 + c) - (pitch / 2 - c)", "(W - 2 * ts - g) - (2 * ts + g)", "(-h / 2 + tb) - (-h / 2)"], "position": ["pitch / 2 - c", "2 * ts + g", "-h / 2"]}],
["feature.boolean", {"op": "union", "target": "WallL", "tool": "BottomBridge", "name": "L1"}],
["feature.boolean", {"op": "union", "target": "L1", "tool": "WallR", "name": "Link"}],
["feature.block", {"name": "TopBlank", "size": ["(pitch / 2 + c) - (pitch / 2 - c)", "(W - 2 * ts - g) - (2 * ts + g)", "(h / 2) - (h / 2 - tb)"], "position": ["pitch / 2 - c", "2 * ts + g", "h / 2 - tb"]}],
["feature.fillet", {"name": "Top", "edges": [["F17:face(1)", "F17:face(4)"], ["F17:face(1)", "F17:face(5)"]], "radius": "rf"}],
["feature.transform", {"source": "Link", "angle": "th / 2", "axis": [0, -1, 0], "pivot": ["0 mm", "0 mm", "0 mm"], "translate": ["x0", "0 mm", "0 mm"], "keep": true, "name": "LinkBend0"}],
["feature.transform", {"source": "Link", "angle": "180 deg", "axis": [0, -1, 0], "pivot": ["0 mm", "0 mm", "0 mm"], "translate": ["x0", "0 mm", "2 * Rb"], "keep": true, "name": "LinkUp0"}],
["feature.pattern", {"name": "LinksLow", "source": "Link", "count": "n1", "step": ["pitch", "0 mm", "0 mm"]}],
["feature.pattern", {"name": "LinksBend", "source": "LinkBend0", "count": "nb", "angle": "th", "axis": [0, -1, 0], "point": ["x0", "0 mm", "Rb"]}],
["feature.pattern", {"name": "LinksUp", "source": "LinkUp0", "count": "n2", "step": ["-pitch", "0 mm", "0 mm"]}],
["feature.when", {"feature": "LinkBend0", "expr": "bent"}],
["feature.when", {"feature": "LinkUp0", "expr": "bent"}],
["feature.when", {"feature": "LinksBend", "expr": "bent"}],
["feature.when", {"feature": "LinksUp", "expr": "bent"}],
["feature.transform", {"source": "Top", "angle": "th / 2", "axis": [0, -1, 0], "pivot": ["0 mm", "0 mm", "0 mm"], "translate": ["x0", "0 mm", "0 mm"], "keep": true, "name": "TopBend0"}],
["feature.transform", {"source": "Top", "angle": "180 deg", "axis": [0, -1, 0], "pivot": ["0 mm", "0 mm", "0 mm"], "translate": ["x0", "0 mm", "2 * Rb"], "keep": true, "name": "TopUp0"}],
["feature.pattern", {"name": "BridgesLow", "source": "Top", "count": "n1", "step": ["pitch", "0 mm", "0 mm"]}],
["feature.pattern", {"name": "BridgesBend", "source": "TopBend0", "count": "nb", "angle": "th", "axis": [0, -1, 0], "point": ["x0", "0 mm", "Rb"]}],
["feature.pattern", {"name": "BridgesUp", "source": "TopUp0", "count": "n2", "step": ["-pitch", "0 mm", "0 mm"]}],
["feature.when", {"feature": "TopBend0", "expr": "bent"}],
["feature.when", {"feature": "TopUp0", "expr": "bent"}],
["feature.when", {"feature": "BridgesBend", "expr": "bent"}],
["feature.when", {"feature": "BridgesUp", "expr": "bent"}],
["body.appearance", {"body": "LinksLow", "color": "#2E7D7A", "roughness": 0.55}],
["body.appearance", {"body": "LinksBend", "color": "#2E7D7A", "roughness": 0.55}],
["body.appearance", {"body": "LinksUp", "color": "#2E7D7A", "roughness": 0.55}],
["body.appearance", {"body": "BridgesLow", "color": "#D4A24C", "roughness": 0.5}],
["body.appearance", {"body": "BridgesBend", "color": "#D4A24C", "roughness": 0.5}],
["body.appearance", {"body": "BridgesUp", "color": "#D4A24C", "roughness": 0.5}],
["assert.add", {"name": "links apart", "measure": "volume", "of": {"kind": "body", "where": {"name": "Links*"}}, "eq": "nL * vLink", "tol": "1e-6 * nL * vLink"}],
["assert.add", {"name": "bridges apart", "measure": "volume", "of": {"kind": "body", "where": {"name": "Bridges*"}}, "eq": "nL * vTop", "tol": "1e-6 * nL * vTop"}],
["assert.add", {"name": "chain clear of itself", "measure": "interference", "of": {"kind": "body"}}],
["variable.publish", {"name": "innerW", "label": "Inner width", "description": "Width of the cable space inside a link", "group": "Link", "order": 1, "min": "6 mm", "max": "60 mm", "step": "0.5 mm", "unit": "mm"}],
["variable.publish", {"name": "innerH", "label": "Inner height", "description": "Height of the cable space inside a link", "group": "Link", "order": 2, "min": "5 mm", "max": "40 mm", "step": "0.5 mm", "unit": "mm"}],
["variable.publish", {"name": "pitch", "label": "Link pitch", "description": "Distance from hinge to hinge; at least 1.4 times the link's outer height, so the links can turn", "group": "Link", "order": 3, "min": "1.4 * h", "max": "3 * h", "step": "0.5 mm", "unit": "mm"}],
["variable.publish", {"name": "length", "label": "Chain length", "description": "Length along the chain; the number of links is rounded from it", "group": "Chain", "order": 1, "min": "(nb + 2) * pitch", "max": "1200 mm", "step": "1 mm", "unit": "mm"}],
["variable.publish", {"name": "radius", "label": "Bend radius", "description": "Radius of the bend, at the hinges; the links in the bend are rounded to fill a half turn", "group": "Chain", "order": 2, "min": "pitch", "max": "min(8 * pitch, (1200 mm - 2.5 * pitch) / pi)", "step": "1 mm", "unit": "mm"}],
["variable.publish", {"name": "layout", "label": "Layout", "description": "As it runs on a machine (lower run, bend, upper run) or laid out straight", "group": "Chain", "order": 3, "kind": "choice", "choices": ["bent (U)", "straight"]}],
["document.info", {"title": "Cable drag chain", "description": "A cable drag chain (energy chain) for a 3D printer or CNC machine, to print: links with snap-in hinge pins and clip-on top bridges, so cables can be laid in. Set the cable space (inner width and height), the link pitch, the chain length and the bend radius; the chain is shown as it runs, bent round its radius, or straight. Export it with File > Export... (STL or 3MF; the links and the bridges are separate bodies).", "author": "Johan Coppens", "licence": "CC-BY-4.0", "url": "https://github.com/johancoppens/3dcraft-jigs/tree/main/jigs/drag-chain", "tags": ["drag chain", "cable chain", "3D printer", "CNC", "3D printing"]}],
["jig.export", {"path": "dist/drag-chain.3dcraftjig"}]
]
