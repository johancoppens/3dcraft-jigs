["variable.set", {"name": "Ymid", "expr": "W0 * pow((4 * (0.5) * (1 - (0.5))), p0) * (1 + sp0 * (1 - (4 * (0.5) * (1 - (0.5))))) * c0 + W1 * pow((4 * (0.5) * (1 - (0.5))), p1) * (1 + sp1 * (1 - (4 * (0.5) * (1 - (0.5))))) * c1 + W2 * pow((4 * (0.5) * (1 - (0.5))), p2) * (1 + sp2 * (1 - (4 * (0.5) * (1 - (0.5))))) * c2 + W3 * pow((4 * (0.5) * (1 - (0.5))), p3) * (1 + sp3 * (1 - (4 * (0.5) * (1 - (0.5))))) * c3"}],
