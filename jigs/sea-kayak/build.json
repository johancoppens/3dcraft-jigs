["feature.plate", {"faces": ["Hull:copy(0)/Half3:copy(1)/Cyl3:side(e3)"], "thickness": "tHull", "side": "in", "joints": [{"edge": "Hull:between[Hull:copy(0)/Half3:copy(1)/Cyl3:side(e3),Hull:copy(0)/Cyl0:side(e10)]", "kind": "onto", "onto": "EndA"}, {"edge": "Hull:between[Hull:copy(0)/Half3:copy(1)/Cyl3:side(e3),Hull:copy(0)/Cyl0:side(e5)]", "kind": "onto", "onto": "EndB"}, {"edge": "Hull:between[Hull:copy(0)/Half2:copy(1)/Cyl2:side(e3),Hull:copy(0)/Half3:copy(1)/Cyl3:side(e3)]", "kind": "touch", "with": "Hull:copy(0)/Half2:copy(1)/Cyl2:side(e3)", "thickness": "tHull"}, {"edge": "Hull:between[Hull:copy(0)/Half3:copy(1)/Cyl3:side(e3),Hull:copy(0)/HalfD:copy(1)/CylD:side(e3)]", "kind": "over", "with": "Hull:copy(0)/HalfD:copy(1)/CylD:side(e3)", "thickness": "tDeck"}], "name": "Plank3S"}],
["feature.plate", {"faces": ["Hull:copy(0)/HalfD:copy(1)/CylD:side(e3)"], "thickness": "tDeck", "side": "in", "joints": [{"edge": "Hull:between[Hull:copy(0)/HalfD:copy(1)/CylD:side(e3),Hull:copy(0)/Cyl0:side(e10)]", "kind": "onto", "onto": "EndA"}, {"edge": "Hull:between[Hull:copy(0)/HalfD:copy(1)/CylD:side(e3),Hull:copy(0)/Cyl0:side(e5)]", "kind": "onto", "onto": "EndB"}, {"edge": "Hull:between[Hull:copy(0)/Half3:copy(1)/Cyl3:side(e3),Hull:copy(0)/HalfD:copy(1)/CylD:side(e3)]", "kind": "under", "with": "Hull:copy(0)/Half3:copy(1)/Cyl3:side(e3)", "thickness": "tHull"}, {"edge": "Hull:between[Hull:copy(0)/HalfD:copy(1)/CylD:side(e3),Hull:copy(1)/Port:copy(0)/HalfD:copy(1)/CylD:side(e3)]", "kind": "touch", "with": "Hull:copy(1)/Port:copy(0)/HalfD:copy(1)/CylD:side(e3)"}], "name": "DeckS"}],
["feature.plate", {"faces": ["Hull:copy(1)/Cyl0:side(e3)"], "thickness": "tHull", "side": "in", "joints": [{"edge": "Hull:between[Hull:copy(1)/Cyl0:side(e3),Hull:copy(0)/Cyl0:side(e10)]", "kind": "onto", "onto": "EndA"}, {"edge": "Hull:between[Hull:copy(1)/Cyl0:side(e3),Hull:copy(0)/Cyl0:side(e5)]", "kind": "onto", "onto": "EndB"}, {"edge": "Hull:between[Hull:copy(0)/Cyl0:side(e3),Hull:copy(1)/Cyl0:side(e3)]", "kind": "touch", "with": "Hull:copy(0)/Cyl0:side(e3)"}, {"edge": "Hull:between[Hull:copy(1)/Cyl0:side(e3),Hull:copy(1)/Port:copy(0)/Half1:copy(1)/Cyl1:side(e3)]", "kind": "touch", "with": "Hull:copy(1)/Port:copy(0)/Half1:copy(1)/Cyl1:side(e3)", "thickness": "tHull"}], "name": "Plank0P"}],
["feature.plate", {"faces": ["Hull:copy(1)/Port:copy(0)/Half1:copy(1)/Cyl1:side(e3)"], "thickness": "tHull", "side": "in", "joints": [{"edge": "Hull:between[Hull:copy(1)/Port:copy(0)/Half1:copy(1)/Cyl1:side(e3),Hull:copy(0)/Cyl0:side(e10)]", "kind": "onto", "onto": "EndA"}, {"edge": "Hull:between[Hull:copy(1)/Port:copy(0)/Half1:copy(1)/Cyl1:side(e3),Hull:copy(0)/Cyl0:side(e5)]", "kind": "onto", "onto": "EndB"}, {"edge": "Hull:between[Hull:copy(1)/Cyl0:side(e3),Hull:copy(1)/Port:copy(0)/Half1:copy(1)/Cyl1:side(e3)]", "kind": "touch", "with": "Hull:copy(1)/Cyl0:side(e3)", "thickness": "tHull"}, {"edge": "Hull:between[Hull:copy(1)/Port:copy(0)/Half1:copy(1)/Cyl1:side(e3),Hull:copy(1)/Port:copy(0)/Half2:copy(1)/Cyl2:side(e3)]", "kind": "touch", "with": "Hull:copy(1)/Port:copy(0)/Half2:copy(1)/Cyl2:side(e3)", "thickness": "tHull"}], "name": "Plank1P"}],
["feature.plate", {"faces": ["Hull:copy(1)/Port:copy(0)/Half2:copy(1)/Cyl2:side(e3)"], "thickness": "tHull", "side": "in", "joints": [{"edge": "Hull:between[Hull:copy(1)/Port:copy(0)/Half2:copy(1)/Cyl2:side(e3),Hull:copy(0)/Cyl0:side(e10)]", "kind": "onto", "onto": "EndA"}, {"edge": "Hull:between[Hull:copy(1)/Port:copy(0)/Half2:copy(1)/Cyl2:side(e3),Hull:copy(0)/Cyl0:side(e5)]", "kind": "onto", "onto": "EndB"}, {"edge": "Hull:between[Hull:copy(1)/Port:copy(0)/Half1:copy(1)/Cyl1:side(e3),Hull:copy(1)/Port:copy(0)/Half2:copy(1)/Cyl2:side(e3)]", "kind": "touch", "with": "Hull:copy(1)/Port:copy(0)/Half1:copy(1)/Cyl1:side(e3)", "thickness": "tHull"}, {"edge": "Hull:between[Hull:copy(1)/Port:copy(0)/Half2:copy(1)/Cyl2:side(e3),Hull:copy(1)/Port:copy(0)/Half3:copy(1)/Cyl3:side(e3)]", "kind": "touch", "with": "Hull:copy(1)/Port:copy(0)/Half3:copy(1)/Cyl3:side(e3)", "thickness": "tHull"}], "name": "Plank2P"}],
["feature.plate", {"faces": ["Hull:copy(1)/Port:copy(0)/Half3:copy(1)/Cyl3:side(e3)"], "thickness": "tHull", "side": "in", "joints": [{"edge": "Hull:between[Hull:copy(1)/Port:copy(0)/Half3:copy(1)/Cyl3:side(e3),Hull:copy(0)/Cyl0:side(e10)]", "kind": "onto", "onto": "EndA"}, {"edge": "Hull:between[Hull:copy(1)/Port:copy(0)/Half3:copy(1)/Cyl3:side(e3),Hull:copy(0)/Cyl0:side(e5)]", "kind": "onto", "onto": "EndB"}, {"edge": "Hull:between[Hull:copy(1)/Port:copy(0)/Half2:copy(1)/Cyl2:side(e3),Hull:copy(1)/Port:copy(0)/Half3:copy(1)/Cyl3:side(e3)]", "kind": "touch", "with": "Hull:copy(1)/Port:copy(0)/Half2:copy(1)/Cyl2:side(e3)", "thickness": "tHull"}, {"edge": "Hull:between[Hull:copy(1)/Port:copy(0)/Half3:copy(1)/Cyl3:side(e3),Hull:copy(1)/Port:copy(0)/HalfD:copy(1)/CylD:side(e3)]", "kind": "over", "with": "Hull:copy(1)/Port:copy(0)/HalfD:copy(1)/CylD:side(e3)", "thickness": "tDeck"}], "name": "Plank3P"}],
["feature.plate", {"faces": ["Hull:copy(1)/Port:copy(0)/HalfD:copy(1)/CylD:side(e3)"], "thickness": "tDeck", "side": "in", "joints": [{"edge": "Hull:between[Hull:copy(1)/Port:copy(0)/HalfD:copy(1)/CylD:side(e3),Hull:copy(0)/Cyl0:side(e10)]", "kind": "onto", "onto": "EndA"}, {"edge": "Hull:between[Hull:copy(1)/Port:copy(0)/HalfD:copy(1)/CylD:side(e3),Hull:copy(0)/Cyl0:side(e5)]", "kind": "onto", "onto": "EndB"}, {"edge": "Hull:between[Hull:copy(1)/Port:copy(0)/Half3:copy(1)/Cyl3:side(e3),Hull:copy(1)/Port:copy(0)/HalfD:copy(1)/CylD:side(e3)]", "kind": "under", "with": "Hull:copy(1)/Port:copy(0)/Half3:copy(1)/Cyl3:side(e3)", "thickness": "tHull"}, {"edge": "Hull:between[Hull:copy(0)/HalfD:copy(1)/CylD:side(e3),Hull:copy(1)/Port:copy(0)/HalfD:copy(1)/CylD:side(e3)]", "kind": "touch", "with": "Hull:copy(0)/HalfD:copy(1)/CylD:side(e3)"}], "name": "DeckP"}],
["feature.unfold", {"faces": ["Plank0S:copy(0)/Hull:copy(0)/Cyl0:side(e3)"], "at": ["-2500 mm", "-450 mm - 0 * 250 mm", "-150 mm"], "angle": "-90 deg", "name": "Flat0"}],
["feature.unfold", {"faces": ["Plank1S:copy(0)/Hull:copy(0)/Half1:copy(1)/Cyl1:side(e3)"], "at": ["-2500 mm", "-450 mm - 1 * 250 mm", "-150 mm"], "angle": "-90 deg", "name": "Flat1"}],
["feature.unfold", {"faces": ["Plank2S:copy(0)/Hull:copy(0)/Half2:copy(1)/Cyl2:side(e3)"], "at": ["-2500 mm", "-450 mm - 2 * 250 mm", "-150 mm"], "angle": "-90 deg", "name": "Flat2"}],
["feature.unfold", {"faces": ["Plank3S:copy(0)/Hull:copy(0)/Half3:copy(1)/Cyl3:side(e3)"], "at": ["-2500 mm", "-450 mm - 3 * 250 mm", "-150 mm"], "angle": "-90 deg", "name": "Flat3"}],
["feature.unfold", {"faces": ["DeckS:copy(0)/Hull:copy(0)/HalfD:copy(1)/CylD:side(e3)"], "at": ["-2500 mm", "-450 mm - 4 * 250 mm", "-150 mm"], "angle": "-90 deg", "name": "Flat4"}],
["assert.add", {"name": "chine 1 (starboard): the panels' inner edges touch", "measure": "distance", "from": "Plank0S", "to": "Plank1S", "eq": "0 mm", "tol": "0.01 mm"}],
["assert.add", {"name": "chine 2 (starboard): the panels' inner edges touch", "measure": "distance", "from": "Plank1S", "to": "Plank2S", "eq": "0 mm", "tol": "0.01 mm"}],
["assert.add", {"name": "chine 3 (starboard): the panels' inner edges touch", "measure": "distance", "from": "Plank2S", "to": "Plank3S", "eq": "0 mm", "tol": "0.01 mm"}],
["assert.add", {"name": "sheer (starboard): the deck rests on the sheer panel", "measure": "distance", "from": "Plank3S", "to": "DeckS", "eq": "0 mm", "tol": "0.01 mm"}],
["assert.add", {"name": "chine 1 (port): the panels' inner edges touch", "measure": "distance", "from": "Plank0P", "to": "Plank1P", "eq": "0 mm", "tol": "0.01 mm"}],
["assert.add", {"name": "chine 2 (port): the panels' inner edges touch", "measure": "distance", "from": "Plank1P", "to": "Plank2P", "eq": "0 mm", "tol": "0.01 mm"}],
["assert.add", {"name": "chine 3 (port): the panels' inner edges touch", "measure": "distance", "from": "Plank2P", "to": "Plank3P", "eq": "0 mm", "tol": "0.01 mm"}],
["assert.add", {"name": "sheer (port): the deck rests on the sheer panel", "measure": "distance", "from": "Plank3P", "to": "DeckP", "eq": "0 mm", "tol": "0.01 mm"}],
["assert.add", {"name": "keel: the bottom panels' inner edges touch", "measure": "distance", "from": "Plank0S", "to": "Plank0P", "eq": "0 mm", "tol": "0.01 mm"}],
["assert.add", {"name": "ridge: the deck panels' inner edges touch", "measure": "distance", "from": "DeckS", "to": "DeckP", "eq": "0 mm", "tol": "0.01 mm"}],
["assert.add", {"name": "the panels: developable (the envelope's faces the plates are made of)", "measure": "developable", "of": {"kind": "face", "where": {"all": [{"in": "Hull"}, {"name": "*side(e3)"}]}}, "is": true}],
["assert.add", {"name": "the panels: Gaussian curvature", "measure": "curvature", "of": {"kind": "face", "where": {"all": [{"in": "Hull"}, {"name": "*side(e3)"}]}}, "max": "1e-9 / (1 mm)^2"}],
["variable.set", {"name": "mPly", "expr": "rhoPly / (1 m)^3 * L * (0.70 * tHull * 2 * (W0 + W1 + W2 + W3) + 0.67 * tDeck * 2 * Ymid / cos(crown))"}],
["variable.set", {"name": "aHull", "expr": "0.70 * L * 2 * (W0 + W1 + W2 + W3) / (1 m)^2"}],
["variable.set", {"name": "aDeck", "expr": "0.67 * L * 2 * Ymid / cos(crown) / (1 m)^2"}],
["variable.set", {"name": "mGlass", "expr": "0.80 * aHull + 0.55 * aDeck"}],
["variable.set", {"name": "mFit", "expr": "4.5"}],
["variable.set", {"name": "mBoat", "expr": "mPly + mGlass + mFit"}],
["variable.set", {"name": "mTotal", "expr": "mPad + payload + mBoat"}],
["variable.set", {"name": "Vdisp", "expr": "mTotal / rho * (1 m)^3"}],
["variable.set", {"name": "kCap", "expr": "0.355 - 0.00017 * (rockB + rockS - 470 mm) / (1 mm)"}],
["variable.set", {"name": "mCap", "expr": "kCap * L * B * (Zmid - 45 mm) * rho / (1 m)^3 - mBoat"}],
["body.material", {"body": "Plank0S", "name": "okoume plywood", "density": "rhoPly"}],
["body.material", {"body": "Plank1S", "name": "okoume plywood", "density": "rhoPly"}],
["body.material", {"body": "Plank2S", "name": "okoume plywood", "density": "rhoPly"}],
["body.material", {"body": "Plank3S", "name": "okoume plywood", "density": "rhoPly"}],
["body.material", {"body": "DeckS", "name": "okoume plywood", "density": "rhoPly"}],
["body.material", {"body": "Plank0P", "name": "okoume plywood", "density": "rhoPly"}],
["body.material", {"body": "Plank1P", "name": "okoume plywood", "density": "rhoPly"}],
["body.material", {"body": "Plank2P", "name": "okoume plywood", "density": "rhoPly"}],
["body.material", {"body": "Plank3P", "name": "okoume plywood", "density": "rhoPly"}],
["body.material", {"body": "DeckP", "name": "okoume plywood", "density": "rhoPly"}],
["assert.add", {"name": "plywood: the kernel's mass of the plates is the formula's (the weight the waterline is found for)", "measure": "mass", "of": ["Plank0S", "Plank1S", "Plank2S", "Plank3S", "DeckS", "Plank0P", "Plank1P", "Plank2P", "Plank3P", "DeckP"], "eq": "mPly", "tol": "mPly / 25"}],
["assert.add", {"name": "freeboard: the waterline for the boat, the paddler and the load lies 45 mm below the sheer amidships", "measure": "levelFor", "of": "Hull", "volume": "Vdisp", "max": "Zmid - 45 mm"}],
["assert.add", {"name": "the hardwood tips are dry: above the highest waterline the freeboard allows", "measure": "boxMin", "of": "Tips", "axis": "z", "min": "Zmid - 45 mm"}],
["variable.set", {"name": "cockL", "expr": "800 mm"}],
["variable.set", {"name": "cockW", "expr": "420 mm"}],
["variable.set", {"name": "rim", "expr": "30 mm"}],
["variable.set", {"name": "Xc", "expr": "((2 * (0.5) / ((1 + s) + sqrt((1 + s)^2 - 4 * s * (0.5)))) - 0.5) * L + 60 mm"}],
["sketch.create", {"plane": "xy", "name": "CockpitRing"}],
["sketch.curve", {"sketch": "CockpitRing", "x": "Xc + (cockL / 2 + rim) * cos(t)", "y": "(cockW / 2 + rim) * sin(t)", "t": ["0", "2 * pi"]}],
["sketch.curve", {"sketch": "CockpitRing", "x": "Xc + cockL / 2 * cos(t)", "y": "cockW / 2 * sin(t)", "t": ["0", "2 * pi"]}],
["feature.extrude", {"sketch": "CockpitRing", "distance": "600 mm", "name": "RingStock"}],
["feature.transform", {"source": "Hull", "translate": ["0 mm", "0 mm", "rim"], "keep": true, "name": "Raised"}],
["feature.boolean", {"op": "subtract", "target": "RingStock", "tool": "Hull", "keepTool": true, "name": "RingOut"}],
["feature.boolean", {"op": "intersect", "target": "RingOut", "tool": "Raised", "name": "Coaming"}],
["assert.add", {"name": "the coaming stands on the deck (starboard panel)", "measure": "distance", "from": "Coaming", "to": "DeckS", "eq": "0 mm", "tol": "0.01 mm"}],
["assert.add", {"name": "the coaming stands on the deck (port panel)", "measure": "distance", "from": "Coaming", "to": "DeckP", "eq": "0 mm", "tol": "0.01 mm"}],
["feature.visible", {"feature": ["Hull", "Panel0S", "Panel1S", "Panel2S", "Panel3S", "Panel0P", "Panel1P", "Panel2P", "Panel3P", "Plane0", "Plane1", "Plane2", "Plane3", "PlaneD", "Trace0", "Trace1", "Trace2", "Trace3", "TraceD", "TraceT", "EndA", "EndB", "CockpitRing"], "visible": false}],
["body.appearance", {"body": "Plank0S", "color": "#D9B98A"}],
["body.appearance", {"body": "Plank1S", "color": "#D9B98A"}],
["body.appearance", {"body": "Plank2S", "color": "#D9B98A"}],
["body.appearance", {"body": "Plank3S", "color": "#D9B98A"}],
["body.appearance", {"body": "DeckS", "color": "#B87350"}],
["body.appearance", {"body": "Plank0P", "color": "#D9B98A"}],
["body.appearance", {"body": "Plank1P", "color": "#D9B98A"}],
["body.appearance", {"body": "Plank2P", "color": "#D9B98A"}],
["body.appearance", {"body": "Plank3P", "color": "#D9B98A"}],
["body.appearance", {"body": "DeckP", "color": "#B87350"}],
["body.appearance", {"body": "Flat0", "color": "#D9B98A"}],
["body.appearance", {"body": "Flat1", "color": "#D9B98A"}],
["body.appearance", {"body": "Flat2", "color": "#D9B98A"}],
["body.appearance", {"body": "Flat3", "color": "#D9B98A"}],
["body.appearance", {"body": "Flat4", "color": "#B87350"}],
["body.appearance", {"body": "Tips", "color": "#7A5638"}],
["body.appearance", {"body": "Coaming", "color": "#7A5638"}],
["set.define", {"name": "Cut sheet: panels", "kind": "face", "where": {"any": [{"in": "Flat0"}, {"in": "Flat1"}, {"in": "Flat2"}, {"in": "Flat3"}, {"in": "Flat4"}]}}],
["variable.publish", {"name": "L", "label": "Length overall", "group": "Hull", "order": 1, "min": "5000 mm", "max": "5800 mm", "step": "10 mm", "unit": "mm", "description": "Tip to tip"}],
["variable.publish", {"name": "B", "label": "Beam", "group": "Hull", "order": 2, "min": "530 mm", "max": "600 mm", "step": "5 mm", "unit": "mm", "description": "Widest beam at the sheer (the hull-deck joint)"}],
["variable.publish", {"name": "D", "label": "Depth at the sheer", "group": "Hull", "order": 3, "min": "170 mm", "max": "min(230 mm, 0.36 * B)", "step": "5 mm", "unit": "mm", "description": "Height of the sheer above the keel at the widest station; the deck's crown comes on top"}],
["variable.publish", {"name": "crown", "label": "Deck crown", "group": "Hull", "order": 4, "min": "12 deg", "max": "26 deg", "step": "1 deg", "unit": "deg", "description": "Angle of the deck panels from the horizontal"}],
["variable.publish", {"name": "rockB", "label": "Bow rise", "group": "Hull", "order": 5, "min": "250 mm", "max": "400 mm", "step": "5 mm", "unit": "mm", "description": "Rocker: how high the keel rises to the bow tip"}],
["variable.publish", {"name": "rockS", "label": "Stern rise", "group": "Hull", "order": 6, "min": "220 mm", "max": "350 mm", "step": "5 mm", "unit": "mm", "description": "How high the keel rises to the stern tip"}],
["variable.publish", {"name": "mPad", "label": "Paddler weight (kg)", "group": "Paddler and load", "order": 1, "min": "45", "max": "min(100, floor(mCap))", "step": "1", "description": "The paddler, in kg: with the boat and the load it sets the waterline; at most what the hull carries with the sheer 45 mm above the water"}],
["variable.publish", {"name": "payload", "label": "Load (kg)", "group": "Paddler and load", "order": 2, "min": "0", "max": "clamp(floor(mCap - mPad), 0, 30)", "step": "1", "description": "Gear in the fore and aft compartments, in kg; at most what the hull carries besides the paddler"}],
["variable.publish", {"name": "water", "label": "Water", "group": "Paddler and load", "order": 3, "kind": "choice", "choicesFrom": "waters", "description": "Sea water (1025 kg/m3) or fresh water (1000 kg/m3)"}],
["document.info", {"title": "Sea kayak (stitch and glue)", "description": "A Greenland-style multichine sea kayak in okoume plywood, built stitch and glue, made entirely by 3DCraft from formulas: the hull is the meeting of developable panels, every panel is a plate whose inner edges touch its neighbours, the deck rests on the sheer panels, every panel is laid flat for cutting, and the waterline for the paddler and the load is found by the kernel. Export the set Cut sheet: panels (DXF or SVG).", "author": "3DCraft Jigs", "licence": "CC-BY-4.0", "url": "https://github.com/johancoppens/3dcraft-jigs/tree/main/jigs/sea-kayak", "tags": ["kayak", "boat", "stitch and glue", "plywood", "developable", "plate", "unfold", "hydrostatics", "cut sheet", "formula"]}],
["assert.list", {}],
["jig.export", {"path": "dist/sea-kayak.3dcraftjig"}]
]
