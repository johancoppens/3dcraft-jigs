[
["table.set", {"name": "shafts", "columns": ["shaft", {"name": "d", "unit": "mm"}, {"name": "across", "unit": "mm"}], "rows": [["6 mm D-shaft", 6, 4.5], ["6 mm round", 6, 6], ["1/4 in D-shaft", 6.35, 4.8], ["1/4 in round", 6.35, 6.35], ["4 mm round", 4, 4], ["3 mm round", 3, 3]]}],
["variable.set", {"name": "shaft", "expr": "1"}],
["variable.set", {"name": "fit", "expr": "0.15 mm"}],
["variable.set", {"name": "diameter", "expr": "24 mm"}],
["variable.set", {"name": "height", "expr": "16 mm"}],
["variable.set", {"name": "depth", "expr": "11 mm"}],
["variable.set", {"name": "ribPitch", "expr": "3.5 mm"}],
["variable.set", {"name": "skirt", "expr": "1"}],
["variable.set", {"name": "pointer", "expr": "1"}],
["variable.set", {"name": "R", "expr": "diameter / 2"}],
["variable.set", {"name": "sd", "expr": "shafts[shaft].d"}],
["variable.set", {"name": "flat", "expr": "shafts[shaft].across - shafts[shaft].d / 2"}],
["variable.set", {"name": "hasFlat", "expr": "flat < sd / 2 - 0.01 mm"}],
["variable.set", {"name": "holeR", "expr": "sd / 2 + fit / 2"}],
["variable.set", {"name": "ch", "expr": "clamp(0.08 * diameter, 0.6 mm, 2 mm)"}],
["variable.set", {"name": "skirtH", "expr": "clamp(0.15 * height, 1.5 mm, 3 mm)"}],
["variable.set", {"name": "skirtW", "expr": "3 mm"}],
["variable.set", {"name": "ribs", "expr": "max(6, round(pi * diameter / ribPitch))"}],
["variable.set", {"name": "gr", "expr": "clamp(0.3 * ribPitch, 0.5 mm, 0.07 * diameter)"}],
["variable.set", {"name": "g0", "expr": "if(skirt, skirtH + 1 mm, -1 mm)"}],
["variable.set", {"name": "g1", "expr": "height - ch - 0.5 mm"}],
["feature.cylinder", {"name": "Body", "radius": "R", "height": "height"}],
["feature.chamfer", {"name": "TopChamfer", "edges": [["F1:face(0)", "F1:face(2)"]], "distance": "ch"}],
["feature.cylinder", {"name": "Skirt", "radius": "R + skirtW", "height": "skirtH"}],
["feature.when", {"feature": "Skirt", "expr": "skirt"}],
["feature.boolean", {"op": "union", "target": "TopChamfer", "tool": "Skirt", "name": "WithSkirt"}],
["feature.cylinder", {"name": "Groove", "radius": "gr", "height": "g1 - g0", "position": ["R * cos(180 deg / ribs)", "R * sin(180 deg / ribs)", "g0"]}],
["feature.pattern", {"name": "Grooves", "source": "Groove", "count": "ribs", "angle": "360 deg / ribs", "axis": [0, 0, 1]}],
["feature.boolean", {"op": "subtract", "target": "WithSkirt", "tool": "Grooves", "name": "Gripped"}],
["feature.block", {"name": "PointerTool", "size": ["R + 1 mm - 0.35 * R", "1.2 mm", "1.8 mm"], "position": ["0.35 * R", "-0.6 mm", "height - 0.8 mm"]}],
["feature.when", {"feature": "PointerTool", "expr": "pointer"}],
["feature.boolean", {"op": "subtract", "target": "Gripped", "tool": "PointerTool", "name": "Marked"}],
["feature.cylinder", {"name": "Hole", "radius": "holeR", "height": "depth + 1 mm", "position": ["0 mm", "0 mm", "-1 mm"]}],
["feature.block", {"name": "Flat", "size": ["holeR + 1 mm - (flat + fit / 2)", "2 * holeR + 2 mm", "depth + 3 mm"], "position": ["flat + fit / 2", "-holeR - 1 mm", "-2 mm"]}],
["feature.when", {"feature": "Flat", "expr": "hasFlat"}],
["feature.boolean", {"op": "subtract", "target": "Hole", "tool": "Flat", "name": "ShaftTool"}],
["feature.boolean", {"op": "subtract", "target": "Marked", "tool": "ShaftTool", "name": "Knob"}],
["body.appearance", {"body": "Knob", "color": "#2f3238", "roughness": 0.6}],
["assert.add", {"name": "one body", "measure": "count", "of": {"kind": "body"}, "eq": "1"}],
["variable.publish", {"name": "shaft", "label": "Shaft", "description": "The shaft of your potentiometer, rotary encoder or switch", "group": "Shaft", "order": 1, "kind": "choice", "choicesFrom": "shafts"}],
["variable.publish", {"name": "fit", "label": "Fit", "description": "Extra diameter of the hole (printer tuning): 0.1 to 0.2 mm is a snug push fit", "group": "Shaft", "order": 2, "min": "0 mm", "max": "0.4 mm", "step": "0.05 mm", "unit": "mm"}],
["variable.publish", {"name": "depth", "label": "Hole depth", "description": "How deep the shaft goes into the knob", "group": "Shaft", "order": 3, "min": "5 mm", "max": "height - 3 mm", "step": "0.5 mm", "unit": "mm"}],
["variable.publish", {"name": "diameter", "label": "Diameter", "description": "Diameter of the knob (without the skirt)", "group": "Knob", "order": 1, "min": "14 mm", "max": "50 mm", "step": "0.5 mm", "unit": "mm"}],
["variable.publish", {"name": "height", "label": "Height", "description": "Height of the knob", "group": "Knob", "order": 2, "min": "10 mm", "max": "30 mm", "step": "0.5 mm", "unit": "mm"}],
["variable.publish", {"name": "ribPitch", "label": "Grip spacing", "description": "Wanted distance between the grip grooves; their number is rounded from the circumference", "group": "Knob", "order": 3, "min": "2.5 mm", "max": "8 mm", "step": "0.1 mm", "unit": "mm"}],
["variable.publish", {"name": "skirt", "label": "Skirt", "description": "A flange at the base, 3 mm wider than the knob", "group": "Details", "order": 1, "kind": "boolean"}],
["variable.publish", {"name": "pointer", "label": "Pointer", "description": "A groove on top that shows the knob's position, in line with the D-flat", "group": "Details", "order": 2, "kind": "boolean"}],
["document.info", {"title": "Potentiometer knob", "description": "A grippy knob for a potentiometer, rotary encoder or switch: choose the shaft (6 mm or 1/4 in, D-shaft or round), tune the fit, set the size, the grip spacing (the number of grooves follows the circumference), a skirt and a pointer. Print it upside down (top on the bed) or standing with the skirt down. Export it with File > Export... (STL or 3MF).", "author": "3DCraft Jigs", "licence": "CC-BY-4.0", "url": "https://github.com/johancoppens/3dcraft-jigs/tree/main/jigs/pot-knob", "tags": ["knob", "potentiometer", "electronics", "3D printing"]}],
["jig.export", {"path": "dist/pot-knob.3dcraftjig"}]
]
