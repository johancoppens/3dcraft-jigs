[
["table.set", {"name": "sheets", "columns": ["sheet", {"name": "short", "unit": "mm"}, {"name": "long", "unit": "mm"}], "rows": [["A4", 210, 297], ["A3", 297, 420], ["Letter", 215.9, 279.4]]}],
["variable.set", {"name": "cellW", "expr": "30 mm"}],
["variable.set", {"name": "cellH", "expr": "28 mm"}],
["variable.set", {"name": "gamma", "expr": "70 deg"}],
["variable.set", {"name": "rows", "expr": "6"}],
["variable.set", {"name": "cols", "expr": "8"}],
["variable.set", {"name": "fold", "expr": "90 deg"}],
["variable.set", {"name": "sheet", "expr": "1"}],
["variable.set", {"name": "landscape", "expr": "1"}],
["variable.set", {"name": "margin", "expr": "10 mm"}],
["variable.set", {"name": "thick", "expr": "0"}],
["variable.set", {"name": "tPanel", "expr": "1.5 mm"}],
["variable.set", {"name": "cPanel", "expr": "1.5 mm"}],
["variable.set", {"name": "panelFront", "expr": "0"}],
["variable.set", {"name": "a", "expr": "cellW"}],
["variable.set", {"name": "b", "expr": "cellH"}],
["variable.set", {"name": "d", "expr": "b / tan(gamma)"}],
["variable.set", {"name": "paperW", "expr": "if(landscape, sheets[sheet].long, sheets[sheet].short)"}],
["variable.set", {"name": "paperH", "expr": "if(landscape, sheets[sheet].short, sheets[sheet].long)"}],
["variable.set", {"name": "usableW", "expr": "paperW - 2 * margin"}],
["variable.set", {"name": "usableH", "expr": "paperH - 2 * margin"}],
["variable.set", {"name": "panelW", "expr": "cols * a + d"}],
["variable.set", {"name": "panelH", "expr": "rows * b"}],
["variable.set", {"name": "flatArea", "expr": "rows * cols * a * b"}],
["variable.set", {"name": "fi", "expr": "2 * floor(cols / 4) + 1"}],
["variable.set", {"name": "fj", "expr": "2 * floor(rows / 4)"}],
["variable.set", {"name": "foldLimit", "expr": "2 * atan(cos(gamma) * cPanel / tPanel)"}],
["variable.set", {"name": "foldMax", "expr": "if(thick, max(0, ceil(foldLimit / (1 deg)) - 1) * (1 deg), 180 deg)"}],
["sketch.create", {"plane": "xy", "name": "Crease pattern"}],
["sketch.line", {"sketch": "Crease pattern", "from": ["0 mm", "0 mm"], "to": ["cols * a", "0 mm"], "construction": false}],
["sketch.line", {"sketch": "Crease pattern", "from": ["mod(rows, 2) * d", "rows * b"], "to": ["cols * a + mod(rows, 2) * d", "rows * b"], "construction": false}],
["sketch.line", {"sketch": "Crease pattern", "from": ["0 mm", "0 mm"], "to": ["0 mm + d", "b"], "construction": false}],
["sketch.pattern", {"sketch": "Crease pattern", "entities": ["e9"], "count": "ceil(rows / 2)", "step": ["0 mm", "2 * b"]}],
["sketch.line", {"sketch": "Crease pattern", "from": ["0 mm + d", "b"], "to": ["0 mm", "2 * b"], "construction": false}],
["sketch.pattern", {"sketch": "Crease pattern", "entities": ["e12"], "count": "floor(rows / 2)", "step": ["0 mm", "2 * b"]}],
["sketch.line", {"sketch": "Crease pattern", "from": ["cols * a", "0 mm"], "to": ["cols * a + d", "b"], "construction": false}],
["sketch.pattern", {"sketch": "Crease pattern", "entities": ["e15"], "count": "ceil(rows / 2)", "step": ["0 mm", "2 * b"]}],
["sketch.line", {"sketch": "Crease pattern", "from": ["cols * a + d", "b"], "to": ["cols * a", "2 * b"], "construction": false}],
["sketch.pattern", {"sketch": "Crease pattern", "entities": ["e18"], "count": "floor(rows / 2)", "step": ["0 mm", "2 * b"]}],
["sketch.line", {"sketch": "Crease pattern", "from": ["a", "0 mm"], "to": ["a + d", "b"], "construction": true}],
["sketch.pattern", {"sketch": "Crease pattern", "entities": ["e21"], "count": "floor(cols / 2)", "step": ["2 * a", "0 mm"], "count2": "ceil(rows / 2)", "step2": ["0 mm", "2 * b"]}],
["sketch.line", {"sketch": "Crease pattern", "from": ["a + d", "b"], "to": ["a", "2 * b"], "construction": true}],
["sketch.pattern", {"sketch": "Crease pattern", "entities": ["e24"], "count": "floor(cols / 2)", "step": ["2 * a", "0 mm"], "count2": "floor(rows / 2)", "step2": ["0 mm", "2 * b"]}],
["sketch.line", {"sketch": "Crease pattern", "from": ["2 * a", "0 mm"], "to": ["2 * a + d", "b"], "construction": true}],
["sketch.pattern", {"sketch": "Crease pattern", "entities": ["e27"], "count": "floor((cols - 1) / 2)", "step": ["2 * a", "0 mm"], "count2": "ceil(rows / 2)", "step2": ["0 mm", "2 * b"]}],
["sketch.line", {"sketch": "Crease pattern", "from": ["2 * a + d", "b"], "to": ["2 * a", "2 * b"], "construction": true}],
["sketch.pattern", {"sketch": "Crease pattern", "entities": ["e30"], "count": "floor((cols - 1) / 2)", "step": ["2 * a", "0 mm"], "count2": "floor(rows / 2)", "step2": ["0 mm", "2 * b"]}],
["sketch.line", {"sketch": "Crease pattern", "from": ["d", "b"], "to": ["a + d", "b"], "construction": true}],
["sketch.pattern", {"sketch": "Crease pattern", "entities": ["e33"], "count": "ceil(cols / 2)", "step": ["2 * a", "0 mm"], "count2": "floor(rows / 2)", "step2": ["0 mm", "2 * b"]}],
["sketch.line", {"sketch": "Crease pattern", "from": ["a + d", "b"], "to": ["2 * a + d", "b"], "construction": true}],
["sketch.pattern", {"sketch": "Crease pattern", "entities": ["e36"], "count": "floor(cols / 2)", "step": ["2 * a", "0 mm"], "count2": "floor(rows / 2)", "step2": ["0 mm", "2 * b"]}],
["sketch.line", {"sketch": "Crease pattern", "from": ["0 mm", "2 * b"], "to": ["a", "2 * b"], "construction": true}],
["sketch.pattern", {"sketch": "Crease pattern", "entities": ["e39"], "count": "ceil(cols / 2)", "step": ["2 * a", "0 mm"], "count2": "floor((rows - 1) / 2)", "step2": ["0 mm", "2 * b"]}],
["sketch.line", {"sketch": "Crease pattern", "from": ["a", "2 * b"], "to": ["2 * a", "2 * b"], "construction": true}],
["sketch.pattern", {"sketch": "Crease pattern", "entities": ["e42"], "count": "floor(cols / 2)", "step": ["2 * a", "0 mm"], "count2": "floor((rows - 1) / 2)", "step2": ["0 mm", "2 * b"]}],
["feature.fill", {"sketch": "Crease pattern", "name": "Flat sheet"}],
["feature.visible", {"feature": "Flat sheet", "visible": false}],
["feature.fold", {"sketch": "Crease pattern", "name": "Miura-ori", "creases": [{"line": "e21[*]", "kind": "mountain"}, {"line": "e24[*]", "kind": "mountain"}, {"line": "e27[*]", "kind": "valley"}, {"line": "e30[*]", "kind": "valley"}, {"line": "e33[*]", "kind": "valley", "angle": "fold"}, {"line": "e36[*]", "kind": "mountain"}, {"line": "e39[*]", "kind": "mountain"}, {"line": "e42[*]", "kind": "valley"}], "fixed": ["(fi + 0.5) * a + 0.5 * d", "(fj + 0.5) * b"], "when": "!thick"}],
["body.appearance", {"body": "Miura-ori", "color": "#E8E2D0"}],
["feature.fold", {"sketch": "Crease pattern", "name": "Thick panels", "creases": [{"line": "e21[*]", "kind": "mountain"}, {"line": "e24[*]", "kind": "mountain"}, {"line": "e27[*]", "kind": "valley"}, {"line": "e30[*]", "kind": "valley"}, {"line": "e33[*]", "kind": "valley", "angle": "fold"}, {"line": "e36[*]", "kind": "mountain"}, {"line": "e39[*]", "kind": "mountain"}, {"line": "e42[*]", "kind": "valley"}], "fixed": ["(fi + 0.5) * a + 0.5 * d", "(fj + 0.5) * b"], "panels": {"thickness": "tPanel", "clearance": "cPanel", "side": "back"}, "when": "thick && !panelFront"}],
["body.appearance", {"body": "Thick panels", "color": "#C9A672", "roughness": 0.8}],
["feature.fold", {"sketch": "Crease pattern", "name": "Thick panels (front)", "creases": [{"line": "e21[*]", "kind": "mountain"}, {"line": "e24[*]", "kind": "mountain"}, {"line": "e27[*]", "kind": "valley"}, {"line": "e30[*]", "kind": "valley"}, {"line": "e33[*]", "kind": "valley", "angle": "fold"}, {"line": "e36[*]", "kind": "mountain"}, {"line": "e39[*]", "kind": "mountain"}, {"line": "e42[*]", "kind": "valley"}], "fixed": ["(fi + 0.5) * a + 0.5 * d", "(fj + 0.5) * b"], "panels": {"thickness": "tPanel", "clearance": "cPanel", "side": "front"}, "when": "thick && panelFront"}],
["body.appearance", {"body": "Thick panels (front)", "color": "#C9A672", "roughness": 0.8}],
["variable.set", {"name": "theta", "expr": "if(fold < 180 deg, atan(tan(fold / 2) / cos(gamma)), 0 deg)"}],
["feature.transform", {"source": "Miura-ori", "name": "Panel", "angle": "theta", "axis": ["cos(gamma)", "sin(gamma)", "0"], "pivot": ["(fi + 0.5) * a + 0.5 * d", "(fj + 0.5) * b", "0 mm"], "when": "!thick && fold < 180 deg"}],
["feature.transform", {"source": "Thick panels", "name": "Level Thick panels", "angle": "theta", "axis": ["cos(gamma)", "sin(gamma)", "0"], "pivot": ["(fi + 0.5) * a + 0.5 * d", "(fj + 0.5) * b", "0 mm"], "when": "thick && !panelFront"}],
["feature.transform", {"source": "Thick panels (front)", "name": "Level Thick panels (front)", "angle": "theta", "axis": ["cos(gamma)", "sin(gamma)", "0"], "pivot": ["(fi + 0.5) * a + 0.5 * d", "(fj + 0.5) * b", "0 mm"], "when": "thick && panelFront"}],
["assert.add", {"name": "every cell is in the folded panel (area rows x cols x a x b)", "measure": "area", "of": {"kind": "body", "where": {"not": {"name": "Flat sheet"}}}, "eq": "flatArea", "when": "!thick"}],
["assert.add", {"name": "the flat sheet is rows x cols parallelograms of a x b", "measure": "area", "of": "Flat sheet", "eq": "flatArea"}],
["assert.add", {"name": "one facet per cell", "measure": "count", "of": {"kind": "face", "where": {"not": {"in": "Flat sheet"}}}, "eq": "rows * cols", "when": "!thick"}],
["assert.add", {"name": "thick panels: one six-sided prism per cell", "measure": "count", "of": {"kind": "face", "where": {"not": {"in": "Flat sheet"}}}, "eq": "6 * rows * cols", "when": "thick"}],
["assert.add", {"name": "thick panels: volume tPanel (rows b - 2 c (rows - 1)) (cols a sin(gamma) - 2 c (cols - 1)) / sin(gamma)", "measure": "volume", "of": {"kind": "body", "where": {"not": {"name": "Flat sheet"}}}, "when": "thick", "eq": "tPanel * (rows * b - 2 * cPanel * (rows - 1)) * (cols * a * sin(gamma) - 2 * cPanel * (cols - 1)) / sin(gamma)"}],
["assert.add", {"name": "folded thickness a sin(gamma) sin(theta), by the closed form", "measure": "extent", "of": {"kind": "body", "where": {"not": {"name": "Flat sheet"}}}, "axis": "z", "eq": "a * sin(gamma) * sin(theta)", "tol": "0.001 mm", "when": "!thick"}],
["assert.add", {"name": "the panel lies level about z = 0", "measure": "boxMax", "of": {"kind": "body", "where": {"not": {"name": "Flat sheet"}}}, "axis": "z", "eq": "a * sin(gamma) * sin(theta) / 2", "tol": "0.001 mm", "when": "!thick"}],
["assert.add", {"name": "thick panels: folded height a sin(gamma) sin(theta) + tPanel cos(theta) - c sin(theta) for even cols", "measure": "extent", "of": {"kind": "body", "where": {"not": {"name": "Flat sheet"}}}, "axis": "z", "tol": "0.001 mm", "when": "thick", "eq": "a * sin(gamma) * sin(theta) + tPanel * cos(theta) - mod(cols + 1, 2) * cPanel * sin(theta)"}],
["assert.add", {"name": "thick panels on the back: the bottom at -a sin(gamma) sin(theta) / 2 - tPanel cos(theta)", "measure": "boxMin", "of": {"kind": "body", "where": {"not": {"name": "Flat sheet"}}}, "axis": "z", "tol": "0.001 mm", "when": "thick && !panelFront", "eq": "-a * sin(gamma) * sin(theta) / 2 - tPanel * cos(theta)"}],
["assert.add", {"name": "thick panels on the front: the bottom at -a sin(gamma) sin(theta) / 2", "measure": "boxMin", "of": {"kind": "body", "where": {"not": {"name": "Flat sheet"}}}, "axis": "z", "tol": "0.001 mm", "when": "thick && panelFront", "eq": "-a * sin(gamma) * sin(theta) / 2"}],
["assert.add", {"name": "thick panels: the fold stays below where the panels meet, 2 atan(cos(gamma) c / t)", "measure": "value", "expr": "foldLimit - fold", "min": "0.001 deg", "when": "thick"}],
["assert.add", {"name": "Kawasaki holds at every interior vertex", "measure": "kawasakiFails", "of": "Miura-ori", "eq": "0"}],
["assert.add", {"name": "Maekawa holds at every interior vertex", "measure": "maekawaFails", "of": "Miura-ori", "eq": "0"}],
["assert.add", {"name": "the pattern folds flat (an order of the layers exists)", "measure": "flatFoldable", "of": "Miura-ori", "is": true}],
["assert.add", {"name": "the pattern fits the sheet's width inside the margin", "measure": "extent", "of": "Flat sheet", "axis": "x", "max": "usableW"}],
["assert.add", {"name": "the pattern fits the sheet's height inside the margin", "measure": "extent", "of": "Flat sheet", "axis": "y", "max": "usableH"}],
["variable.publish", {"name": "rows", "order": 1, "label": "Rows", "description": "Number of rows of parallelograms (straight creases between them)", "group": "Pattern", "kind": "integer", "min": "3", "max": "min(14, floor(usableH / (10 mm)))"}],
["variable.publish", {"name": "cols", "order": 2, "label": "Columns", "description": "Number of columns of parallelograms (zigzag creases between them)", "group": "Pattern", "kind": "integer", "min": "3", "max": "min(16, floor((usableW - b) / (10 mm)))"}],
["variable.publish", {"name": "cellW", "order": 3, "label": "Cell width", "description": "Length of the parallelograms' straight sides (along the straight creases)", "group": "Pattern", "min": "10 mm", "max": "floor((usableW - d) / cols / (0.5 mm)) * (0.5 mm)", "step": "0.5 mm", "unit": "mm"}],
["variable.publish", {"name": "cellH", "order": 4, "label": "Cell height", "description": "Distance between two straight creases (the row pitch)", "group": "Pattern", "min": "10 mm", "max": "floor(usableH / rows / (0.5 mm)) * (0.5 mm)", "step": "0.5 mm", "unit": "mm"}],
["variable.publish", {"name": "gamma", "order": 5, "label": "Parallelogram angle", "description": "Acute angle of the parallelograms; nearer 90 deg the cells stack deeper when folded flat", "group": "Pattern", "min": "45 deg", "max": "if(rows <= 12 && cols <= 12, 80 deg, 65 deg)", "step": "1 deg", "unit": "deg"}],
["variable.publish", {"name": "fold", "order": 6, "label": "Fold", "description": "Fold angle of the straight creases: 0 is flat, 180 deg folded flat (paper; thick panels stop where they meet); all other creases follow", "group": "Fold", "min": "0 deg", "max": "foldMax", "step": "1 deg", "unit": "deg"}],
["variable.publish", {"name": "thick", "order": 7, "label": "Thick panels", "description": "Rigid panels of card or plywood joined by a fabric hinge, instead of paper", "group": "Panels", "kind": "boolean"}],
["variable.publish", {"name": "tPanel", "order": 8, "label": "Panel thickness", "description": "Thickness of the card or plywood panels", "group": "Panels", "min": "0.3 mm", "max": "6 mm", "step": "0.1 mm", "unit": "mm"}],
["variable.publish", {"name": "cPanel", "order": 9, "label": "Hinge clearance", "description": "How far each panel stands back from every crease (the bare fabric between two panels is twice this); more clearance lets thick panels fold further", "group": "Panels", "min": "0.3 mm", "max": "min(10 mm, floor(min(b, a * sin(gamma)) / 4 / (0.1 mm)) * (0.1 mm))", "step": "0.1 mm", "unit": "mm"}],
["variable.publish", {"name": "panelFront", "order": 10, "label": "Panels on the front", "description": "Glue the panels on the printed side (the front) instead of the back", "group": "Panels", "kind": "boolean"}],
["variable.publish", {"name": "sheet", "order": 11, "label": "Paper", "description": "Paper size for the printed crease pattern (table sheets)", "group": "Paper", "kind": "choice", "choicesFrom": "sheets"}],
["variable.publish", {"name": "landscape", "order": 12, "label": "Landscape", "description": "Print across the long side of the paper", "group": "Paper", "kind": "boolean"}],
["variable.publish", {"name": "margin", "order": 13, "label": "Margin", "description": "Free paper round the pattern (most printers need 5 mm or more)", "group": "Paper", "min": "0 mm", "max": "30 mm", "step": "1 mm", "unit": "mm"}],
["document.info", {"title": "Miura-ori fold panel", "description": "A Miura-ori panel that folds in and out with one slider, from flat to folded flat: one crease is driven, 3DCraft solves the rest. Rows, columns, cell size, parallelogram angle, paper (A4, A3, Letter) and margin; paper, or thick card or plywood panels on a fabric hinge that fold as far as they clear each other; the crease pattern exports as SVG or DXF, mountains red dash-dot, valleys blue dashed, to print and score or laser-score.", "author": "3DCraft Jigs", "licence": "CC-BY-4.0", "tags": ["origami", "miura-ori", "fold", "paper", "laser", "thick panels", "plywood"]}],
["jig.export", {"path": "dist/miura-ori.3dcraftjig"}]
]
