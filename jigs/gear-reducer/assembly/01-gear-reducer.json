[
["assembly.new", {"units": "mm", "tolerance": 0.001}],
["file.save", {"path": "dist/gear-reducer.3dcraftasm"}],
["variable.set", {"name": "z1", "expr": "18"}],
["variable.set", {"name": "z2", "expr": "63"}],
["variable.set", {"name": "z3", "expr": "17"}],
["variable.set", {"name": "z4", "expr": "49"}],
["variable.set", {"name": "mn1", "expr": "1.5 mm"}],
["variable.set", {"name": "mn3", "expr": "2.5 mm"}],
["variable.set", {"name": "x3", "expr": "mn1 * (z1 + z2) / 2 + mn3 * (z3 + z4) / 2"}],
["variable.set", {"name": "jn", "expr": "0.12 mm * cos(20 deg)"}],
["variable.set", {"name": "ratio", "expr": "z2 / z1 * z4 / z3"}],
["instance.add", {"source": "dist/gear-reducer.3dcraftjig", "body": "HousingTop", "name": "Housing"}],
["instance.add", {"source": "dist/gear-reducer.3dcraftjig", "body": "Shaft_s1", "name": "Shaft1"}],
["instance.add", {"source": "dist/gear-reducer.3dcraftjig", "body": "Shaft_s2", "name": "Shaft2"}],
["instance.add", {"source": "dist/gear-reducer.3dcraftjig", "body": "Shaft_s3", "name": "Shaft3"}],
["instance.add", {"source": "dist/gear-reducer.3dcraftjig", "body": "Gear_1", "name": "Gear1"}],
["instance.add", {"source": "dist/gear-reducer.3dcraftjig", "body": "Gear_2", "name": "Gear2"}],
["instance.add", {"source": "dist/gear-reducer.3dcraftjig", "body": "Gear_3", "name": "Gear3"}],
["instance.add", {"source": "dist/gear-reducer.3dcraftjig", "body": "Gear_4", "name": "Gear4"}],
["mate.add", {"kind": "fixed", "name": "HousingHeld", "a": "world/z", "b": "Housing/F214:between[F214:copy(0)/F190:copy(1)/F174:face(0),F214:copy(0)/F190:copy(1)/F174:face(1)]", "offset": "-14.5 mm", "flip": true}],
["mate.add", {"kind": "revolute", "name": "Shaft1", "a": "Housing/F214:between[F214:copy(0)/F190:copy(1)/F174:face(0),F214:copy(0)/F190:copy(1)/F174:face(1)]", "b": "Shaft1/F69:copy(0)/F45:between[F45:copy(0)/F39:side(e13),F45:copy(0)/F39:side(e14)]", "offset": "-1.5 mm", "flip": true}],
["mate.add", {"kind": "revolute", "name": "Shaft2", "a": "Housing/F214:between[F214:copy(0)/F192:copy(1)/F176:face(0),F214:copy(0)/F192:copy(1)/F176:face(1)]", "b": "Shaft2/F118:copy(0)/F92:between[F92:copy(0)/F75:side(e11),F92:copy(0)/F75:side(e12)]", "offset": "-1.5 mm", "flip": true}],
["mate.add", {"kind": "revolute", "name": "Shaft3", "a": "Housing/F214:between[F214:copy(0)/F194:copy(1)/F178:face(0),F214:copy(0)/F194:copy(1)/F178:face(1)]", "b": "Shaft3/F156:copy(0)/F132:between[F132:copy(0)/F126:side(e14),F132:copy(0)/F126:side(e15)]", "offset": "-1.5 mm", "flip": true}],
["mate.add", {"kind": "fixed", "name": "Keyed1", "a": "Shaft1/F69:copy(0)/F45:between[F45:copy(0)/F39:side(e18),F45:copy(0)/F39:side(e19)]", "b": "Gear1/F9:copy(0)/F8:between[F8:copy(0)/F4:copy(1)/F3:face(0),F8:copy(0)/F4:copy(1)/F3:face(2)]", "offset": "0 mm", "flip": true}],
["mate.add", {"kind": "fixed", "name": "Keyed2", "a": "Shaft2/F118:copy(0)/F92:between[F92:copy(0)/F75:side(e15),F92:copy(0)/F75:side(e16)]", "b": "Gear2/F18:copy(0)/F17:between[F17:copy(0)/F13:copy(1)/F12:face(0),F17:copy(0)/F13:copy(1)/F12:face(2)]", "offset": "24 mm", "flip": true}],
["mate.add", {"kind": "fixed", "name": "Keyed3", "a": "Shaft2/F118:copy(0)/F92:between[F92:copy(0)/F75:side(e16),F92:copy(0)/F75:side(e17)]", "b": "Gear3/F28:copy(0)/F27:between[F27:copy(0)/F23:copy(1)/F22:face(0),F27:copy(0)/F23:copy(1)/F22:face(2)]", "offset": "0 mm", "flip": true}],
["mate.add", {"kind": "fixed", "name": "Keyed4", "a": "Shaft3/F156:copy(0)/F132:between[F132:copy(0)/F126:side(e20),F132:copy(0)/F126:side(e21)]", "b": "Gear4/F37:copy(0)/F36:between[F36:copy(0)/F32:copy(1)/F31:face(0),F36:copy(0)/F32:copy(1)/F31:face(2)]", "offset": "0 mm", "flip": true}],
["coupling.add", {"kind": "gear", "name": "Stage1", "mates": ["Shaft1", "Shaft2"], "value": "z2 / z1"}],
["coupling.add", {"kind": "gear", "name": "Stage2", "mates": ["Shaft2", "Shaft3"], "value": "z4 / z3"}],
["variable.set", {"name": "t", "expr": "0"}],
["variable.set", {"name": "Shaft1_angle", "expr": "360 deg * t"}],
["variable.measure", {"name": "c3x", "measure": "sectionCentroid", "of": "Shaft3", "plane": "xy", "offset": "43 mm", "axis": "x"}],
["variable.measure", {"name": "c3y", "measure": "sectionCentroid", "of": "Shaft3", "plane": "xy", "offset": "43 mm", "axis": "y"}],
["variable.output", {"name": "outputTurn", "expr": "atan2(-c3y, -(c3x - x3))"}],
["variable.output", {"name": "ratioError", "expr": "abs(atan2(sin(outputTurn - Shaft1_angle / ratio), cos(outputTurn - Shaft1_angle / ratio)))"}],
["assert.add", {"name": "Output turns at z1 z3 / (z2 z4) of the input", "measure": "value", "expr": "ratioError", "max": "0.001 deg"}],
["assert.add", {"name": "The output's keyway is where the angle is measured from (0.3 mm off the axis or more)", "measure": "value", "expr": "hypot(c3x - x3, c3y)", "min": "0.3 mm"}],
["assert.add", {"name": "Stage 1 meshes with the backlash (0.3 to 0.7 jn)", "measure": "clearance", "from": "Gear1", "to": "Gear2", "min": "0.3 * jn", "max": "0.7 * jn"}],
["assert.add", {"name": "Stage 2 meshes with the backlash (0.3 to 0.7 jn)", "measure": "clearance", "from": "Gear3", "to": "Gear4", "min": "0.3 * jn", "max": "0.7 * jn"}],
["assert.add", {"name": "No part overlaps another", "measure": "overlap", "of": ["Housing", "Shaft1", "Shaft2", "Shaft3", "Gear1", "Gear2", "Gear3", "Gear4"], "is": false}],
["document.info", {"title": "Two-stage gear reducer (assembly)", "description": "The gear-reducer Jig's housing, shafts and gears as an assembly at its defaults: revolute shafts, gears keyed to them, the meshes as gear couplings, the input driven by the timeline t; the output's ratio and the backlash checked over the motion.", "author": "3DCraft Jigs", "licence": "CC-BY-4.0", "tags": ["assembly", "gears", "reducer", "motion"]}],
["assembly.pack", {}],
["file.save", {"path": "dist/gear-reducer.3dcraftasm"}]
]
