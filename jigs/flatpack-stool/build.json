["document.info", {"title": "Flat-pack stool", "description": "A stool or side table cut from one sheet of plywood and put together without screws or glue: two legs cross with a half-lap joint and their tabs go through the seat. Set the height, the seat size, the leg style, the sheet thickness, your cutter's kerf and the clearance of the slots. To cut it: File > Export..., DXF or SVG with the face set \"Cut sheet\" (file.export {\"path\": \"stool.svg\", \"set\": \"Cut sheet\"}): the seat and both legs at true size, kerf included.", "author": "Johan Coppens", "licence": "CC-BY-4.0", "url": "https://github.com/johancoppens/3dcraft-jigs/tree/main/jigs/flatpack-stool", "tags": ["furniture", "stool", "flat-pack", "plywood", "CNC", "laser", "sheet"]}],
