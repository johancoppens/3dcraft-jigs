["variable.set", {"name": "gripW", "expr": "2 * holeR"}],
["variable.set", {"name": "gripL", "expr": "min(3 * holeR, spanW / 2)"}],
["variable.set", {"name": "gripY", "expr": "thick + holeR + 6 mm"}],
