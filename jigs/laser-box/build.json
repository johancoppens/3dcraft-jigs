["document.info", {"title": "Laser-cut box", "description": "A finger-jointed box with a loose lid, for laser cutting from sheet. Set the outside size, the sheet thickness, the finger width and your laser's kerf. To cut it: File > Export..., choose DXF or SVG and the face set \"Cut sheet\" (file.export {\"path\": \"box.svg\", \"set\": \"Cut sheet\"}): all six panels on one sheet at true size, kerf included.", "author": "3DCraft Jigs", "licence": "CC-BY-4.0", "url": "https://github.com/johancoppens/3dcraft-jigs/tree/main/jigs/laser-box", "tags": ["laser", "box", "finger joint", "sheet"]}],
