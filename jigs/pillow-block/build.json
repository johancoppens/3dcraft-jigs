["document.info", {"title": "Pillow block bearing housing", "description": "A pillow block (plummer block) for a deep-groove ball bearing chosen from a table of real sizes (608, 6000 to 6005, 6200 to 6205): the housing, its wall, base and mounting bolts (M4 to M8) follow the bearing. Set the centre height, the seat allowance for printing, slotted or round mounting holes and an optional grease nipple boss. The bearing is pressed in from the front against a shoulder that bears on its outer ring only. Export STL or 3MF to print, STEP for CAD (the bearing and nipple are separate bodies: leave them out with the bodies option).", "author": "Johan Coppens", "licence": "CC-BY-4.0", "url": "https://github.com/johancoppens/3dcraft-jigs/tree/main/jigs/pillow-block", "tags": ["bearing", "pillow block", "housing", "shaft", "3D printing", "machining"]}],
["jig.export", {"path": "dist/pillow-block.3dcraftjig"}]
]
