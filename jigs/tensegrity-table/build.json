["document.info", {"title": "Tensegrity table", "description": "The floating table: the top hangs from a hook on the base by one central cable, and three or four outer cables in tension hold it level. Set the height, the top's shape and size, how far the hooks overlap, the sheet, the cables and the load; the document works out the tensions (T0: the pretension to give each outer cable, Tc: the central cable) and limits the load to what the cables and hooks carry. Cut sheet: file.export {\"path\": \"table.svg\", \"set\": \"Cut sheet\"}.", "author": "3DCraft Jigs", "licence": "CC-BY-4.0", "url": "https://github.com/johancoppens/3dcraft-jigs/tree/main/jigs/tensegrity-table", "tags": ["furniture", "table", "tensegrity", "plywood", "laser", "CNC", "3D print", "statics"]}],
