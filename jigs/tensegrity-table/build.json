["variable.set", {"name": "LcMax", "expr": "min(H - 2 * b - 2 * T - 2 * gapV, 2 * (A1max / b + T - b) - H, 2 * (LbMax + T - b) - H, if(printed, 2 * bed - H - 2 * b, 1 m))"}],
