["document.info", {"title": "Welded table frame", "description": "A welded steel table frame of square or rectangular tube or angle iron: set the length, width and height, pick the profile from a table of common sizes, mitred or butt top corners, a ring of cross rails and levelling feet. Every piece is a body of its own; the named sets Legs, Top rails, Cross rails, End plates and Levelling feet are the cut list, and the assertions (assert.list) give each piece's quantity and cut length. Variables topMitre and crossMitre are the mitre angles. Export STEP for CAD or STL to look at it.", "author": "Johan Coppens", "licence": "CC-BY-4.0", "url": "https://github.com/johancoppens/3dcraft-jigs/tree/main/jigs/welded-table-frame", "tags": ["table", "frame", "welding", "steel", "tube", "cut list"]}],
["jig.export", {"path": "dist/welded-table-frame.3dcraftjig"}]
]
