[
["variable.set", {"name": "angle", "expr": "65 deg"}],
["variable.set", {"name": "deviceT", "expr": "11 mm"}],
["variable.set", {"name": "lipH", "expr": "8 mm"}],
["variable.set", {"name": "backL", "expr": "90 mm"}],
["variable.set", {"name": "width", "expr": "70 mm"}],
["variable.set", {"name": "thick", "expr": "5 mm"}],
["variable.set", {"name": "cable", "expr": "1"}],
["variable.set", {"name": "cableW", "expr": "12 mm"}],
["variable.set", {"name": "lipT", "expr": "4 mm"}],
["variable.set", {"name": "xs", "expr": "lipT + deviceT / sin(angle) + 0.5 mm"}],
["variable.set", {"name": "L", "expr": "xs + backL * cos(angle) + thick * sin(angle) + 15 mm"}],
["variable.set", {"name": "rnd", "expr": "min(1.5 mm, thick / 3)"}],
["sketch.create", {"name": "Profile", "plane": "xy"}],
["sketch.polyline", {"sketch": "Profile", "closed": true, "points": [["0 mm", "0 mm"], ["L", "0 mm"], ["L", "thick"], ["xs + thick / sin(angle)", "thick"], ["xs + backL * cos(angle) + thick * sin(angle)", "thick + backL * sin(angle) - thick * cos(angle)"], ["xs + backL * cos(angle)", "thick + backL * sin(angle)"], ["xs", "thick"], ["lipT", "thick"], ["lipT", "thick + lipH"], ["0 mm", "thick + lipH"]]}],
["feature.extrude", {"sketch": "Profile", "distance": "width", "name": "Body"}],
["feature.fillet", {"name": "Rounds", "edges": [["F2:side(e19)", "F2:side(e20)"], ["F2:side(e18)", "F2:side(e19)"], ["F2:side(e14)", "F2:side(e15)"], ["F2:side(e15)", "F2:side(e16)"], ["F2:side(e12)", "F2:side(e13)"]], "radius": "rnd"}],
["feature.fillet", {"name": "Gusset", "edges": [["F2:side(e13)", "F2:side(e14)"]], "radius": "2 * rnd"}],
["feature.block", {"name": "CableSlot", "size": ["xs", "thick + lipH + 2 mm", "cableW"], "position": ["-1 mm", "-1 mm", "width / 2 - cableW / 2"]}],
["feature.when", {"feature": "CableSlot", "expr": "cable"}],
["feature.boolean", {"op": "subtract", "target": "Gusset", "tool": "CableSlot", "name": "Cut"}],
["feature.transform", {"source": "Cut", "angle": "180 deg", "axis": [0, 1, 1], "name": "Stand"}],
["body.appearance", {"body": "Stand", "color": "#5b7bb5", "roughness": 0.6}],
["assert.add", {"name": "one body", "measure": "count", "of": {"kind": "body"}, "eq": "1"}],
["variable.publish", {"name": "angle", "label": "Angle", "description": "How far the device leans back, measured from the table", "group": "Device", "order": 1, "min": "50 deg", "max": "80 deg", "step": "1 deg", "unit": "deg"}],
["variable.publish", {"name": "deviceT", "label": "Device thickness", "description": "Thickness of the phone or tablet with its case", "group": "Device", "order": 2, "min": "6 mm", "max": "16 mm", "step": "0.5 mm", "unit": "mm"}],
["variable.publish", {"name": "backL", "label": "Back rest length", "description": "Length of the slanted back rest; about half the device's height is plenty", "group": "Device", "order": 3, "min": "40 mm", "max": "140 mm", "step": "1 mm", "unit": "mm"}],
["variable.publish", {"name": "lipH", "label": "Lip height", "description": "Height of the front lip above the slot floor", "group": "Device", "order": 4, "min": "4 mm", "max": "16 mm", "step": "0.5 mm", "unit": "mm"}],
["variable.publish", {"name": "width", "label": "Width", "description": "Width of the stand", "group": "Stand", "order": 1, "min": "40 mm", "max": "120 mm", "step": "1 mm", "unit": "mm"}],
["variable.publish", {"name": "thick", "label": "Wall thickness", "description": "Thickness of the base and the back rest", "group": "Stand", "order": 2, "min": "3 mm", "max": "8 mm", "step": "0.5 mm", "unit": "mm"}],
["variable.publish", {"name": "cable", "label": "Cable slot", "description": "A slot through the lip and the slot floor for a charging cable", "group": "Cable", "order": 1, "kind": "boolean"}],
["variable.publish", {"name": "cableW", "label": "Cable slot width", "description": "Width of the cable slot (the plug must pass)", "group": "Cable", "order": 2, "min": "6 mm", "max": "16 mm", "step": "0.5 mm", "unit": "mm"}],
["document.info", {"title": "Phone and tablet stand", "description": "A stand that holds a phone or tablet at the angle you choose: set the device's thickness (with its case), the angle, the length of the back rest and the lip, the width, and whether a charging cable passes through the front. Print it lying on its side (the profile on the bed) for strength, without supports. Export it with File > Export... (STL or 3MF).", "author": "3DCraft Jigs", "licence": "CC-BY-4.0", "url": "https://github.com/johancoppens/3dcraft-jigs/tree/main/jigs/phone-stand", "tags": ["phone", "tablet", "stand", "desk", "3D printing"]}],
["jig.export", {"path": "dist/phone-stand.3dcraftjig"}]
]
