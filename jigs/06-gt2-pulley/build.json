["variable.set", {"name": "rim_mid_height", "expr": "if(hub_up_in_print, pulley_top - face_width / 2, if(printed, face_width / 2 - pulley_bottom, face_width / 2))"}],
["variable.set", {"name": "land_length", "expr": "face_width - if(!flanges && printed && (hub_up_in_print || !hub), edge_chamfer, 0 mm)"}],
["variable.set", {"name": "groove_outline_area", "expr": "0.749989 * (1 mm)^2"}],
["variable.set", {"name": "land_segment_angle", "expr": "2 * asin(groove_half_width / outer_radius)"}],
["variable.set", {"name": "land_segment_area", "expr": "outer_radius * outer_radius * (land_segment_angle / (1 rad) - sin(land_segment_angle)) / 2"}],
["variable.set", {"name": "rim_area", "expr": "pi * outer_radius * outer_radius - teeth * (groove_outline_area * groove_scale + land_segment_area)"}],
["variable.set", {"name": "flat_segment_angle", "expr": "2 * acos(1 - flat_depth / bore_radius)"}],
["variable.set", {"name": "flat_segment_area", "expr": "bore_radius * bore_radius * (flat_segment_angle / (1 rad) - sin(flat_segment_angle)) / 2"}],
["variable.set", {"name": "key_chord_distance", "expr": "sqrt(bore_radius * bore_radius - key_width * key_width / 4)"}],
["variable.set", {"name": "key_added_area", "expr": "key_width * (bore_radius + key_depth - key_chord_distance) - (bore_radius * bore_radius * asin(key_width / (2 * bore_radius)) / (1 rad) - key_width / 2 * key_chord_distance)"}],
["variable.set", {"name": "bore_area", "expr": "pi * bore_radius * bore_radius - if(bore_type == 2, flat_segment_area, 0 mm^2) + if(bore_type == 3, key_added_area, 0 mm^2)"}],
["variable.measure", {"name": "pulley_volume", "measure": "volume", "label": "Volume of all parts", "unit": "cm^3"}],
["variable.output", {"name": "pitch_circle", "expr": "pitch_diameter", "label": "Pitch diameter", "unit": "mm"}],
["variable.output", {"name": "outside_size", "expr": "outside_diameter", "label": "Outside diameter over the teeth", "unit": "mm"}],
["variable.output", {"name": "belt_travel", "expr": "teeth * belt_pitch", "label": "Belt travel per turn", "unit": "mm"}],
["variable.output", {"name": "face_between_flanges", "expr": "face_width", "label": "Toothed face width", "unit": "mm"}],
["variable.output", {"name": "bore_as_cut", "expr": "bore_diameter", "label": "Bore as modelled", "unit": "mm"}],
["variable.output", {"name": "hub_size", "expr": "if(hub, hub_diameter, 0 mm)", "label": "Hub diameter (0: no hub)", "unit": "mm"}],
["variable.output", {"name": "overall_length", "expr": "pulley_length", "label": "Overall length", "unit": "mm"}],
["variable.output", {"name": "mass_estimate", "expr": "pulley_volume * processes[made_by].density * 1 kg / (1 m^3)", "label": "Mass", "unit": "g"}],
["assert.add", {"name": "Parts: one body, or body and two pressed-on flanges", "measure": "count", "of": {"kind": "body"}, "eq": "if(!printed && flanges, 3, 1)"}],
["assert.add", {"name": "Tooth lands on the outside diameter, one per tooth", "measure": "count", "of": {"kind": "face", "where": {"in": "Pulley", "surface": "cylinder", "radius": "outer_radius"}}, "eq": "teeth"}],
["assert.add", {"name": "Rim section equals the closed form", "measure": "sectionArea", "of": "Pulley", "plane": "xy", "offset": "rim_mid_height", "eq": "rim_area - bore_area", "tol": "0.05 + 0.005 * teeth"}],
["assert.add", {"name": "Overall length", "measure": "extent", "of": "Pulley", "axis": "z", "eq": "pulley_length", "tol": "0.001 mm"}],
["assert.add", {"name": "Sits on the print bed", "measure": "boxMin", "of": "Pulley", "axis": "z", "eq": "0 mm", "tol": "0.001 mm", "when": "printed"}],
["assert.add", {"name": "Free flange reaches the Gates minimum height", "measure": "count", "of": {"kind": "face", "where": [{"madeBy": "Free flange"}, {"surface": "cylinder"}, {"radius": {"min": "outer_radius + flange_height_minimum"}}]}, "eq": "1", "when": "flanges"}],
["assert.add", {"name": "Hub flange reaches the Gates minimum height", "measure": "count", "of": {"kind": "face", "where": [{"madeBy": "Hub flange"}, {"surface": "cylinder"}, {"radius": {"min": "outer_radius + flange_height_minimum"}}]}, "eq": "1", "when": "flanges"}],
["assert.add", {"name": "Wall under the tooth roots", "measure": "distance", "from": {"kind": "face", "where": [{"in": "Pulley"}, {"any": [{"madeBy": "Round bore", "surface": "cylinder"}, {"madeBy": "Keyway", "surface": "plane"}]}]}, "to": {"kind": "face", "where": [{"in": "Pulley"}, {"surface": "freeform"}, {"above": {"x": 0}}]}, "min": "min_wall - 0.01 mm"}],
["assert.add", {"name": "Thread engagement in the hub wall", "measure": "distance", "from": {"kind": "face", "where": [{"in": "Pulley"}, {"any": [{"madeBy": "Round bore", "surface": "cylinder"}, {"madeBy": "Keyway", "surface": "plane"}]}]}, "to": {"kind": "face", "where": [{"in": "Pulley"}, {"madeBy": "Hub"}, {"surface": "cylinder"}]}, "min": "thread_wall - 0.01 mm", "when": "has_screw && !printed"}],
["assert.add", {"name": "Flange seat wall over the bore", "measure": "distance", "from": {"kind": "face", "where": [{"in": "Pulley"}, {"any": [{"madeBy": "Round bore", "surface": "cylinder"}, {"madeBy": "Keyway", "surface": "plane"}]}]}, "to": {"kind": "face", "where": [{"in": "Pulley"}, {"any": [{"madeBy": "Free flange seat"}, {"madeBy": "Hub flange seat"}]}, {"surface": "cylinder"}]}, "min": "min_wall - 0.01 mm", "when": "!printed && flanges"}],
["assert.add", {"name": "Hub narrow enough for the hob and the pressed flange", "measure": "count", "of": {"kind": "face", "where": [{"in": "Pulley"}, {"madeBy": "Hub"}, {"surface": "cylinder"}, {"radius": {"max": "root_radius - 0.39 mm"}}]}, "eq": "1", "when": "!printed && hub"}],
["assert.add", {"name": "Pressed flanges do not overlap the pulley", "measure": "overlap", "of": ["Free flange", "Hub flange"], "to": "Pulley", "is": false, "when": "!printed && flanges"}],
["assert.add", {"name": "Wall behind the captive nut", "measure": "distance", "from": {"kind": "face", "where": [{"in": "Pulley"}, {"madeBy": "Nut slot"}]}, "to": {"kind": "face", "where": [{"in": "Pulley"}, {"madeBy": "Hub"}, {"surface": "cylinder"}]}, "min": "0.99 mm", "when": "has_screw && printed"}],
["assert.add", {"name": "Two nut slots clear of each other", "measure": "distance", "from": {"kind": "face", "where": [{"in": "Pulley"}, {"madeBy": "Nut slot"}, {"not": {"madeBy": "Second screw tool"}}]}, "to": {"kind": "face", "where": [{"in": "Pulley"}, {"madeBy": "Nut slot"}, {"madeBy": "Second screw tool"}]}, "min": "1 mm", "when": "has_screw && printed && screw_count == 2"}],
["assert.add", {"name": "Shaft at least as thick as the set screw", "measure": "count", "of": {"kind": "face", "where": [{"in": "Pulley"}, {"madeBy": "Round bore"}, {"surface": "cylinder"}, {"radius": {"min": "screw_diameter / 2 - 0.001 mm"}}]}, "min": "1", "when": "has_screw"}],
["assert.add", {"name": "Tooth lands wide enough", "measure": "area", "of": {"kind": "face", "where": {"in": "Pulley", "surface": "cylinder", "radius": "outer_radius"}}, "min": "teeth * minimum_land * land_length"}],
["assert.add", {"name": "Screw centre at least one diameter from the hub end", "measure": "distance", "from": {"kind": "face", "where": [{"in": "Pulley"}, {"any": [{"madeBy": "Screw hole round"}, {"madeBy": "Screw hole teardrop"}]}]}, "to": {"kind": "face", "where": [{"in": "Pulley"}, {"madeBy": "Hub"}, {"surface": "plane"}]}, "min": "screw_diameter - screw_radius - 0.01 mm", "when": "has_screw"}],
["assert.add", {"name": "First layer chamfered", "measure": "count", "of": {"kind": "face", "where": [{"in": "Pulley"}, {"surface": "cone"}, {"below": {"z": "edge_chamfer + 0.01 mm"}}]}, "min": "2", "when": "printed"}],
["assert.add", {"name": "No overhang steeper than 45 degrees", "measure": "draft", "faces": {"kind": "face", "where": [{"in": "Pulley"}, {"surface": "cone"}]}, "direction": "z", "min": "-45.5 deg", "when": "printed"}],
["variable.publish", {"name": "teeth", "label": "Teeth", "description": "Number of teeth, 2 mm pitch. The fewest depends on the belt (a pitch circle at least as wide as the belt), the shaft, the set screw and, machined, room for the hub.", "group": "Pulley", "order": 1, "kind": "integer", "min": "teeth_minimum", "max": "60", "step": "1"}],
["variable.publish", {"name": "belt_size", "label": "Belt width", "description": "Width of the GT2 belt you bought. The toothed face is made 1 mm wider with both flanges, 3 mm wider otherwise (Gates).", "group": "Pulley", "order": 2, "kind": "choice", "choicesFrom": "belts"}],
["variable.publish", {"name": "made_by", "label": "Made by", "description": "Machined aluminium, black anodised with hobbed bright teeth: export STEP. Or 3D printed PETG: captive nuts, 45 degree flange, print orientation; export 3MF or STL.", "group": "Pulley", "order": 3, "kind": "choice", "choicesFrom": "processes"}],
["variable.publish", {"name": "belt_fit", "label": "Printed groove fit", "description": "Printing only: how much wider each groove is printed so the belt seats. 0.2 mm suits most FDM printers; the largest value keeps the tooth land at least 0.2 mm wide. Ignored for a machined pulley.", "group": "Pulley", "order": 4, "min": "0 mm", "max": "belt_fit_limit", "step": "0.01 mm", "unit": "mm"}],
["variable.publish", {"name": "shaft_diameter", "label": "Shaft diameter", "description": "Diameter of the motor or idler shaft. At least the set screw. The largest value depends on the teeth: the wall under the tooth roots and, machined, the hub must stay strong enough.", "group": "Bore", "order": 1, "min": "smallest_shaft", "max": "max(smallest_shaft, largest_shaft)", "step": "0.05 mm", "unit": "mm"}],
["variable.publish", {"name": "bore_type", "label": "Bore type", "description": "Round; D-shaft with a flat (up to 0.5 mm deep, the first set screw lands on it); or a DIN 6885 keyway (from 6 mm, the first set screw lands on the key).", "group": "Bore", "order": 2, "kind": "choice", "choices": ["Round", "D-shaft", "Keyway"]}],
["variable.publish", {"name": "flanges", "label": "Flanges", "description": "Flanges on both sides keep the belt on (Gates: flange one pulley of a two-pulley drive on both sides). Machined they are separate washers pressed on seats; printed they are part of the body.", "group": "Flanges and hub", "order": 1, "kind": "boolean"}],
["variable.publish", {"name": "hub", "label": "Hub", "description": "A hub on one side that holds the set screws. Without it, press or glue the pulley on the shaft.", "group": "Flanges and hub", "order": 2, "kind": "boolean"}],
["variable.publish", {"name": "hub_style", "label": "Set screws", "description": "M2.5, M3 or M4 grub screws through the hub, the first on the flat or the key: tapped when machined, in captive nuts when printed. Ignored without a hub.", "group": "Flanges and hub", "order": 3, "kind": "choice", "choicesFrom": "hub_options"}],
["variable.publish", {"name": "hub_length", "label": "Hub length", "description": "Length of the hub along the shaft. Ignored without a hub. Long enough for the set screw and, when printed, its nut slot.", "group": "Flanges and hub", "order": 4, "min": "hub_length_needed", "max": "20 mm", "step": "0.5 mm", "unit": "mm"}],
["document.info", {"title": "GT2 pulley (2 mm pitch)", "description": "A GT2 timing pulley with 2 mm pitch: teeth, belt width, machined or printed, bore (round, D-shaft or keyway), with or without flanges and a hub with set screws. Pitch diameter = teeth x 2 mm / pi, the outside 0.508 mm less. To export: File > Export... 3MF or STL for printing (the body already lies in its print orientation on z = 0), STEP for machining (the two flanges are separate pressed-on parts). Tooth outline from droftarts' Parametric Pulley (thingiverse.com/thing:16627), licensed Creative Commons Attribution-ShareAlike as its page states (no version named); this Jig adapts it and is shared under CC BY-SA 4.0, a later version of the same licence.", "author": "3DCraft Jigs (tooth outline: droftarts, thing:16627)", "licence": "CC-BY-SA-4.0", "url": "https://github.com/johancoppens/3dcraft-jigs/tree/main/jigs/06-gt2-pulley", "tags": ["pulley", "GT2", "timing belt", "3D printing", "machining"]}],
["document.check", {}]
]
