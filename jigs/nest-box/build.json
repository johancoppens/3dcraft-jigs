["variable.publish", {"name": "plank_thickness", "label": "Plank thickness", "description": "Thickness of your plank, sawn timber. At least 15 mm insulates the box; inside sizes stay the species' and outside sizes grow.", "group": "Plank", "order": 2, "min": "15 mm", "max": "25 mm", "step": "1 mm", "unit": "mm"}],
["variable.publish", {"name": "plank_width", "label": "Plank width", "description": "Width of your plank. Must be at least the widest board crossing it; narrower than the species needs is refused.", "group": "Plank", "order": 3, "min": "plank_width_needed", "max": "320 mm", "step": "5 mm", "unit": "mm"}],
["variable.publish", {"name": "plank_length", "label": "Plank length", "description": "Length of your plank. All boards are sawn one after another along it, with the grain along it (a terrace has horizontal grain on its long boards).", "group": "Plank", "order": 4, "min": "plank_length_needed", "max": "4000 mm", "step": "10 mm", "unit": "mm"}],
["variable.publish", {"name": "predator_guard", "label": "Predator guard", "description": "A zinc plate around the entrance against woodpeckers and squirrels enlarging the hole (round and oval entrances only).", "group": "Options", "order": 5, "kind": "boolean"}],
["variable.publish", {"name": "hanging_style", "label": "Hanging", "description": "How the box is fixed: a batten behind the box with two screw holes (wall or post), two screws through the back (open the front to reach them), or two holes for a sleeved wire round a branch (no nails in the tree; not for birds the sheet puts on buildings or for the heavy starling box).", "group": "Options", "order": 6, "kind": "choice", "choices": ["Batten behind the box", "Two screws through the back", "Two holes for a wire round a branch"], "max": "nest_sizes[species].hanging_max"}],
