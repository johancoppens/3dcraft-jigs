[
["variable.set", {"name": "innerW", "expr": "240 mm"}],
["variable.set", {"name": "innerD", "expr": "200 mm"}],
["variable.set", {"name": "innerH", "expr": "100 mm"}],
["variable.set", {"name": "t", "expr": "15 mm"}],
["variable.set", {"name": "tails", "expr": "3"}],
["variable.set", {"name": "joint", "expr": "2"}],
["variable.set", {"name": "slopeChoice", "expr": "2"}],
["variable.set", {"name": "groove", "expr": "1"}],
["variable.set", {"name": "knob", "expr": "1"}],
["variable.set", {"name": "dovetail", "expr": "joint == 2"}],
["variable.set", {"name": "bt", "expr": "clamp(t / 2, 4 mm, 8 mm)"}],
["variable.set", {"name": "gOff", "expr": "max(6.3 mm, t / 2 + 0.3 mm)"}],
["variable.set", {"name": "gd", "expr": "t / 2"}],
["variable.set", {"name": "H", "expr": "if(groove, innerH + gOff + bt, innerH)"}],
["variable.set", {"name": "Wo", "expr": "innerW + 2 * t"}],
["variable.set", {"name": "Do", "expr": "innerD + 2 * t"}],
["variable.set", {"name": "s", "expr": "if(dovetail, choose(slopeChoice, 1 / 6, 1 / 8), 0)"}],
["variable.set", {"name": "N", "expr": "tails"}],
["variable.set", {"name": "pn", "expr": "if(dovetail, clamp(0.25 * H / (N + 0.5), 4 mm, 20 mm), H / (2 * N + 1))"}],
["variable.set", {"name": "TW", "expr": "(H - (N + 1) * pn) / N"}],
["variable.set", {"name": "P", "expr": "TW + pn"}],
["variable.set", {"name": "maxTails", "expr": "clamp(floor(H / (2.2 * t)), 1, 12)"}],
["variable.set", {"name": "kr", "expr": "clamp(0.11 * H, 7 mm, 14 mm)"}],
["sketch.create", {"name": "TailSketch", "plane": "zx", "offset": "-1 mm"}],
["sketch.polyline", {"sketch": "TailSketch", "closed": true, "points": [["pn - s * 1 mm", "-1 mm"], ["pn + TW + s * 1 mm", "-1 mm"], ["pn + TW - s * t", "t"], ["pn + s * t", "t"]]}],
["feature.extrude", {"sketch": "TailSketch", "distance": "t + 1 mm", "name": "Tail"}],
["feature.pattern", {"name": "Tails", "source": "Tail", "count": "N", "step": ["0 mm", "0 mm", "P"]}],
["feature.block", {"name": "Zone", "size": ["(t) - (-1 mm)", "(t) - (-1 mm)", "(H + 1 mm) - (-1 mm)"], "position": ["-1 mm", "-1 mm", "-1 mm"]}],
["feature.boolean", {"op": "subtract", "target": "Zone", "tool": "Tails", "keepTool": true, "name": "Pins"}],
["feature.mirror", {"source": "Pins", "normal": [1, 0, 0], "point": ["Wo / 2", "0 mm", "0 mm"], "keep": true, "name": "PinsR"}],
["feature.mirror", {"source": "Tails", "normal": [0, 1, 0], "point": ["0 mm", "Do / 2", "0 mm"], "keep": true, "name": "TailsBack"}],
["feature.block", {"name": "FrontBlank", "size": ["(Wo) - (0 mm)", "(t) - (0 mm)", "(H) - (0 mm)"], "position": ["0 mm", "0 mm", "0 mm"]}],
["feature.boolean", {"op": "subtract", "target": "FrontBlank", "tool": "Pins", "name": "FrontL"}],
["feature.boolean", {"op": "subtract", "target": "FrontL", "tool": "PinsR", "name": "FrontJ"}],
["feature.block", {"name": "SideBlank", "size": ["(t) - (0 mm)", "(Do) - (0 mm)", "(H) - (0 mm)"], "position": ["0 mm", "0 mm", "0 mm"]}],
["feature.boolean", {"op": "subtract", "target": "SideBlank", "tool": "Tails", "name": "SideF"}],
["feature.boolean", {"op": "subtract", "target": "SideF", "tool": "TailsBack", "name": "SideJ"}],
["feature.block", {"name": "FrontGroove", "size": ["(Wo - t + gd) - (t - gd)", "(t + 1 mm) - (t - gd)", "(gOff + bt) - (gOff)"], "position": ["t - gd", "t - gd", "gOff"]}],
["feature.when", {"feature": "FrontGroove", "expr": "groove"}],
["feature.boolean", {"op": "subtract", "target": "FrontJ", "tool": "FrontGroove", "name": "Front"}],
["feature.block", {"name": "SideGroove", "size": ["(t + 1 mm) - (t - gd)", "(Do - t + gd) - (t - gd)", "(gOff + bt) - (gOff)"], "position": ["t - gd", "t - gd", "gOff"]}],
["feature.when", {"feature": "SideGroove", "expr": "groove"}],
["feature.boolean", {"op": "subtract", "target": "SideJ", "tool": "SideGroove", "name": "LeftSide"}],
["feature.mirror", {"source": "Front", "normal": [0, 1, 0], "point": ["0 mm", "Do / 2", "0 mm"], "keep": true, "name": "Back"}],
["feature.mirror", {"source": "LeftSide", "normal": [1, 0, 0], "point": ["Wo / 2", "0 mm", "0 mm"], "keep": true, "name": "RightSide"}],
["feature.block", {"name": "Bottom", "size": ["(if(groove, Wo - t + gd - 0.5 mm, Wo)) - (if(groove, t - gd + 0.5 mm, 0 mm))", "(if(groove, Do - t + gd - 0.5 mm, Do)) - (if(groove, t - gd + 0.5 mm, 0 mm))", "(if(groove, gOff + bt, 0 mm)) - (if(groove, gOff, -bt))"], "position": ["if(groove, t - gd + 0.5 mm, 0 mm)", "if(groove, t - gd + 0.5 mm, 0 mm)", "if(groove, gOff, -bt)"]}],
["feature.cylinder", {"name": "KnobBody", "radius": "kr", "height": "1.4 * kr", "position": ["Wo / 2", "0 mm", "H / 2"], "axis": [0, -1, 0]}],
["feature.fillet", {"name": "Knob", "edges": [["F21:face(0)", "F21:face(2)"]], "radius": "0.35 * kr"}],
["feature.when", {"feature": "KnobBody", "expr": "knob"}],
["feature.when", {"feature": "Knob", "expr": "knob"}],
["body.appearance", {"body": "Front", "color": "#7A5638", "roughness": 0.7}],
["body.appearance", {"body": "Back", "color": "#7A5638", "roughness": 0.7}],
["body.appearance", {"body": "LeftSide", "color": "#D9B98A", "roughness": 0.75}],
["body.appearance", {"body": "RightSide", "color": "#D9B98A", "roughness": 0.75}],
["body.appearance", {"body": "Bottom", "color": "#E8DFCC", "roughness": 0.85}],
["body.appearance", {"body": "Knob", "color": "#B8954A", "metallic": 0.9, "roughness": 0.35}],
["assert.add", {"name": "boards do not overlap", "measure": "interference", "of": ["Front", "Back", "LeftSide", "RightSide", "Bottom"]}],
["variable.publish", {"name": "innerW", "label": "Inner width", "description": "Inside width, between the sides", "group": "Size", "order": 1, "min": "60 mm", "max": "600 mm", "step": "1 mm", "unit": "mm"}],
["variable.publish", {"name": "innerD", "label": "Inner depth", "description": "Inside depth, front to back", "group": "Size", "order": 2, "min": "60 mm", "max": "600 mm", "step": "1 mm", "unit": "mm"}],
["variable.publish", {"name": "innerH", "label": "Inner height", "description": "Inside height, from the bottom to the top edge", "group": "Size", "order": 3, "min": "40 mm", "max": "250 mm", "step": "1 mm", "unit": "mm"}],
["variable.publish", {"name": "t", "label": "Board thickness", "description": "Thickness of the four boards", "group": "Size", "order": 4, "min": "8 mm", "max": "22 mm", "step": "0.5 mm", "unit": "mm"}],
["variable.publish", {"name": "joint", "label": "Joint", "description": "Finger (box) joints or through dovetails", "group": "Joints", "order": 1, "kind": "choice", "choices": ["finger", "dovetail"]}],
["variable.publish", {"name": "tails", "label": "Tails (fingers)", "description": "Number of tails on each end of the front and the back; for a finger joint the number of fingers of the side", "group": "Joints", "order": 2, "kind": "integer", "min": "1", "max": "maxTails"}],
["variable.publish", {"name": "slopeChoice", "label": "Dovetail slope", "description": "1:6 for softwood, 1:8 for hardwood (not used by a finger joint)", "group": "Joints", "order": 3, "kind": "choice", "choices": ["1:6 softwood", "1:8 hardwood"]}],
["variable.publish", {"name": "groove", "label": "Bottom in a groove", "description": "The bottom slides into a groove in all four boards; off: it is fixed under them", "group": "Details", "order": 1, "kind": "boolean"}],
["variable.publish", {"name": "knob", "label": "Knob", "description": "A brass knob in the middle of the front", "group": "Details", "order": 2, "kind": "boolean"}],
["set.define", {"name": "Marking templates", "kind": "face", "where": {"any": [{"in": "Front", "madeBy": "FrontBlank", "normal": {"along": "-y"}}, {"in": "LeftSide", "madeBy": "SideBlank", "normal": {"along": "-x"}}]}}],
["document.info", {"title": "Dovetail and finger-joint drawer", "description": "A drawer or box for woodworkers, joined with through dovetails or finger joints: set the inside width, depth and height, the board thickness, the number of tails and the slope (1:6 softwood, 1:8 hardwood), with the bottom in a groove and a brass knob. Export STEP or STL for CAD or a CNC; the face set \"Marking templates\" (File > Export..., SVG or DXF) gives the front's tails and a side's sockets at true size, to print and mark out by hand.", "author": "Johan Coppens", "licence": "CC-BY-4.0", "url": "https://github.com/johancoppens/3dcraft-jigs/tree/main/jigs/joint-drawer", "tags": ["woodworking", "dovetail", "finger joint", "drawer", "box"]}],
["jig.export", {"path": "dist/joint-drawer.3dcraftjig"}]
]
