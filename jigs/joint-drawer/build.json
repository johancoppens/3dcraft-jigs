["variable.set", {"name": "opening_width", "expr": "520 mm"}],
["variable.set", {"name": "opening_height", "expr": "140 mm"}],
["variable.set", {"name": "opening_depth", "expr": "420 mm"}],
["variable.set", {"name": "side_clearance", "expr": "0.8 mm"}],
["variable.set", {"name": "top_clearance", "expr": "2 mm"}],
["variable.set", {"name": "front_thickness", "expr": "22 mm"}],
["variable.set", {"name": "side_thickness", "expr": "11 mm"}],
["variable.set", {"name": "joint_kind", "expr": "1"}],
["variable.set", {"name": "tail_layout", "expr": "2"}],
["variable.set", {"name": "timber", "expr": "1"}],
["variable.set", {"name": "pull_style", "expr": "1"}],
["variable.set", {"name": "pull_out", "expr": "55"}],
["table.set", {"name": "joint_kinds", "key": "joint", "columns": ["joint", "half_blind", "box_joint"], "rows": [["Through dovetails, front and back", 0, 0], ["Half-blind dovetails at the front, through at the back", 1, 0], ["Box (finger) joints", 0, 1]]}],
["table.set", {"name": "tail_layouts", "key": "layout", "columns": ["layout", "tail_share", "pitch_factor"], "rows": [["Even, like a machine (tails half of the layout)", 0.5, 1.6], ["Classic hand-cut (tails 70 % of the layout)", 0.7, 1.6], ["Fine pins (tails 80 % of the layout)", 0.8, 1.8]]}],
["table.set", {"name": "timbers", "key": "timber", "columns": ["timber", "slope_run", "front_density", "side_density", "front_movement", "side_movement"], "rows": [["Walnut front, maple sides (hardwood, 1:8)", 8, 610, 705, 0.00274, 0.00353], ["Oak throughout (hardwood, 1:8)", 8, 755, 755, 0.00365, 0.00365], ["Cherry front, poplar sides (hardwood, 1:8)", 8, 560, 455, 0.00248, 0.00289], ["Pine throughout (softwood, 1:6)", 6, 400, 400, 0.00212, 0.00212]]}],
["variable.set", {"name": "back_clearance", "expr": "10 mm"}],
["variable.set", {"name": "groove_inset", "expr": "8 mm"}],
["variable.set", {"name": "groove_width", "expr": "6 mm"}],
["variable.set", {"name": "bottom_play", "expr": "1 mm"}],
["variable.set", {"name": "groove_margin", "expr": "2 mm"}],
["variable.set", {"name": "back_drop", "expr": "6 mm"}],
["variable.set", {"name": "lap_thickness", "expr": "6.35 mm"}],
["variable.set", {"name": "edge_radius", "expr": "1.5 mm"}],
["variable.set", {"name": "smallest_pin", "expr": "3 mm"}],
["variable.set", {"name": "moisture_swing", "expr": "4"}],
["variable.set", {"name": "case_wall", "expr": "18 mm"}],
["variable.set", {"name": "half_blind", "expr": "joint_kinds[joint_kind].half_blind"}],
["variable.set", {"name": "box_joint", "expr": "joint_kinds[joint_kind].box_joint"}],
["variable.set", {"name": "joint_slope", "expr": "if(box_joint, 0, 1 / timbers[timber].slope_run)"}],
["variable.set", {"name": "tail_ratio", "expr": "if(box_joint, 1, tail_layouts[tail_layout].tail_share / (1 - tail_layouts[tail_layout].tail_share))"}],
["variable.set", {"name": "tail_start_y", "expr": "if(half_blind, lap_thickness, 0 mm)"}],
["variable.set", {"name": "drawer_width", "expr": "opening_width - 2 * side_clearance"}],
["variable.set", {"name": "drawer_height", "expr": "opening_height - top_clearance"}],
["variable.set", {"name": "drawer_depth", "expr": "opening_depth - back_clearance"}],
["variable.set", {"name": "back_thickness", "expr": "side_thickness"}],
["variable.set", {"name": "groove_depth", "expr": "side_thickness / 2"}],
["variable.set", {"name": "groove_top", "expr": "groove_inset + groove_width"}],
["variable.set", {"name": "groove_cover", "expr": "groove_top + groove_margin"}],
["variable.set", {"name": "bottom_span", "expr": "min(drawer_width - 2 * side_thickness, drawer_depth - front_thickness - back_thickness)"}],
["variable.set", {"name": "bottom_thickness", "expr": "if(bottom_span <= 450 mm, 6 mm, if(bottom_span <= 650 mm, 9 mm, 12 mm))"}],
["variable.set", {"name": "bottom_underside_z", "expr": "groove_top - bottom_thickness"}],
["variable.set", {"name": "bottom_core_play", "expr": "0.5 mm"}],
["variable.set", {"name": "finger_target", "expr": "1.2 * side_thickness"}],
["variable.set", {"name": "front_tail_length", "expr": "front_thickness - tail_start_y"}],
["variable.set", {"name": "pitch_target", "expr": "tail_layouts[tail_layout].pitch_factor * front_thickness"}],
["variable.set", {"name": "front_tail_count", "expr": "if(box_joint, max(2, round((drawer_height - groove_cover) / (2 * finger_target))), max(1, round((drawer_height - groove_cover) / pitch_target)))"}],
["variable.set", {"name": "front_layout_parts", "expr": "front_tail_count * (tail_ratio + 1)"}],
["variable.set", {"name": "front_pin_width", "expr": "min(drawer_height / (front_layout_parts + 1), (drawer_height - groove_cover) / front_layout_parts)"}],
["variable.set", {"name": "front_half_pin", "expr": "max(front_pin_width, groove_cover)"}],
["variable.set", {"name": "front_tail_width", "expr": "tail_ratio * front_pin_width"}],
["variable.set", {"name": "front_pitch", "expr": "front_tail_width + front_pin_width"}],
["variable.set", {"name": "back_bottom_z", "expr": "groove_top"}],
["variable.set", {"name": "back_top_z", "expr": "drawer_height - back_drop"}],
["variable.set", {"name": "back_span", "expr": "back_top_z - back_bottom_z"}],
["variable.set", {"name": "back_tail_count", "expr": "if(box_joint, max(1, ceil((back_span / finger_target - 1) / 2)), max(1, round(back_span / pitch_target)))"}],
["variable.set", {"name": "back_layout_parts", "expr": "back_tail_count * (tail_ratio + 1)"}],
["variable.set", {"name": "back_pin_width", "expr": "back_span / (back_layout_parts + 1)"}],
["variable.set", {"name": "back_tail_width", "expr": "tail_ratio * back_pin_width"}],
["variable.set", {"name": "back_pitch", "expr": "back_tail_width + back_pin_width"}],
["variable.set", {"name": "front_pin_seed_z", "expr": "if(front_tail_count > 1, front_half_pin + front_tail_width, 3 * drawer_height)"}],
["variable.set", {"name": "back_pin_seed_z", "expr": "if(back_tail_count > 1, back_bottom_z + back_pin_width + back_tail_width, 3 * drawer_height)"}],
["variable.set", {"name": "seasonal_movement", "expr": "opening_height * max(timbers[timber].front_movement, timbers[timber].side_movement) * moisture_swing"}],
["variable.set", {"name": "top_clearance_min", "expr": "ceil(max(seasonal_movement, 1 mm) / 0.1 mm) * 0.1 mm"}],
["variable.set", {"name": "side_thickness_min", "expr": "ceil(clamp(max(opening_width, opening_depth) / 60, 8 mm, 12 mm) / 0.5 mm) * 0.5 mm"}],
["variable.set", {"name": "groove_cut_floor", "expr": "side_thickness - groove_depth"}],
["variable.set", {"name": "bottom_margin", "expr": "groove_cut_floor + bottom_play"}],
["variable.set", {"name": "knob_radius", "expr": "clamp(drawer_height * 0.125, 9 mm, 19 mm)"}],
["variable.set", {"name": "knob_height", "expr": "knob_radius * 1.85"}],
["variable.set", {"name": "turned_dome_radius", "expr": "(knob_radius^2 + (0.38 * knob_height)^2) / (2 * 0.38 * knob_height)"}],
["variable.set", {"name": "brass_dome_radius", "expr": "(knob_radius^2 + (0.32 * knob_height)^2) / (2 * 0.32 * knob_height)"}],
["variable.set", {"name": "knob_count", "expr": "if(drawer_width > 450 mm, 2, 1)"}],
["variable.set", {"name": "knob_spacing", "expr": "drawer_width / 2"}],
["variable.set", {"name": "first_knob_x", "expr": "drawer_width / 2 - (knob_count - 1) * knob_spacing / 2"}],
["variable.set", {"name": "knob_tenon_radius", "expr": "min(6 mm, 0.5 * knob_radius)"}],
["variable.set", {"name": "knob_hole_radius", "expr": "if(pull_style == 2, 2.25 mm, knob_tenon_radius)"}],
["variable.set", {"name": "case_shift_y", "expr": "pull_out / 100 * drawer_depth"}],
["variable.set", {"name": "screw_count", "expr": "max(1, floor(drawer_width / 200 mm))"}],
["variable.set", {"name": "screw_pitch", "expr": "drawer_width / screw_count"}],
["variable.set", {"name": "screw_hole_radius", "expr": "2.25 mm"}],
["variable.set", {"name": "screw_y", "expr": "drawer_depth - back_thickness / 2"}],

