["feature.pattern", {"source": "Brass knob", "count": "knob_count", "step": ["knob_spacing", "0 mm", "0 mm"], "name": "Brass knobs", "when": "pull_style == 2"}],

["sketch.create", {"name": "Sketch Case", "plane": "zx", "offset": "case_shift_y"}],
["sketch.rect", {"sketch": "Sketch Case", "from": ["-case_wall", "-side_clearance - case_wall"], "to": ["opening_height + case_wall", "drawer_width + side_clearance + case_wall"]}],
["sketch.rect", {"sketch": "Sketch Case", "from": ["0 mm", "-side_clearance"], "to": ["opening_height", "drawer_width + side_clearance"]}],
["feature.extrude", {"sketch": "Sketch Case", "distance": "opening_depth", "name": "Case"}],

["variable.set", {"name": "edge_arris_area", "expr": "(1 - pi / 4) * edge_radius^2"}],
["variable.set", {"name": "knob_hole_count", "expr": "if(pull_style != 3, knob_count, 0)"}],
["variable.set", {"name": "front_volume_expected", "expr": "front_thickness * drawer_height * drawer_width - 2 * edge_arris_area * drawer_width - 2 * front_tail_count * side_thickness * (front_tail_width * front_tail_length - joint_slope * front_tail_length^2) - knob_hole_count * pi * knob_hole_radius^2 * front_thickness - (drawer_width - 2 * groove_cut_floor) * groove_depth * groove_width"}],
["variable.set", {"name": "pin_area_front_end", "expr": "front_tail_length * (front_half_pin + front_tail_count * front_pin_width) + front_tail_count * joint_slope * front_tail_length^2"}],
["variable.set", {"name": "pin_area_back_end", "expr": "back_thickness * back_pin_width * (back_tail_count + 1) + back_tail_count * joint_slope * back_thickness^2"}],
["variable.set", {"name": "side_volume_expected", "expr": "(side_thickness * drawer_height - 2 * edge_arris_area - groove_depth * groove_width) * (drawer_depth - tail_start_y) - side_thickness * pin_area_front_end + (groove_depth * groove_width + 2 * edge_arris_area) * front_tail_length - side_thickness * pin_area_back_end"}],
["variable.set", {"name": "back_volume_expected", "expr": "back_thickness * back_span * drawer_width - 2 * edge_arris_area * drawer_width - 2 * back_tail_count * side_thickness * (back_tail_width * back_thickness - joint_slope * back_thickness^2)"}],
["material.preset", {"body": "Front", "preset": "walnut", "color": "#3f2717", "roughness": 0.44, "pattern": {"colors": ["#4a3323", "#3a2719", "#231610"], "axis": [1, 0, 0], "scale": 5.5, "grain": 0.8, "distortion": 0.35, "rays": 0.04, "seed": 3}}],
["body.material", {"body": "Front", "name": "Front timber", "density": "timbers[timber].front_density kg/m^3"}],
["material.preset", {"body": "Left side", "preset": "wood", "color": "#dcc096", "roughness": 0.5, "pattern": {"kind": "wood", "colors": ["#ecdcbd", "#e4cfaa", "#d6bc90"], "grain": 0.6, "rays": 0.02, "scale": 8, "distortion": 0.3, "axis": [0, 1, 0]}}],
["body.material", {"body": "Left side", "name": "Side timber", "density": "timbers[timber].side_density kg/m^3"}],
["material.preset", {"body": "Right side", "preset": "wood", "color": "#dcc096", "roughness": 0.5, "pattern": {"kind": "wood", "colors": ["#ecdcbd", "#e4cfaa", "#d6bc90"], "grain": 0.6, "rays": 0.02, "scale": 8, "distortion": 0.3, "axis": [0, 1, 0]}}],
["body.material", {"body": "Right side", "name": "Side timber", "density": "timbers[timber].side_density kg/m^3"}],
["material.preset", {"body": "Back", "preset": "wood", "color": "#dcc096", "roughness": 0.5, "pattern": {"kind": "wood", "colors": ["#ecdcbd", "#e4cfaa", "#d6bc90"], "grain": 0.6, "rays": 0.02, "scale": 8, "distortion": 0.3, "axis": [1, 0, 0], "seed": 2}}],
["body.material", {"body": "Back", "name": "Side timber", "density": "timbers[timber].side_density kg/m^3"}],
["material.preset", {"body": "Bottom", "preset": "wood", "color": "#d8cba9", "roughness": 0.72, "pattern": {"kind": "wood", "colors": ["#e2d6ba", "#d6c8a8", "#c6b68f"], "grain": 0.3, "rays": 0.0, "scale": 9, "distortion": 0.1, "axis": [1, 0.03, 0]}}],
["body.material", {"body": "Bottom", "name": "Birch plywood", "density": "680 kg/m^3"}],
["material.preset", {"body": "Turned knobs", "preset": "wood", "color": "#e2cc9f", "roughness": 0.34, "pattern": {"kind": "wood", "colors": ["#edd9b6", "#e1c99e", "#c7a877"], "grain": 0.5, "rays": 0.05, "scale": 4.5, "distortion": 0.2, "axis": [0.08, 1, 0.08]}}],
["body.appearance", {"body": "Brass knobs", "color": "#b78b3e", "metallic": 0.92, "roughness": 0.32}],
["body.appearance", {"body": "Case", "color": "#868d7f", "metallic": 0, "roughness": 0.85}],
["set.define", {"name": "Marking templates", "kind": "face", "where": {"any": [{"in": "Left side", "normal": {"along": "-x"}, "surface": "plane"}, {"in": "Front", "normal": {"along": "-x"}, "surface": "plane", "below": {"x": "0.5 mm"}}, {"in": "Back", "normal": {"along": "-x"}, "surface": "plane", "below": {"x": "0.5 mm"}}, {"in": "Bottom", "normal": {"along": "z"}, "surface": "plane"}]}}],
["variable.measure", {"name": "drawer_mass", "measure": "mass", "of": ["Front", "Left side", "Right side", "Back", "Bottom"], "label": "Mass of the boards", "unit": "kg"}],
["variable.output", {"name": "drawer_size_width", "expr": "drawer_width", "label": "Drawer width (outside)", "unit": "mm"}],
["variable.output", {"name": "drawer_size_height", "expr": "drawer_height", "label": "Drawer height at the sides", "unit": "mm"}],
["variable.output", {"name": "drawer_size_depth", "expr": "drawer_depth", "label": "Drawer depth (outside)", "unit": "mm"}],
["variable.output", {"name": "inside_size_width", "expr": "drawer_width - 2 * side_thickness", "label": "Inside width", "unit": "mm"}],
["variable.output", {"name": "inside_size_depth", "expr": "drawer_depth - front_thickness - back_thickness", "label": "Inside depth", "unit": "mm"}],
["variable.output", {"name": "inside_size_height", "expr": "back_top_z - groove_top", "label": "Inside height (bottom to the back's top)", "unit": "mm"}],
["variable.output", {"name": "inside_volume", "expr": "(drawer_width - 2 * side_thickness) * (drawer_depth - front_thickness - back_thickness) * (back_top_z - groove_top)", "label": "Inside volume", "unit": "L"}],
["variable.output", {"name": "tails_at_front", "expr": "front_tail_count", "label": "Tails at the front"}],
["variable.output", {"name": "tails_at_back", "expr": "back_tail_count", "label": "Tails at the back"}],
["variable.output", {"name": "slope_rule_ratio", "expr": "if(box_joint, 0, timbers[timber].slope_run)", "label": "Dovetail slope, 1 in (0 for box joints)"}],
["variable.output", {"name": "tail_width_wide", "expr": "front_tail_width", "label": "Tail width at its wide end, front", "unit": "mm"}],
["variable.output", {"name": "pin_width_narrow", "expr": "front_pin_width", "label": "Pin width at its narrow end, front", "unit": "mm"}],
["variable.output", {"name": "front_size_length", "expr": "drawer_width", "label": "Saw list: front length", "unit": "mm"}],
["variable.output", {"name": "front_size_height", "expr": "drawer_height", "label": "Saw list: front height", "unit": "mm"}],
["variable.output", {"name": "side_size_length", "expr": "drawer_depth - tail_start_y", "label": "Saw list: side length, twice", "unit": "mm"}],
["variable.output", {"name": "side_size_height", "expr": "drawer_height", "label": "Saw list: side height", "unit": "mm"}],
["variable.output", {"name": "back_size_length", "expr": "drawer_width", "label": "Saw list: back length", "unit": "mm"}],
["variable.output", {"name": "back_size_height", "expr": "back_span", "label": "Saw list: back height", "unit": "mm"}],
["variable.output", {"name": "bottom_size_width", "expr": "drawer_width - 2 * bottom_margin", "label": "Saw list: bottom width", "unit": "mm"}],
["variable.output", {"name": "bottom_size_thickness", "expr": "bottom_thickness", "label": "Saw list: bottom thickness (rebated to a 6 mm tongue when over 6 mm)", "unit": "mm"}],
["variable.output", {"name": "bottom_size_depth", "expr": "drawer_depth - 0.5 mm - (front_thickness - groove_depth + bottom_play)", "label": "Saw list: bottom depth", "unit": "mm"}],
["variable.output", {"name": "swelling_of_front", "expr": "seasonal_movement", "label": "Boards swell across their grain, a season's swing", "unit": "mm"}],
["assert.add", {"name": "Front: volume equals the closed form (tail sockets, slope, groove and knob holes together)", "measure": "volume", "of": "Front", "eq": "front_volume_expected", "tol": "10"}],
["assert.add", {"name": "Side: volume equals the closed form (pin sockets at both ends, slope and groove together)", "measure": "volume", "of": "Left side", "eq": "side_volume_expected", "tol": "10"}],
["assert.add", {"name": "Back: volume equals the closed form (tail sockets at both ends, slope)", "measure": "volume", "of": "Back", "eq": "back_volume_expected", "tol": "10"}],
["assert.add", {"name": "Dovetails: the tails at the front are as many as the layout rule says", "measure": "count", "of": {"kind": "face", "where": {"in": "Left side", "normal": {"along": "-y"}, "surface": "plane", "above": {"y": "front_thickness - 0.5 mm"}, "below": {"y": "front_thickness + 0.5 mm"}}}, "eq": "front_tail_count + 1"}],
["assert.add", {"name": "Dovetails: the tails at the back are as many as the layout rule says", "measure": "count", "of": {"kind": "face", "where": {"in": "Left side", "normal": {"along": "y"}, "surface": "plane", "above": {"y": "drawer_depth - back_thickness - 0.5 mm"}, "below": {"y": "drawer_depth - back_thickness + 0.5 mm"}}}, "eq": "back_tail_count + 1"}],
["assert.add", {"name": "Layout: pins at least a chisel wide at their narrow end, front", "measure": "value", "expr": "front_pin_width", "min": "smallest_pin"}],
["assert.add", {"name": "Layout: pins at least a chisel wide at their narrow end, back", "measure": "value", "expr": "back_pin_width", "min": "smallest_pin"}],
["assert.add", {"name": "Layout: tails keep at least 4 mm at the baseline, front", "measure": "value", "expr": "front_tail_width - 2 * joint_slope * front_tail_length", "min": "4 mm"}],
["assert.add", {"name": "Layout: tails keep at least 4 mm at the baseline, back", "measure": "value", "expr": "back_tail_width - 2 * joint_slope * back_thickness", "min": "4 mm"}],
["assert.add", {"name": "Boards: none overlaps another", "measure": "overlap", "of": ["Front", "Left side", "Right side", "Back", "Bottom"], "is": false}],
["assert.add", {"name": "Fit: the boards clear the case while the drawer runs", "measure": "overlap", "of": ["Front", "Left side", "Right side", "Back", "Bottom"], "to": ["Case"], "is": false}],
["assert.add", {"name": "Slope: the pin sockets' baselines on the model match the timber's slope (1 in 8 hardwood, 1 in 6 softwood, square for box joints)", "measure": "area", "of": {"kind": "face", "where": {"in": "Left side", "normal": {"along": "-y"}, "surface": "plane", "above": {"y": "front_thickness - 0.5 mm"}, "below": {"y": "front_thickness + 0.5 mm"}}}, "eq": "side_thickness * (front_half_pin + front_tail_count * front_pin_width + 2 * front_tail_count * if(box_joint, 0, 1 / timbers[timber].slope_run) * front_tail_length) - groove_depth * groove_width - 2 * edge_arris_area", "tol": "1"}],
["assert.add", {"name": "Groove: hidden behind the half pin, the tail ends on the model are whole", "measure": "area", "of": {"kind": "face", "where": {"in": "Left side", "normal": {"along": "-y"}, "surface": "plane", "below": {"y": "tail_start_y + 0.5 mm"}}}, "eq": "front_tail_count * front_tail_width * side_thickness", "tol": "1"}],
["assert.add", {"name": "Groove: on the model half the side's thickness deep, 6 mm wide, running to the back", "measure": "area", "of": {"kind": "face", "where": {"in": "Left side", "normal": {"along": "x"}, "surface": "plane", "above": {"x": "side_thickness / 2 - 0.1 mm"}, "below": {"x": "side_thickness / 2 + 0.1 mm"}}}, "eq": "groove_width * (drawer_depth - front_thickness)", "tol": "1"}],
["assert.add", {"name": "Groove: its lower wall on the model is 6 to 12 mm above the side's lower edge", "measure": "area", "of": {"kind": "face", "where": {"in": "Left side", "normal": {"along": "z"}, "surface": "plane", "above": {"z": "6 mm"}, "below": {"z": "12 mm"}}}, "eq": "groove_depth * (drawer_depth - front_thickness)", "tol": "1"}],
["assert.add", {"name": "Bottom: its underside stays above the drawer's lower edge, clear of the runner", "measure": "boxMin", "of": "Bottom", "axis": "z", "min": "1 mm"}],
["assert.add", {"name": "Bottom: volume equals the closed form (tongue, thick core, screw holes)", "measure": "volume", "of": "Bottom", "eq": "(drawer_width - 2 * bottom_margin) * (drawer_depth - 0.5 mm - front_thickness + groove_depth - bottom_play) * groove_width + (drawer_width - 2 * side_thickness - 2 * bottom_core_play) * (drawer_depth - 0.5 mm - front_thickness - bottom_core_play) * (bottom_thickness - groove_width) - screw_count * pi * screw_hole_radius^2 * bottom_thickness", "tol": "10"}],
["assert.add", {"name": "Back: stops at the top of the groove, so the bottom slides in under it", "measure": "boxMin", "of": "Back", "axis": "z", "min": "groove_inset + groove_width"}],
["assert.add", {"name": "Fit: width on the model is the opening less the running clearance", "measure": "extent", "of": "Front", "axis": "x", "eq": "opening_width - 2 * side_clearance"}],
["assert.add", {"name": "Fit: height on the model is the opening less the top clearance", "measure": "extent", "of": "Left side", "axis": "z", "eq": "opening_height - top_clearance"}],
["assert.add", {"name": "Fit: the top gap on the model covers a season's swelling across the grain", "measure": "boxMax", "of": "Left side", "axis": "z", "max": "opening_height - seasonal_movement"}],
["variable.publish", {"name": "opening_width", "label": "Width of the opening", "description": "The clear width of the hole the drawer must fit, between the case's sides, measured at the front.", "group": "The opening", "order": 1, "min": "150 mm", "max": "1000 mm", "step": "1 mm", "unit": "mm"}],
["variable.publish", {"name": "opening_height", "label": "Height of the opening", "description": "The clear height of the hole, from the runner the drawer rests on to the top.", "group": "The opening", "order": 2, "min": "70 mm", "max": "300 mm", "step": "1 mm", "unit": "mm"}],
["variable.publish", {"name": "opening_depth", "label": "Depth of the opening", "description": "From the front of the case to whatever stops the drawer at the back. The drawer ends 10 mm short of it.", "group": "The opening", "order": 3, "min": "150 mm", "max": "800 mm", "step": "1 mm", "unit": "mm"}],
["variable.publish", {"name": "side_clearance", "label": "Running clearance each side", "description": "The gap between each drawer side and the case, as the drawer runs on wooden runners: about 0.8 mm is a snug hand fit; a loose drawer or one on slides takes more.", "group": "The opening", "order": 4, "min": "0.4 mm", "max": "15 mm", "step": "0.1 mm", "unit": "mm"}],
["variable.publish", {"name": "top_clearance", "label": "Clearance at the top", "description": "The gap above the drawer. Refused below what the boards swell across their grain in a wet season, for your timber and height; more is fine.", "group": "The opening", "order": 5, "min": "top_clearance_min", "max": "12 mm", "step": "0.1 mm", "unit": "mm"}],
["variable.publish", {"name": "front_thickness", "label": "Front board thickness", "description": "Thickness of the front, at least 20 mm. The back follows the sides.", "group": "Stock", "order": 6, "min": "20 mm", "max": "32 mm", "step": "1 mm", "unit": "mm"}],
["variable.publish", {"name": "side_thickness", "label": "Side and back thickness", "description": "Thickness of the sides and the back. Refused below what the drawer's size needs (8 mm up to 480 mm, 12 mm from 720 mm).", "group": "Stock", "order": 7, "min": "side_thickness_min", "max": "14 mm", "step": "0.5 mm", "unit": "mm"}],
["variable.publish", {"name": "joint_kind", "label": "Joint", "description": "Through dovetails show the tails on the front; half-blind leaves the front's face whole and through-dovetails only the back; box joints are the machine-shop version.", "group": "Joinery", "order": 8, "kind": "choice", "choicesFrom": "joint_kinds"}],
["variable.publish", {"name": "tail_layout", "label": "Tail layout", "description": "How the tails share the layout with the pins and how many there are: even (machine-cut look), classic (hand-cut, tails about 70 %) or fine (slender pins, tails about 80 %). Box joints ignore it.", "group": "Joinery", "order": 9, "kind": "choice", "choicesFrom": "tail_layouts"}],
["variable.publish", {"name": "timber", "label": "Timber", "description": "The species pair sets the slope (1:8 for hardwood sides, 1:6 for softwood), the mass and the wood movement the top clearance must allow. The picture stays walnut and maple whichever you pick.", "group": "Joinery", "order": 10, "kind": "choice", "choicesFrom": "timbers"}],
["variable.publish", {"name": "pull_style", "label": "Pull", "description": "A turned knob with a wedged tenon through the front, a brass knob on an M4 screw, or nothing. Above 450 mm wide the drawer gets two.", "group": "Pull", "order": 11, "kind": "choice", "choices": ["Turned knob", "Brass knob", "No knob"]}],
["variable.publish", {"name": "pull_out", "label": "Pull the drawer out (view only)", "description": "Slides the drawer out of the case to see it running. No effect on the boards.", "group": "Pull", "order": 12, "min": "0", "max": "75", "step": "1"}],
["document.info", {"title": "Dovetail drawer", "author": "3DCraft Jigs", "licence": "CC-BY-4.0", "description": "A dovetailed drawer sized from the hole it must fill: give the opening and the running clearance, your board thickness, the joint and the timber. The Jig follows the old rules (slope 1:8 hardwood, 1:6 softwood; tails on the sides, pins on the front and back, half pins covering the groove) and refuses a top gap that a wet season would close. Grain runs along each board's length, the bottom's face veneer across the drawer. Export the boards for marking out with File > Export, Sheet of set: Marking templates, SVG or DXF: the tail side (register it on the lower edge) and the pin ends at true size. For CAM, select the five boards and export the selection as STEP; the saw list is in the outputs.", "tags": ["woodwork", "dovetail", "drawer", "joinery", "furniture", "walnut", "maple"]}],
["document.check", {}]
]
