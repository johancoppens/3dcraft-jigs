[
  ["table.set", {"name": "materials", "columns": ["material", "E", "G", "rho", "fy", "fd", "red", "green", "blue"], "rows": [
    ["S235 steel", 210000, 81000, 7850, 235, 235, 125, 133, 140],
    ["S355 steel", 210000, 81000, 7850, 355, 355, 125, 133, 140],
    ["Aluminium 5754-H111", 70000, 27000, 2700, 80, 72.7, 185, 190, 196],
    ["Aluminium 5083-H111", 70000, 27000, 2700, 125, 113.6, 185, 190, 196],
    ["Aluminium 6082-T6", 70000, 27000, 2700, 260, 113.6, 185, 190, 196]]}],

  ["variable.set", {"name": "length", "expr": "1000 mm"}],
  ["variable.set", {"name": "width", "expr": "100 mm"}],
  ["variable.set", {"name": "height", "expr": "150 mm"}],
  ["variable.set", {"name": "tTop", "expr": "4 mm"}],
  ["variable.set", {"name": "tBot", "expr": "4 mm"}],
  ["variable.set", {"name": "tLeft", "expr": "3 mm"}],
  ["variable.set", {"name": "tRight", "expr": "3 mm"}],
  ["variable.set", {"name": "openWall", "expr": "1"}],
  ["variable.set", {"name": "capTL", "expr": "1"}],
  ["variable.set", {"name": "capTR", "expr": "1"}],
  ["variable.set", {"name": "capBL", "expr": "1"}],
  ["variable.set", {"name": "capBR", "expr": "1"}],
  ["variable.set", {"name": "ovK", "expr": "2"}],
  ["variable.set", {"name": "tBh", "expr": "4 mm"}],
  ["variable.set", {"name": "bhSpacing", "expr": "300 mm"}],
  ["variable.set", {"name": "bhEnd", "expr": "100 mm"}],
  ["variable.set", {"name": "tabPitch", "expr": "150 mm"}],
  ["variable.set", {"name": "tabDepth", "expr": "60"}],
  ["variable.set", {"name": "fitExtra", "expr": "0 mm"}],
  ["variable.set", {"name": "material", "expr": "1"}],

  ["variable.set", {"name": "oT", "expr": "openWall == 2"}],
  ["variable.set", {"name": "oB", "expr": "openWall == 3"}],
  ["variable.set", {"name": "oL", "expr": "openWall == 4"}],
  ["variable.set", {"name": "oR", "expr": "openWall == 5"}],
  ["variable.set", {"name": "eTL", "expr": "!oT && !oL"}],
  ["variable.set", {"name": "eTR", "expr": "!oT && !oR"}],
  ["variable.set", {"name": "eBL", "expr": "!oB && !oL"}],
  ["variable.set", {"name": "eBR", "expr": "!oB && !oR"}],
  ["variable.set", {"name": "f", "expr": "tabDepth / 100"}],
  ["variable.set", {"name": "hTL", "expr": "capTL == 1"}],
  ["variable.set", {"name": "hTR", "expr": "capTR == 1"}],
  ["variable.set", {"name": "hBL", "expr": "capBL == 1"}],
  ["variable.set", {"name": "hBR", "expr": "capBR == 1"}],

  ["variable.set", {"name": "tcTL", "expr": "if(hTL, tTop, tLeft)"}],
  ["variable.set", {"name": "tbTL", "expr": "if(hTL, tLeft, tTop)"}],
  ["variable.set", {"name": "clrTL", "expr": "0.05 mm + 0.025 * max(tcTL, tbTL) + fitExtra"}],
  ["variable.set", {"name": "plugTL", "expr": "tcTL * (1 - f) >= 3 mm && tbTL + 2 * clrTL >= 3 mm"}],
  ["variable.set", {"name": "lenTL", "expr": "if(plugTL, f * tcTL, 1.2 * tcTL)"}],
  ["variable.set", {"name": "wTL", "expr": "if(plugTL, 40 mm, max(8 mm, 4 * tbTL))"}],
  ["variable.set", {"name": "swTL", "expr": "tbTL + 2 * clrTL"}],
  ["variable.set", {"name": "rdTL", "expr": "min(max(0.2 mm, 0.08 * tcTL), swTL / 4.5)"}],
  ["variable.set", {"name": "e1TL", "expr": "rdTL / (2 * sqrt(2))"}],
  ["variable.set", {"name": "ovTL", "expr": "ovK * tcTL + clrTL"}],

  ["variable.set", {"name": "tcTR", "expr": "if(hTR, tTop, tRight)"}],
  ["variable.set", {"name": "tbTR", "expr": "if(hTR, tRight, tTop)"}],
  ["variable.set", {"name": "clrTR", "expr": "0.05 mm + 0.025 * max(tcTR, tbTR) + fitExtra"}],
  ["variable.set", {"name": "plugTR", "expr": "tcTR * (1 - f) >= 3 mm && tbTR + 2 * clrTR >= 3 mm"}],
  ["variable.set", {"name": "lenTR", "expr": "if(plugTR, f * tcTR, 1.2 * tcTR)"}],
  ["variable.set", {"name": "wTR", "expr": "if(plugTR, 40 mm, max(8 mm, 4 * tbTR))"}],
  ["variable.set", {"name": "swTR", "expr": "tbTR + 2 * clrTR"}],
  ["variable.set", {"name": "rdTR", "expr": "min(max(0.2 mm, 0.08 * tcTR), swTR / 4.5)"}],
  ["variable.set", {"name": "e1TR", "expr": "rdTR / (2 * sqrt(2))"}],
  ["variable.set", {"name": "ovTR", "expr": "ovK * tcTR + clrTR"}],

  ["variable.set", {"name": "tcBL", "expr": "if(hBL, tBot, tLeft)"}],
  ["variable.set", {"name": "tbBL", "expr": "if(hBL, tLeft, tBot)"}],
  ["variable.set", {"name": "clrBL", "expr": "0.05 mm + 0.025 * max(tcBL, tbBL) + fitExtra"}],
  ["variable.set", {"name": "plugBL", "expr": "tcBL * (1 - f) >= 3 mm && tbBL + 2 * clrBL >= 3 mm"}],
  ["variable.set", {"name": "lenBL", "expr": "if(plugBL, f * tcBL, 1.2 * tcBL)"}],
  ["variable.set", {"name": "wBL", "expr": "if(plugBL, 40 mm, max(8 mm, 4 * tbBL))"}],
  ["variable.set", {"name": "swBL", "expr": "tbBL + 2 * clrBL"}],
  ["variable.set", {"name": "rdBL", "expr": "min(max(0.2 mm, 0.08 * tcBL), swBL / 4.5)"}],
  ["variable.set", {"name": "e1BL", "expr": "rdBL / (2 * sqrt(2))"}],
  ["variable.set", {"name": "ovBL", "expr": "ovK * tcBL + clrBL"}],

  ["variable.set", {"name": "tcBR", "expr": "if(hBR, tBot, tRight)"}],
  ["variable.set", {"name": "tbBR", "expr": "if(hBR, tRight, tBot)"}],
  ["variable.set", {"name": "clrBR", "expr": "0.05 mm + 0.025 * max(tcBR, tbBR) + fitExtra"}],
  ["variable.set", {"name": "plugBR", "expr": "tcBR * (1 - f) >= 3 mm && tbBR + 2 * clrBR >= 3 mm"}],
  ["variable.set", {"name": "lenBR", "expr": "if(plugBR, f * tcBR, 1.2 * tcBR)"}],
  ["variable.set", {"name": "wBR", "expr": "if(plugBR, 40 mm, max(8 mm, 4 * tbBR))"}],
  ["variable.set", {"name": "swBR", "expr": "tbBR + 2 * clrBR"}],
  ["variable.set", {"name": "rdBR", "expr": "min(max(0.2 mm, 0.08 * tcBR), swBR / 4.5)"}],
  ["variable.set", {"name": "e1BR", "expr": "rdBR / (2 * sqrt(2))"}],
  ["variable.set", {"name": "ovBR", "expr": "ovK * tcBR + clrBR"}],

  ["variable.set", {"name": "zL0", "expr": "if(oB, 0 mm, if(hBL, tBot, -ovBL))"}],
  ["variable.set", {"name": "zL1", "expr": "if(oT, height, if(hTL, height - tTop, height + ovTL))"}],
  ["variable.set", {"name": "zR0", "expr": "if(oB, 0 mm, if(hBR, tBot, -ovBR))"}],
  ["variable.set", {"name": "zR1", "expr": "if(oT, height, if(hTR, height - tTop, height + ovTR))"}],
  ["variable.set", {"name": "yT0", "expr": "if(oL, 0 mm, if(hTL, -ovTL, tLeft))"}],
  ["variable.set", {"name": "yT1", "expr": "if(oR, width, if(hTR, width + ovTR, width - tRight))"}],
  ["variable.set", {"name": "yB0", "expr": "if(oL, 0 mm, if(hBL, -ovBL, tLeft))"}],
  ["variable.set", {"name": "yB1", "expr": "if(oR, width, if(hBR, width + ovBR, width - tRight))"}],
  ["variable.set", {"name": "yi0", "expr": "if(oL, 0 mm, tLeft)"}],
  ["variable.set", {"name": "yi1", "expr": "width - if(oR, 0 mm, tRight)"}],
  ["variable.set", {"name": "zi0", "expr": "if(oB, 0 mm, tBot)"}],
  ["variable.set", {"name": "zi1", "expr": "height - if(oT, 0 mm, tTop)"}],
  ["variable.set", {"name": "wi", "expr": "yi1 - yi0"}],
  ["variable.set", {"name": "hi", "expr": "zi1 - zi0"}],

  ["variable.set", {"name": "nB", "expr": "if(length - 2 * bhEnd > 50 mm, ceil((length - 2 * bhEnd) / bhSpacing) + 1, 1)"}],
  ["variable.set", {"name": "bhS", "expr": "if(nB > 1, (length - 2 * bhEnd) / (nB - 1), 0 mm)"}],
  ["variable.set", {"name": "xB0", "expr": "if(nB > 1, bhEnd, length / 2)"}],
  ["variable.set", {"name": "dT", "expr": "if(nB > 1, bhS / ceil(bhS / tabPitch), xB0 / ceil(xB0 / tabPitch))"}],
  ["variable.set", {"name": "xMinT", "expr": "max(wTL / 2 + clrTL + 2 * rdTL, wTR / 2 + clrTR + 2 * rdTR, wBL / 2 + clrBL + 2 * rdBL, wBR / 2 + clrBR + 2 * rdBR) + 2 mm"}],
  ["variable.set", {"name": "kE", "expr": "max(0, floor((xB0 - xMinT) / dT + 0.5))"}],
  ["variable.set", {"name": "mI", "expr": "if(nB > 1, round(bhS / dT), 0)"}],
  ["variable.set", {"name": "nT", "expr": "2 * kE + (nB - 1) * mI"}],
  ["variable.set", {"name": "x1T", "expr": "xB0 - (kE - 0.5) * dT"}],

  ["feature.block", {"name": "LeftPlate", "size": ["length", "tLeft", "zL1 - zL0"], "position": ["0 mm", "0 mm", "zL0"], "when": "!oL"}],
  ["feature.block", {"name": "RightPlate", "size": ["length", "tRight", "zR1 - zR0"], "position": ["0 mm", "width - tRight", "zR0"], "when": "!oR"}],
  ["feature.block", {"name": "TopPlate", "size": ["length", "yT1 - yT0", "tTop"], "position": ["0 mm", "yT0", "height - tTop"], "when": "!oT"}],
  ["feature.block", {"name": "BotPlate", "size": ["length", "yB1 - yB0", "tBot"], "position": ["0 mm", "yB0", "0 mm"], "when": "!oB"}],

  ["file.save", {"path": "jigs/welded-beam/source.3dcraft"}]
]
