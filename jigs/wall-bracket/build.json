["variable.publish", {"name": "load", "label": "Load per bracket", "description": "In kg, spread over the arm as a shelf spreads it. The most it allows (maxLoad) follows from the material, the arm and the screws", "group": "Load", "order": 1, "kind": "integer", "min": "1", "max": "maxLoad"}],
["variable.publish", {"name": "arm", "label": "Arm length", "description": "How far the bracket reaches from the wall (the shelf's depth)", "group": "Load", "order": 2, "min": "100 mm", "max": "400 mm", "step": "5 mm", "unit": "mm"}],
