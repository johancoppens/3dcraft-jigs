[
["table.set", {"name": "materials", "columns": ["material", "fy", "sf", {"name": "tMin", "unit": "mm"}, {"name": "tMax", "unit": "mm"}, "kind"], "rows": [["Steel S235", 235, 2, 3, 6, 1], ["Stainless 1.4301", 210, 2, 2, 5, 2], ["Aluminium 6060-T66", 150, 2, 3, 8, 3], ["Aluminium 6082-T6", 240, 2, 3, 8, 3], ["PLA, 3D printed", 50, 4, 4, 10, 4], ["PETG, 3D printed", 45, 4, 4, 10, 5]]}],
["table.set", {"name": "screws", "columns": ["screw", {"name": "d", "unit": "mm"}, {"name": "dk", "unit": "mm"}, "pull"], "rows": [["4 mm", 4.5, 8, 200], ["5 mm", 5.5, 10, 300], ["6 mm", 6.6, 12, 400]]}],
["variable.set", {"name": "load", "expr": "20"}],
["variable.set", {"name": "arm", "expr": "200 mm"}],
["variable.set", {"name": "material", "expr": "5"}],
["variable.set", {"name": "screw", "expr": "2"}],
["variable.set", {"name": "shelfHoles", "expr": "1"}],
["variable.set", {"name": "fy", "expr": "materials[material].fy"}],
["variable.set", {"name": "sf", "expr": "materials[material].sf"}],
["variable.set", {"name": "kind", "expr": "materials[material].kind"}],
["variable.set", {"name": "tMin", "expr": "materials[material].tMin"}],
["variable.set", {"name": "tMax", "expr": "materials[material].tMax"}],
["variable.set", {"name": "lever", "expr": "arm / 2"}],
["variable.set", {"name": "M", "expr": "load * 9.81 * lever / (1 mm)"}],
["variable.set", {"name": "Zreq", "expr": "sf * M / fy"}],
["variable.set", {"name": "k", "expr": "15"}],
["variable.set", {"name": "tIdeal", "expr": "pow(6 * Zreq / k^2, 1 / 3) * 1 mm"}],
["variable.set", {"name": "tArm", "expr": "6 * Zreq / (arm / 1 mm)^2 * 1 mm"}],
["variable.set", {"name": "t", "expr": "clamp(ceil(max(tIdeal, tArm), 0.5 mm), tMin, tMax)"}],
["variable.set", {"name": "Dmin", "expr": "max(0.3 * arm, 3 * t + 15 mm)"}],
["variable.set", {"name": "Dmax", "expr": "min(k * t, arm)"}],
["variable.set", {"name": "Dreq", "expr": "sqrt(6 * Zreq / (t / 1 mm)) * 1 mm"}],
["variable.set", {"name": "D", "expr": "clamp(ceil(Dreq, 0.5 mm), Dmin, max(Dmin, Dmax))"}],
["variable.set", {"name": "sigma", "expr": "6 * M / ((t / 1 mm) * (D / 1 mm)^2)"}],
["variable.set", {"name": "utilisation", "expr": "sigma * sf / fy"}],
["variable.set", {"name": "ri", "expr": "t"}],
["variable.set", {"name": "hole", "expr": "screws[screw].d"}],
["variable.set", {"name": "head", "expr": "min(screws[screw].dk, hole + 2 * (t - 0.8 mm))"}],
["variable.set", {"name": "pitch", "expr": "screws[screw].dk / 2 + 5 mm"}],
["variable.set", {"name": "tail", "expr": "2 * pitch"}],
["variable.set", {"name": "top", "expr": "D + tail"}],
["variable.set", {"name": "b", "expr": "max(clamp(0.2 * arm, 30 mm, 60 mm), t + 2 * screws[screw].dk + 6 mm)"}],
["variable.set", {"name": "cope", "expr": "t / 2 + 2 mm"}],
["variable.set", {"name": "gLen", "expr": "0.88 * arm - t"}],
["variable.set", {"name": "tip", "expr": "min(4 mm, t)"}],
["variable.set", {"name": "rc", "expr": "min(b / 3, 10 mm)"}],
["variable.set", {"name": "yh", "expr": "(b / 2 + t / 2) / 2"}],
["variable.set", {"name": "zUp", "expr": "top - t - ri - screws[screw].dk / 2 - 4 mm"}],
["variable.set", {"name": "pull", "expr": "screws[screw].pull"}],
["variable.set", {"name": "screwPull", "expr": "M / (zUp / 1 mm) / 2"}],
["variable.set", {"name": "zUpReq", "expr": "M / (2 * pull) * 1 mm"}],
["variable.set", {"name": "Dcap", "expr": "min(k * tMax, arm)"}],
["variable.set", {"name": "bendCap", "expr": "fy * (tMax / 1 mm) * (Dcap / 1 mm)^2 / (6 * sf * 9.81 * lever / (1 mm))"}],
["variable.set", {"name": "zLow", "expr": "max(0.3 * arm, 3 * tMax + 15 mm) + tail - 2 * tMax - screws[screw].dk / 2 - 4 mm"}],
["variable.set", {"name": "screwCap", "expr": "2 * pull * (zLow / 1 mm) / (9.81 * lever / (1 mm))"}],
["variable.set", {"name": "maxLoad", "expr": "min(150, floor(min(bendCap, screwCap)))"}],
["sketch.create", {"name": "Plate", "plane": "zx"}],
["sketch.point", {"sketch": "Plate", "at": ["0 mm", "0 mm"]}],
["sketch.point", {"sketch": "Plate", "at": ["0 mm", "t"]}],
["sketch.point", {"sketch": "Plate", "at": ["top - t - ri", "t"]}],
["sketch.point", {"sketch": "Plate", "at": ["top - t - ri", "t + ri"]}],
["sketch.point", {"sketch": "Plate", "at": ["top - t", "t + ri"]}],
["sketch.point", {"sketch": "Plate", "at": ["top - t", "arm"]}],
["sketch.point", {"sketch": "Plate", "at": ["top", "arm"]}],
["sketch.point", {"sketch": "Plate", "at": ["top", "t + ri"]}],
["sketch.point", {"sketch": "Plate", "at": ["top - t - ri", "0 mm"]}],
["sketch.line", {"sketch": "Plate", "from": "e1", "to": "e2"}],
["sketch.line", {"sketch": "Plate", "from": "e2", "to": "e3"}],
["sketch.arc", {"sketch": "Plate", "center": "e4", "start": "e3", "end": "e5"}],
["sketch.line", {"sketch": "Plate", "from": "e5", "to": "e6"}],
["sketch.line", {"sketch": "Plate", "from": "e6", "to": "e7"}],
["sketch.line", {"sketch": "Plate", "from": "e7", "to": "e8"}],
["sketch.arc", {"sketch": "Plate", "center": "e4", "start": "e9", "end": "e8"}],
["sketch.line", {"sketch": "Plate", "from": "e9", "to": "e1"}],
["feature.extrude", {"sketch": "Plate", "distance": "b", "symmetric": true, "name": "BentPlate"}],
["feature.fillet", {"name": "PlateCorners", "radius": "rc", "edges": [["F2:side(e14)", "F2:startCap(e10,e11,e12,e13,e14,e15,e16,e17)"], ["F2:side(e14)", "F2:endCap(e10,e11,e12,e13,e14,e15,e16,e17)"], ["F2:side(e10)", "F2:startCap(e10,e11,e12,e13,e14,e15,e16,e17)"], ["F2:side(e10)", "F2:endCap(e10,e11,e12,e13,e14,e15,e16,e17)"]]}],
["sketch.create", {"name": "GussetOutline", "plane": "zx"}],
["sketch.point", {"sketch": "GussetOutline", "at": ["top - t - ri - cope", "t"]}],
["sketch.point", {"sketch": "GussetOutline", "at": ["top - t", "t + ri + cope"]}],
["sketch.point", {"sketch": "GussetOutline", "at": ["top - t", "t + gLen"]}],
["sketch.point", {"sketch": "GussetOutline", "at": ["top - t - tip", "t + gLen"]}],
["sketch.point", {"sketch": "GussetOutline", "at": ["top - D", "t + tip"]}],
["sketch.point", {"sketch": "GussetOutline", "at": ["top - D", "t"]}],
["sketch.line", {"sketch": "GussetOutline", "from": "e1", "to": "e2"}],
["sketch.line", {"sketch": "GussetOutline", "from": "e2", "to": "e3"}],
["sketch.line", {"sketch": "GussetOutline", "from": "e3", "to": "e4"}],
["sketch.line", {"sketch": "GussetOutline", "from": "e4", "to": "e5"}],
["sketch.line", {"sketch": "GussetOutline", "from": "e5", "to": "e6"}],
["sketch.line", {"sketch": "GussetOutline", "from": "e6", "to": "e1"}],
["feature.extrude", {"sketch": "GussetOutline", "distance": "t", "symmetric": true, "name": "Gusset"}],
["feature.boolean", {"op": "union", "target": "PlateCorners", "tool": "Gusset", "name": "Welded"}],
["feature.cylinder", {"name": "WallScrewLBore", "radius": "hole / 2", "height": "t + 2 mm", "position": ["-1 mm", "-yh", "zUp"], "axis": [1, 0, 0]}],
["feature.cone", {"name": "WallScrewLSink", "radius": "head / 2 + 1 mm", "height": "head / 2 + 1 mm", "position": ["t + 1 mm", "-yh", "zUp"], "axis": [-1, 0, 0]}],
["feature.boolean", {"op": "union", "target": "WallScrewLBore", "tool": "WallScrewLSink", "name": "WallScrewL"}],
["feature.cylinder", {"name": "WallScrewRBore", "radius": "hole / 2", "height": "t + 2 mm", "position": ["-1 mm", "yh", "zUp"], "axis": [1, 0, 0]}],
["feature.cone", {"name": "WallScrewRSink", "radius": "head / 2 + 1 mm", "height": "head / 2 + 1 mm", "position": ["t + 1 mm", "yh", "zUp"], "axis": [-1, 0, 0]}],
["feature.boolean", {"op": "union", "target": "WallScrewRBore", "tool": "WallScrewRSink", "name": "WallScrewR"}],
["feature.cylinder", {"name": "WallScrewLowBore", "radius": "hole / 2", "height": "t + 2 mm", "position": ["-1 mm", "0 mm", "pitch"], "axis": [1, 0, 0]}],
["feature.cone", {"name": "WallScrewLowSink", "radius": "head / 2 + 1 mm", "height": "head / 2 + 1 mm", "position": ["t + 1 mm", "0 mm", "pitch"], "axis": [-1, 0, 0]}],
["feature.boolean", {"op": "union", "target": "WallScrewLowBore", "tool": "WallScrewLowSink", "name": "WallScrewLow"}],
["feature.boolean", {"op": "union", "target": "WallScrewL", "tool": "WallScrewR", "name": "WallScrewsUp"}],
["feature.boolean", {"op": "union", "target": "WallScrewsUp", "tool": "WallScrewLow", "name": "WallScrews"}],
["feature.boolean", {"op": "subtract", "target": "Welded", "tool": "WallScrews", "name": "WallDrilled"}],
["feature.cylinder", {"name": "ShelfHole", "radius": "hole / 2", "height": "t + 2 mm", "position": ["0.6 * arm", "-yh", "top - t - 1 mm"]}],
["feature.pattern", {"name": "ShelfHoles", "source": "ShelfHole", "count": "2", "step": ["0 mm", "2 * yh", "0 mm"]}],
["feature.when", {"feature": "ShelfHole", "expr": "shelfHoles"}],
["feature.when", {"feature": "ShelfHoles", "expr": "shelfHoles"}],
["feature.boolean", {"op": "subtract", "target": "WallDrilled", "tool": "ShelfHoles", "name": "Drilled"}],
["feature.transform", {"source": "Drilled", "angle": "90 deg", "axis": [0, 0, 1], "name": "Bracket"}],
