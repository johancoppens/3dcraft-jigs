["variable.publish", {"name": "screw", "label": "Screws", "description": "Countersunk wood or chipboard screws with wall plugs; 3 in the wall, 2 into the shelf", "group": "Screws", "order": 1, "kind": "choice", "choicesFrom": "screws"}],
["variable.publish", {"name": "shelfHoles", "label": "Shelf screw holes", "description": "Two holes in the arm to screw the shelf on from below", "group": "Screws", "order": 2, "kind": "boolean"}],
["document.info", {"title": "Wall bracket sized by its load", "description": "A shelf or console bracket whose plate thickness and gusset depth are worked out from the load: set the load per bracket in kg, the arm length, the material (steel, stainless, aluminium or a 3D print) and the screws. The bending moment at the wall sets the section (t x D^2 / 6 against the material's yield strength and safety factor); the upper screws are placed high enough for their pull. The load's range stops at what the material, the arm and the screws can carry, and two assertions check the built bracket against the load. Read t, D, sigma and utilisation in the variables. Export STL or 3MF to print, STEP for a metal shop.", "author": "Johan Coppens", "licence": "CC-BY-4.0", "url": "https://github.com/johancoppens/3dcraft-jigs/tree/main/jigs/wall-bracket", "tags": ["bracket", "shelf", "wall", "formula", "3D printing", "sheet metal"]}],
["jig.export", {"path": "dist/wall-bracket.3dcraftjig"}]
]
