[
["table.set", {"name": "modules", "columns": ["size", {"name": "value", "unit": "mm"}], "rows": [["0.5 mm", 0.5], ["0.8 mm", 0.8], ["1 mm", 1], ["1.25 mm", 1.25], ["1.5 mm", 1.5], ["2 mm", 2], ["2.5 mm", 2.5], ["3 mm", 3]]}],
["table.set", {"name": "angles", "columns": ["angle", {"name": "value", "unit": "deg"}], "rows": [["14.5 deg", 14.5], ["20 deg", 20], ["25 deg", 25]]}],
["variable.set", {"name": "moduleSize", "expr": "4"}],
["variable.set", {"name": "teeth", "expr": "20"}],
["variable.set", {"name": "pressure", "expr": "2"}],
["variable.set", {"name": "width", "expr": "6 mm"}],
["variable.set", {"name": "bore", "expr": "4 mm"}],
["variable.set", {"name": "hub", "expr": "1"}],
["variable.set", {"name": "hubD", "expr": "12 mm"}],
["variable.set", {"name": "hubL", "expr": "6 mm"}],
["variable.set", {"name": "module", "expr": "modules[moduleSize].value"}],
["variable.set", {"name": "alpha", "expr": "angles[pressure].value"}],
["variable.set", {"name": "pd", "expr": "module * teeth"}],
["variable.set", {"name": "rp", "expr": "pd / 2"}],
["variable.set", {"name": "rb", "expr": "rp * cos(alpha)"}],
["variable.set", {"name": "ra", "expr": "rp + module"}],
["variable.set", {"name": "rf", "expr": "rp - 1.25 * module"}],
["variable.set", {"name": "g", "expr": "-pi / (2 * teeth) - (tan(alpha) - alpha / 1 rad)"}],
["variable.set", {"name": "rs", "expr": "max(rb, rf + 0.1 * module)"}],
["variable.set", {"name": "t0", "expr": "sqrt((rs / rb)^2 - 1)"}],
["variable.set", {"name": "ta", "expr": "sqrt((ra / rb)^2 - 1)"}],
["variable.set", {"name": "phis", "expr": "g + t0 - atan(t0) / 1 rad"}],
["variable.set", {"name": "half", "expr": "pi / teeth"}],
["variable.set", {"name": "thetaA", "expr": "g + ta - atan(ta) / 1 rad"}],
["sketch.create", {"name": "Outline"}],
["sketch.point", {"sketch": "Outline", "at": ["rf * cos(phis * 1 rad)", "rf * sin(phis * 1 rad)"]}],
["sketch.curve", {"sketch": "Outline", "x": "rb * (cos(g + t) + t * sin(g + t))", "y": "rb * (sin(g + t) - t * cos(g + t))", "t": ["t0", "ta"]}],
["sketch.curve", {"sketch": "Outline", "x": "rb * (cos(g + t) + t * sin(g + t))", "y": "-rb * (sin(g + t) - t * cos(g + t))", "t": ["t0", "ta"]}],
["sketch.curve", {"sketch": "Outline", "x": "ra * cos(t)", "y": "ra * sin(t)", "t": ["thetaA", "-thetaA"], "start": "e3", "end": "e6"}],
["sketch.curve", {"sketch": "Outline", "x": "rf * cos(t)", "y": "rf * sin(t)", "t": ["-phis", "2 * half + phis"]}],
["sketch.line", {"sketch": "Outline", "from": "e1", "to": "e2"}],
["sketch.line", {"sketch": "Outline", "from": "e5", "to": "e9"}],
["sketch.pattern", {"sketch": "Outline", "entities": ["e12", "e4", "e8", "e7", "e13", "e11"], "chain": ["e1", "e10"], "angle": "360 deg / teeth", "center": ["0 mm", "0 mm"], "count": "teeth"}],
["feature.extrude", {"sketch": "Outline", "distance": "width", "name": "Rim"}],
["variable.set", {"name": "hubE", "expr": "clamp(hubD, bore + 0.8 mm, max(bore + 0.8 mm, min(1.2 * rf, 2 * rf - 4 * module)))"}],
["feature.cylinder", {"name": "Hub", "radius": "hubE / 2", "height": "hubL", "position": ["0 mm", "0 mm", "width"]}],
["feature.when", {"feature": "Hub", "expr": "hub"}],
["feature.boolean", {"op": "union", "target": "Rim", "tool": "Hub", "name": "WithHub"}],
["feature.cylinder", {"name": "BoreTool", "radius": "bore / 2", "height": "width + hubL + 2 mm", "position": ["0 mm", "0 mm", "-1 mm"]}],
["feature.boolean", {"op": "subtract", "target": "WithHub", "tool": "BoreTool", "name": "Gear"}],
["variable.set", {"name": "u", "expr": "-g"}],
["variable.set", {"name": "iA", "expr": "u * ta^2 / 2 - ta^3 / 3 + ((ta^2 + 1) * atan(ta) / 1 rad - ta) / 2"}],
["variable.set", {"name": "i0", "expr": "u * t0^2 / 2 - t0^3 / 3 + ((t0^2 + 1) * atan(t0) / 1 rad - t0) / 2"}],
["variable.set", {"name": "toothArea", "expr": "(u - (t0 - atan(t0) / 1 rad)) * (rs^2 - rf^2) + 2 * rb^2 * (iA - i0)"}],
["assert.add", {"name": "volume", "measure": "volume", "of": "Gear", "eq": "(pi * rf^2 + teeth * toothArea) * width + if(hub, pi * (hubE / 2)^2 * hubL, 0 * (1 mm)^3) - pi * (bore / 2)^2 * (width + if(hub, hubL, 0 mm))"}],
["assert.add", {"name": "one body", "measure": "count", "of": {"kind": "body"}, "eq": "1"}],
["body.appearance", {"body": "Gear", "color": "#e0a93e", "roughness": 0.5}],
["variable.publish", {"name": "moduleSize", "label": "Module", "description": "Tooth size: pitch diameter / teeth. Gears that mesh have the same module and pressure angle", "group": "Teeth", "order": 1, "kind": "choice", "choicesFrom": "modules"}],
["variable.publish", {"name": "teeth", "label": "Teeth", "description": "Number of teeth; the pitch diameter is module x teeth", "group": "Teeth", "order": 2, "kind": "integer", "min": "8", "max": "80"}],
["variable.publish", {"name": "pressure", "label": "Pressure angle", "description": "20 deg is the common standard; 14.5 deg older gears, 25 deg stronger teeth", "group": "Teeth", "order": 3, "kind": "choice", "choicesFrom": "angles"}],
["variable.publish", {"name": "width", "label": "Face width", "description": "Thickness of the gear", "group": "Teeth", "order": 4, "min": "2 mm", "max": "30 mm", "step": "0.5 mm", "unit": "mm"}],
["variable.publish", {"name": "bore", "label": "Bore", "description": "Diameter of the shaft hole; at most half the root diameter (and the root diameter less three modules)", "group": "Bore and hub", "order": 1, "min": "1 mm", "max": "min(rf, 2 * rf - 3 * module)", "step": "0.1 mm", "unit": "mm"}],
["variable.publish", {"name": "hub", "label": "Hub", "description": "A hub on one side, for a set screw or a press fit on the shaft", "group": "Bore and hub", "order": 2, "kind": "boolean"}],
["variable.publish", {"name": "hubD", "label": "Hub diameter", "description": "Outside diameter of the hub; kept at least 0.8 mm over the bore and at most 0.6 times the root diameter (and the root diameter less four modules)", "group": "Bore and hub", "order": 3, "min": "bore + 2 mm", "max": "bore + 40 mm", "step": "0.5 mm", "unit": "mm"}],
["variable.publish", {"name": "hubL", "label": "Hub length", "description": "How far the hub stands out", "group": "Bore and hub", "order": 4, "min": "2 mm", "max": "20 mm", "step": "0.5 mm", "unit": "mm"}],
["document.info", {"title": "Involute spur gear", "description": "A spur gear with true involute teeth, drawn from the involute's formula: choose the module and the pressure angle, set the number of teeth, the face width and the bore, with or without a hub. Pitch diameter = module x teeth, outside diameter = module x (teeth + 2); two gears mesh when they share module and pressure angle, at a centre distance of module x (teeth1 + teeth2) / 2. Export it with File > Export... (STL or 3MF to print, STEP for CAD).", "author": "3DCraft Jigs", "licence": "CC-BY-4.0", "url": "https://github.com/johancoppens/3dcraft-jigs/tree/main/jigs/spur-gear", "tags": ["gear", "involute", "3D printing", "mechanism"]}],
["jig.export", {"path": "dist/spur-gear.3dcraftjig"}]
]
