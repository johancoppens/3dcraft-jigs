[
["table.set", {"name": "modules", "columns": ["size", {"name": "value", "unit": "mm"}], "rows": [["0.5 mm", 0.5], ["0.8 mm", 0.8], ["1 mm", 1], ["1.25 mm", 1.25], ["1.5 mm", 1.5], ["2 mm", 2], ["2.5 mm", 2.5], ["3 mm", 3]]}],
["table.set", {"name": "angles", "columns": ["angle", {"name": "value", "unit": "deg"}], "rows": [["14.5 deg", 14.5], ["20 deg", 20], ["25 deg", 25]]}],
["table.set", {"name": "keys", "columns": ["shaft", {"name": "b", "unit": "mm"}, {"name": "t2", "unit": "mm"}], "rows": [["up to 8 mm", 2, 1.0], ["8 to 10 mm", 3, 1.4], ["10 to 12 mm", 4, 1.8], ["12 to 17 mm", 5, 2.3], ["17 to 22 mm", 6, 2.8], ["22 to 30 mm", 8, 3.3], ["30 to 38 mm", 10, 3.3]]}],
["table.set", {"name": "screws", "columns": ["screw", {"name": "tap", "unit": "mm"}, {"name": "clear", "unit": "mm"}, {"name": "nutAF", "unit": "mm"}, {"name": "nutM", "unit": "mm"}], "rows": [["M2.5", 2.1, 2.8, 5.0, 2.0], ["M3", 2.5, 3.3, 5.5, 2.4], ["M4", 3.3, 4.4, 7.0, 3.2]]}],
["variable.set", {"name": "moduleSize", "expr": "4"}],
["variable.set", {"name": "teeth", "expr": "30"}],
["variable.set", {"name": "pressure", "expr": "2"}],
["variable.set", {"name": "width", "expr": "6 mm"}],
["variable.set", {"name": "bore", "expr": "5 mm"}],
["variable.set", {"name": "hub", "expr": "1"}],
["variable.set", {"name": "hubD", "expr": "14 mm"}],
["variable.set", {"name": "hubL", "expr": "6 mm"}],
["variable.set", {"name": "disc", "expr": "4"}],
["variable.set", {"name": "boreType", "expr": "1"}],
["variable.set", {"name": "flatDepth", "expr": "0.5 mm"}],
["variable.set", {"name": "setScrew", "expr": "1"}],
["variable.set", {"name": "screwSize", "expr": "2"}],
["variable.set", {"name": "screwCount", "expr": "1"}],
["variable.set", {"name": "nut", "expr": "0"}],
["variable.set", {"name": "module", "expr": "modules[moduleSize].value"}],
["variable.set", {"name": "alpha", "expr": "angles[pressure].value"}],
["variable.set", {"name": "pd", "expr": "module * teeth"}],
["variable.set", {"name": "rp", "expr": "pd / 2"}],
["variable.set", {"name": "rb", "expr": "rp * cos(alpha)"}],
["variable.set", {"name": "ra", "expr": "rp + module"}],
["variable.set", {"name": "rf", "expr": "rp - 1.25 * module"}],
["variable.set", {"name": "g", "expr": "-pi / (2 * teeth) - (tan(alpha) - alpha / 1 rad)"}],
["variable.set", {"name": "rs", "expr": "max(rb, rf + 0.1 * module)"}],
["variable.set", {"name": "t0", "expr": "sqrt((rs / rb)^2 - 1)"}],
["variable.set", {"name": "ta", "expr": "sqrt((ra / rb)^2 - 1)"}],
["variable.set", {"name": "phis", "expr": "g + t0 - atan(t0) / 1 rad"}],
["variable.set", {"name": "half", "expr": "pi / teeth"}],
["variable.set", {"name": "thetaA", "expr": "g + ta - atan(ta) / 1 rad"}],
["variable.set", {"name": "hubE", "expr": "clamp(hubD, bore + 0.8 mm, max(bore + 0.8 mm, min(1.2 * rf, 2 * rf - 4 * module)))"}],
["variable.set", {"name": "hubC", "expr": "min(0.5 mm, (hubE - bore) / 6, hubL / 4)"}],
["variable.set", {"name": "hubOD", "expr": "hubE"}],
["variable.set", {"name": "keyRow", "expr": "1 + (bore > 8 mm) + (bore > 10 mm) + (bore > 12 mm) + (bore > 17 mm) + (bore > 22 mm) + (bore > 30 mm)"}],
["variable.set", {"name": "keyW", "expr": "keys[keyRow].b"}],
["variable.set", {"name": "keyT", "expr": "keys[keyRow].t2"}],
["variable.set", {"name": "flatOn", "expr": "boreType == 2"}],
["variable.set", {"name": "keyOn", "expr": "boreType == 3 && bore >= 2 * keyW && bore / 2 + keyT <= rf - 0.8 mm && (!hub || bore / 2 + keyT <= hubOD / 2 - 0.8 mm)"}],
["variable.set", {"name": "nutW", "expr": "screws[screwSize].nutAF + 0.3 mm"}],
["variable.set", {"name": "nutT", "expr": "screws[screwSize].nutM + 0.3 mm"}],
["variable.set", {"name": "nutIn", "expr": "bore / 2 + 1.2 mm + if(keyOn, keyT, 0 mm)"}],
["variable.set", {"name": "scrOn", "expr": "setScrew && hub && hubOD / 2 - bore / 2 >= 1.5 mm"}],
["variable.set", {"name": "scr2On", "expr": "scrOn && screwCount == 2"}],
["variable.set", {"name": "nutOn", "expr": "scrOn && nut && hubOD / 2 >= nutIn + nutT + 1 mm"}],
["variable.set", {"name": "scrD", "expr": "if(nutOn, screws[screwSize].clear, screws[screwSize].tap)"}],
["variable.set", {"name": "rimR", "expr": "rf - max(1.5 mm, 2 * module)"}],
["variable.set", {"name": "bossR", "expr": "max(bore / 2 + max(2 mm, module) + if(keyOn, keyT, 0 mm), if(hub, hubE / 2, 0 mm))"}],
["variable.set", {"name": "room", "expr": "rimR - bossR"}],
["variable.set", {"name": "webT", "expr": "max(1.5 mm, width / 3)"}],
["variable.set", {"name": "webD", "expr": "(width - webT) / 2"}],
["variable.set", {"name": "webOn", "expr": "(disc == 2 || disc == 4) && room >= 3 mm && webD >= 0.5 mm"}],
["variable.set", {"name": "rc", "expr": "(rimR + bossR) / 2"}],
["variable.set", {"name": "nh", "expr": "clamp(floor(pi * rc / (0.35 * room + 1.5 mm)), 4, 8)"}],
["variable.set", {"name": "rh", "expr": "min(0.35 * room, rc * sin(180 deg / nh) - 1 mm)"}],
["variable.set", {"name": "holesOn", "expr": "(disc == 3 || disc == 4) && rh >= 1 mm"}],
["sketch.create", {"name": "Outline"}],
["sketch.point", {"sketch": "Outline", "at": ["rf * cos(phis * 1 rad)", "rf * sin(phis * 1 rad)"]}],
["sketch.curve", {"sketch": "Outline", "x": "rb * (cos(g + t) + t * sin(g + t))", "y": "rb * (sin(g + t) - t * cos(g + t))", "t": ["t0", "ta"]}],
["sketch.curve", {"sketch": "Outline", "x": "rb * (cos(g + t) + t * sin(g + t))", "y": "-rb * (sin(g + t) - t * cos(g + t))", "t": ["t0", "ta"]}],
["sketch.curve", {"sketch": "Outline", "x": "ra * cos(t)", "y": "ra * sin(t)", "t": ["thetaA", "-thetaA"], "start": "e3", "end": "e6"}],
["sketch.curve", {"sketch": "Outline", "x": "rf * cos(t)", "y": "rf * sin(t)", "t": ["-phis", "2 * half + phis"]}],
["sketch.line", {"sketch": "Outline", "from": "e1", "to": "e2"}],
["sketch.line", {"sketch": "Outline", "from": "e5", "to": "e9"}],
["sketch.pattern", {"sketch": "Outline", "entities": ["e12", "e4", "e8", "e7", "e13", "e11"], "chain": ["e1", "e10"], "angle": "360 deg / teeth", "center": ["0 mm", "0 mm"], "count": "teeth"}],
["feature.extrude", {"sketch": "Outline", "distance": "width", "name": "Rim"}],
["feature.cylinder", {"name": "Hub", "radius": "hubE / 2", "height": "hubL", "position": ["0 mm", "0 mm", "width"]}],
["feature.chamfer", {"name": "HubC", "distance": "hubC", "edges": [["F3:face(0)", "F3:face(2)"]]}],
["feature.when", {"feature": "Hub", "expr": "hub"}],
["feature.when", {"feature": "HubC", "expr": "hub"}],
["feature.boolean", {"op": "union", "target": "Rim", "tool": "HubC", "name": "WithHub"}],
["feature.cylinder", {"name": "WebOuter", "radius": "rimR", "height": "webD + 1 mm", "position": ["0 mm", "0 mm", "-1 mm"]}],
["feature.cylinder", {"name": "WebInner", "radius": "bossR", "height": "webD + 3 mm", "position": ["0 mm", "0 mm", "-2 mm"]}],
["feature.boolean", {"op": "subtract", "target": "WebOuter", "tool": "WebInner", "name": "Web1"}],
["feature.mirror", {"source": "Web1", "normal": [0, 0, 1], "point": ["0 mm", "0 mm", "width / 2"], "keep": true, "name": "Web2"}],
["feature.when", {"feature": "WebOuter", "expr": "webOn"}],
["feature.when", {"feature": "WebInner", "expr": "webOn"}],
["feature.when", {"feature": "Web1", "expr": "webOn"}],
["feature.when", {"feature": "Web2", "expr": "webOn"}],
["feature.boolean", {"op": "subtract", "target": "WithHub", "tool": "Web1", "name": "Webbed1"}],
["feature.boolean", {"op": "subtract", "target": "Webbed1", "tool": "Web2", "name": "Webbed"}],
["feature.cylinder", {"name": "Hole", "radius": "rh", "height": "width + 2 mm", "position": ["rc * cos(180 deg / nh)", "rc * sin(180 deg / nh)", "-1 mm"]}],
["feature.pattern", {"name": "Holes", "source": "Hole", "count": "nh", "angle": "360 deg / nh", "axis": [0, 0, 1]}],
["feature.when", {"feature": "Hole", "expr": "holesOn"}],
["feature.when", {"feature": "Holes", "expr": "holesOn"}],
["feature.boolean", {"op": "subtract", "target": "Webbed", "tool": "Holes", "name": "Disc"}],
["feature.cylinder", {"name": "BoreTool", "radius": "bore / 2", "height": "width + hubL + 2 mm", "position": ["0 mm", "0 mm", "-1 mm"]}],
["feature.block", {"name": "FlatTool", "size": ["bore", "2 * bore", "width + hubL + 2 mm + 2 mm"], "position": ["bore / 2 - flatDepth", "-bore", "-1 mm - 1 mm"]}],
["feature.when", {"feature": "FlatTool", "expr": "flatOn"}],
["feature.boolean", {"op": "subtract", "target": "BoreTool", "tool": "FlatTool", "name": "BoreD"}],
["feature.block", {"name": "KeyTool", "size": ["bore / 2 + keyT", "keyW", "width + hubL + 2 mm - 1 mm"], "position": ["0 mm", "-keyW / 2", "-1 mm + 0.5 mm"]}],
["feature.when", {"feature": "KeyTool", "expr": "keyOn"}],
["feature.boolean", {"op": "union", "target": "BoreD", "tool": "KeyTool", "name": "BoreK"}],
["feature.cylinder", {"name": "ScrewHole", "radius": "scrD / 2", "height": "hubOD / 2 + 1 mm", "position": ["0 mm", "0 mm", "width + hubL / 2"], "axis": [1, 0, 0]}],
["feature.block", {"name": "NutSlot", "size": ["nutT", "nutW", "hubL / 2 + nutW / sqrt(3) + 1 mm"], "position": ["nutIn", "-nutW / 2", "width + hubL / 2 - nutW / sqrt(3)"]}],
["feature.when", {"feature": "NutSlot", "expr": "nutOn"}],
["feature.boolean", {"op": "union", "target": "ScrewHole", "tool": "NutSlot", "name": "Screw1"}],
["feature.when", {"feature": "ScrewHole", "expr": "scrOn"}],
["feature.when", {"feature": "Screw1", "expr": "scrOn"}],
["feature.transform", {"source": "Screw1", "angle": "90 deg", "axis": [0, 0, 1], "keep": true, "name": "Screw2"}],
["feature.when", {"feature": "Screw2", "expr": "scr2On"}],
["feature.boolean", {"op": "union", "target": "BoreK", "tool": "Screw1", "name": "CutA"}],
["feature.boolean", {"op": "union", "target": "CutA", "tool": "Screw2", "name": "Cut"}],
["feature.boolean", {"op": "subtract", "target": "Disc", "tool": "Cut", "name": "Gear"}],
["variable.set", {"name": "u", "expr": "-g"}],
["variable.set", {"name": "iA", "expr": "u * ta^2 / 2 - ta^3 / 3 + ((ta^2 + 1) * atan(ta) / 1 rad - ta) / 2"}],
["variable.set", {"name": "i0", "expr": "u * t0^2 / 2 - t0^3 / 3 + ((t0^2 + 1) * atan(t0) / 1 rad - t0) / 2"}],
["variable.set", {"name": "toothArea", "expr": "(u - (t0 - atan(t0) / 1 rad)) * (rs^2 - rf^2) + 2 * rb^2 * (iA - i0)"}],
["variable.set", {"name": "br", "expr": "bore / 2"}],
["variable.set", {"name": "flatA", "expr": "br^2 * acos((br - flatDepth) / br) / 1 rad - (br - flatDepth) * sqrt(br^2 - (br - flatDepth)^2)"}],
["variable.set", {"name": "keyA", "expr": "if(keyOn, keyW * (br + keyT) - (keyW / 2 * sqrt(br^2 - keyW^2 / 4) + br^2 * asin(keyW / (2 * br)) / 1 rad), 0 * (1 mm)^2)"}],
["variable.set", {"name": "boreA", "expr": "pi * br^2 - if(flatOn, flatA, 0 * (1 mm)^2) + if(keyOn, keyA, 0 * (1 mm)^2)"}],
["variable.set", {"name": "nutV", "expr": "if(nutOn, nutT * nutW * (hubL / 2 + nutW / sqrt(3)) - pi * (scrD / 2)^2 * nutT, 0 * (1 mm)^3)"}],
["variable.set", {"name": "screw1V", "expr": "pi * (scrD / 2)^2 * (hubE / 2 - br + if(flatOn, flatDepth, 0 mm) - if(keyOn, keyT, 0 mm)) + nutV"}],
["variable.set", {"name": "screw2V", "expr": "if(scr2On, pi * (scrD / 2)^2 * (hubE / 2 - br) + nutV, 0 * (1 mm)^3)"}],
["variable.set", {"name": "screwV", "expr": "if(scrOn, screw1V + screw2V, 0 * (1 mm)^3)"}],
["variable.set", {"name": "gearV", "expr": "(pi * rf^2 + teeth * toothArea) * width + if(hub, pi * (hubE / 2)^2 * hubL - pi * hubC^2 * (hubE / 2 - hubC / 3), 0 * (1 mm)^3) - boreA * (width + if(hub, hubL, 0 mm)) - if(webOn, 2 * pi * (rimR^2 - bossR^2) * webD, 0 * (1 mm)^3) - if(holesOn, nh * pi * rh^2 * if(webOn, webT, width), 0 * (1 mm)^3) - screwV"}],
["assert.add", {"name": "volume", "measure": "volume", "of": "Gear", "eq": "gearV", "tol": "1e-6 * gearV + 0.2 * screwV"}],
["assert.add", {"name": "one body", "measure": "count", "of": {"kind": "body"}, "eq": "1"}],
["body.appearance", {"body": "Gear", "color": "#D4A24C", "roughness": 0.45}],
["variable.publish", {"name": "moduleSize", "label": "Module", "group": "Teeth", "order": 1, "kind": "choice", "choicesFrom": "modules", "description": "Tooth size: pitch diameter / teeth. Gears that mesh have the same module and pressure angle"}],
["variable.publish", {"name": "teeth", "label": "Teeth", "group": "Teeth", "order": 2, "kind": "integer", "min": "8", "max": "80", "description": "Number of teeth; the pitch diameter is module x teeth"}],
["variable.publish", {"name": "pressure", "label": "Pressure angle", "group": "Teeth", "order": 3, "kind": "choice", "choicesFrom": "angles", "description": "20 deg is the common standard; 14.5 deg older gears, 25 deg stronger teeth"}],
["variable.publish", {"name": "width", "label": "Face width", "group": "Teeth", "order": 4, "min": "2 mm", "max": "30 mm", "step": "0.5 mm", "unit": "mm", "description": "Thickness of the gear"}],
["variable.publish", {"name": "bore", "label": "Bore", "group": "Bore and hub", "order": 1, "min": "1 mm", "max": "min(rf, 2 * rf - 3 * module)", "step": "0.1 mm", "unit": "mm", "description": "Diameter of the shaft hole; at most half the root diameter (and the root diameter less three modules)"}],
["variable.publish", {"name": "hub", "label": "Hub", "group": "Bore and hub", "order": 4, "kind": "boolean", "description": "A hub on one side, which holds the set screws (or a press fit on the shaft)"}],
["variable.publish", {"name": "hubD", "label": "Hub diameter", "group": "Bore and hub", "order": 5, "min": "max(bore + 2 mm, max(bore + 4 mm + if(boreType == 3, 2 * keyT, 0 mm), if(setScrew && nut, 2 * (nutIn + nutT + 1 mm), 0 mm)))", "max": "bore + 40 mm", "step": "0.5 mm", "unit": "mm", "description": "Outside diameter of the hub; kept at least 0.8 mm over the bore and at most 0.6 times the root diameter (and the root diameter less four modules)"}],
["variable.publish", {"name": "hubL", "label": "Hub length", "group": "Bore and hub", "order": 6, "min": "if(setScrew, if(nut, 2 * (nutW / sqrt(3) + 1 mm), max(2 mm, scrD + 2 mm)), 2 mm)", "max": "20 mm", "step": "0.5 mm", "unit": "mm", "description": "How far the hub stands out; long enough for the screw or the nut slot"}],
["variable.publish", {"name": "disc", "label": "Disc", "group": "Disc", "order": 1, "kind": "choice", "choices": ["Solid", "Web", "Holes", "Web and holes"], "description": "Lighten a large gear: a web (the disc recessed from both faces to a third of the width, at least 1.5 mm) and/or a ring of 4 to 8 holes between the hub and the rim. Only built when the gear has room for it"}],
["variable.publish", {"name": "boreType", "label": "Bore type", "group": "Bore and hub", "order": 2, "kind": "choice", "choices": ["Round", "D-shaft", "Keyway"], "description": "Round; D-shaft (a flat that a set screw presses on); or a keyway to DIN 6885 sized from the bore (from 4 mm, when the part has room for it)"}],
["variable.publish", {"name": "flatDepth", "label": "D-flat depth", "group": "Bore and hub", "order": 3, "min": "0.2 mm", "max": "max(0.2 mm, bore / 4)", "step": "0.05 mm", "unit": "mm", "description": "How deep the flat of a D-shaft is (5 mm motor shafts: 0.5 mm, 4.5 mm across the flat)"}],
["variable.publish", {"name": "setScrew", "label": "Set screw", "group": "Set screw", "order": 1, "kind": "boolean", "description": "A grub screw through the hub onto the shaft (on the flat or the key)"}],
["variable.publish", {"name": "screwSize", "label": "Screw size", "group": "Set screw", "order": 2, "kind": "choice", "choicesFrom": "screws", "description": "The hole is the tap size (the screw cuts its own thread), or the clearance size with a nut"}],
["variable.publish", {"name": "screwCount", "label": "Screws", "group": "Set screw", "order": 3, "kind": "integer", "min": "1", "max": "2", "description": "One screw, or two at 90 deg"}],
["variable.publish", {"name": "nut", "label": "Captive nut", "group": "Set screw", "order": 4, "kind": "boolean", "description": "A slot for a hex nut behind each screw, open at the end of the hub: push the nut in, then drive the screw through it"}],
["document.info", {"title": "Involute spur gear", "description": "A spur gear with true involute teeth, drawn from the involute's formula: choose the module and the pressure angle, set the number of teeth, the face width and the bore (round, D-shaft or keyway), with or without a hub with one or two set screws (M2.5, M3 or M4, optionally in captive nuts), and lighten a large gear with a web and holes. Pitch diameter = module x teeth, outside diameter = module x (teeth + 2); two gears mesh when they share module and pressure angle, at a centre distance of module x (teeth1 + teeth2) / 2. Export it with File > Export... (STL or 3MF to print, STEP for CAD).", "author": "3DCraft Jigs", "licence": "CC-BY-4.0", "url": "https://github.com/johancoppens/3dcraft-jigs/tree/main/jigs/spur-gear", "tags": ["gear", "involute", "3D printing", "mechanism"]}],
["jig.export", {"path": "dist/spur-gear.3dcraftjig"}]
]
