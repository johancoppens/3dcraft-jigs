[
["variable.set", {"name": "innerD", "expr": "60 mm"}],
["variable.set", {"name": "height", "expr": "70 mm"}],
["variable.set", {"name": "wall", "expr": "2 mm"}],
["variable.set", {"name": "pitch", "expr": "4 mm"}],
["variable.set", {"name": "turns", "expr": "2"}],
["variable.set", {"name": "clearance", "expr": "0.3 mm"}],
["variable.set", {"name": "ribs", "expr": "1"}],
["variable.set", {"name": "Ri", "expr": "innerD / 2"}],
["variable.set", {"name": "Rn", "expr": "Ri + wall"}],
["variable.set", {"name": "td", "expr": "0.28 * pitch"}],
["variable.set", {"name": "b", "expr": "0.7 * pitch"}],
["variable.set", {"name": "bl", "expr": "pitch - b + 2 * td - 2 * clearance * (sqrt(2) - 1)"}],
["variable.set", {"name": "lw", "expr": "wall"}],
["variable.set", {"name": "Rl", "expr": "Rn + td + clearance"}],
["variable.set", {"name": "Rb", "expr": "Rl + lw"}],
["variable.set", {"name": "Rbi", "expr": "Rb - wall"}],
["variable.set", {"name": "Hn", "expr": "turns * pitch + b + 2 mm"}],
["variable.set", {"name": "Hs", "expr": "height - Hn"}],
["variable.set", {"name": "zi", "expr": "Hs - wall"}],
["variable.set", {"name": "zb", "expr": "zi - (Rbi - Ri)"}],
["variable.set", {"name": "floorZ", "expr": "wall + 0.5 mm"}],
["variable.set", {"name": "zj", "expr": "Hs + 1 mm"}],
["variable.set", {"name": "zl", "expr": "zj + b / 2 + pitch / 2"}],
["variable.set", {"name": "lt", "expr": "wall + 0.5 mm"}],
["variable.set", {"name": "lidZ", "expr": "height + clearance"}],
["variable.set", {"name": "ch", "expr": "0.6 mm"}],
["variable.set", {"name": "e", "expr": "0.15 mm"}],
["variable.set", {"name": "nRibs", "expr": "round(2 * pi * Rb / 3 mm)"}],
["sketch.create", {"name": "JarProfile", "plane": "zx"}],
["sketch.polyline", {"sketch": "JarProfile", "closed": true, "points": [["0 mm", "0 mm"], ["0 mm", "Rb - ch"], ["ch", "Rb"], ["Hs", "Rb"], ["Hs", "Rn"], ["height - ch", "Rn"], ["height", "Rn - ch"], ["height", "Ri"], ["zi", "Ri"], ["zb", "Rbi"], ["floorZ", "Rbi"], ["floorZ", "0 mm"]]}],
["feature.revolve", {"sketch": "JarProfile", "axis": "x", "name": "JarBody"}],
["datum.helix", {"name": "JarHelix", "axis": "z", "start": ["Rn", "0 mm", "zj"], "pitch": "pitch", "turns": "turns"}],
["sketch.create", {"name": "JarThreadProfile", "plane": "zx"}],
["sketch.polyline", {"sketch": "JarThreadProfile", "closed": true, "points": [["zj - e", "Rn - e"], ["zj + td", "Rn + td"], ["zj + b - td", "Rn + td"], ["zj + b + e", "Rn - e"]]}],
["feature.sweep", {"sketch": "JarThreadProfile", "path": "JarHelix", "join": "JarBody", "name": "Jar"}],
["body.appearance", {"body": "Jar", "color": "#E8DFCC", "roughness": 0.5}],
["sketch.create", {"name": "LidProfile", "plane": "zx"}],
["sketch.polyline", {"sketch": "LidProfile", "closed": true, "points": [["Hs + 0.5 mm", "Rl"], ["Hs + 0.5 mm", "Rb - ch"], ["Hs + 0.5 mm + ch", "Rb"], ["lidZ + lt - 1 mm", "Rb"], ["lidZ + lt", "Rb - 1 mm"], ["lidZ + lt", "0 mm"], ["lidZ", "0 mm"], ["lidZ", "Rl"]]}],
["feature.revolve", {"sketch": "LidProfile", "axis": "x", "name": "LidBody"}],
["datum.helix", {"name": "LidHelix", "axis": "z", "start": ["Rl", "0 mm", "zl - bl / 2"], "pitch": "pitch", "turns": "turns - 1"}],
["sketch.create", {"name": "LidThreadProfile", "plane": "zx"}],
["sketch.polyline", {"sketch": "LidThreadProfile", "closed": true, "points": [["zl - bl / 2 - e", "Rl + e"], ["zl + bl / 2 + e", "Rl + e"], ["zl + bl / 2 - td", "Rl - td"], ["zl - bl / 2 + td", "Rl - td"]]}],
["feature.sweep", {"sketch": "LidThreadProfile", "path": "LidHelix", "join": "LidBody", "name": "LidThreaded"}],
["feature.cylinder", {"name": "Rib", "radius": "0.7 mm", "height": "lidZ + lt - 1.5 mm - Hs", "position": ["Rb", "0 mm", "Hs"]}],
["feature.pattern", {"name": "Ribs", "source": "Rib", "count": "nRibs", "angle": "360 deg / nRibs", "axis": [0, 0, 1]}],
["feature.boolean", {"op": "subtract", "target": "LidThreaded", "tool": "Ribs", "name": "LidGrip"}],
["feature.when", {"feature": "Rib", "expr": "ribs"}],
["feature.when", {"feature": "Ribs", "expr": "ribs"}],
["feature.transform", {"source": "LidGrip", "name": "Lid", "angle": "180 deg", "axis": [1, 0, 0], "pivot": ["0 mm", "0 mm", "(lidZ + lt) / 2"], "translate": ["2 * Rb + 10 mm", "0 mm", "0 mm"]}],
["body.appearance", {"body": "Lid", "color": "#8A5A7A", "roughness": 0.5}],
["assert.add", {"name": "jar and lid", "measure": "count", "of": {"kind": "body"}, "eq": "2"}],
["variable.publish", {"name": "innerD", "label": "Opening", "description": "Inside diameter of the neck: what goes in", "group": "Jar", "order": 1, "min": "20 mm", "max": "120 mm", "step": "1 mm", "unit": "mm"}],
["variable.publish", {"name": "height", "label": "Height", "description": "Height of the jar without its lid", "group": "Jar", "order": 2, "min": "(turns + 1) * pitch + 3 * wall + clearance + 8 mm", "max": "200 mm", "step": "1 mm", "unit": "mm"}],
["variable.publish", {"name": "wall", "label": "Wall", "description": "Wall thickness of the jar and the lid", "group": "Jar", "order": 3, "min": "1.2 mm", "max": "4 mm", "step": "0.1 mm", "unit": "mm"}],
["variable.publish", {"name": "pitch", "label": "Thread pitch", "description": "How far the lid moves per turn", "group": "Thread", "order": 1, "min": "2.5 mm", "max": "8 mm", "step": "0.5 mm", "unit": "mm"}],
["variable.publish", {"name": "turns", "label": "Turns", "description": "Turns of the jar's thread; the lid's has one turn less", "group": "Thread", "order": 2, "min": "1.5", "max": "3", "step": "0.25"}],
["variable.publish", {"name": "clearance", "label": "Clearance", "description": "Gap between the threads (printer tuning): 0.3 mm suits most printers", "group": "Thread", "order": 3, "min": "0.15 mm", "max": "0.6 mm", "step": "0.05 mm", "unit": "mm"}],
["variable.publish", {"name": "ribs", "label": "Grip ribs", "description": "Grooves round the lid for grip", "group": "Lid", "order": 1, "kind": "boolean"}],
["document.info", {"title": "Screw jar", "description": "A jar with a screw-on lid and a real thread: set the opening, the height and the wall, the thread's pitch, turns and clearance; the lid follows the jar. Optional grip ribs round the lid. The lid lies upside down beside the jar, both print without supports. Export it with File > Export... (STL or 3MF).", "author": "Johan Coppens", "licence": "CC-BY-4.0", "url": "https://github.com/johancoppens/3dcraft-jigs/tree/main/jigs/screw-jar", "tags": ["jar", "thread", "container", "lid", "3D printing"]}],
["jig.export", {"path": "dist/screw-jar.3dcraftjig"}]
]
