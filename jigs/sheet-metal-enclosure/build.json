["variable.publish", {"name": "fit", "label": "Lid clearance", "description": "Gap between the lid's skirts and walls and the base", "group": "Fit", "order": 2, "min": "0.2 mm", "max": "1 mm", "step": "0.1 mm", "unit": "mm"}],
