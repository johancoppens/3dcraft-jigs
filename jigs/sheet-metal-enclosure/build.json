["assert.add", {"name": "Lid walls clear the base lips", "measure": "distance", "from": {"kind": "face", "where": [{"madeBy": "Lid"}, {"any": [{"name": "*copy(1)/*face(6)"}, {"name": "*copy(1)/*face(8)"}]}]}, "to": {"kind": "face", "where": [{"madeBy": "Base"}, {"any": [{"name": "*copy(1)/*face(6)"}, {"name": "*copy(1)/*face(8)"}]}]}, "eq": "fit", "tol": "0.01 mm"}],
["assert.add", {"name": "Nothing overlaps", "measure": "overlap", "is": false}],
["assert.add", {"name": "Screws centred in the lid's holes", "measure": "clearance", "from": "Screws", "to": "Lid", "eq": "(dc - d) / 2", "tol": "0.01 mm"}],
["assert.add", {"name": "Screws centred in the base's holes", "measure": "clearance", "from": "Screws", "to": "Base", "eq": "(dc - d) / 2", "tol": "0.01 mm"}],
["assert.add", {"name": "Four holes in the return flanges", "measure": "count", "of": {"kind": "face", "where": [{"madeBy": "Base"}, {"surface": "cylinder"}, {"axis": {"along": "z"}}, {"radius": {"eq": "dc / 2", "tol": "0.001 mm"}}, {"any": [{"inside": [["(xs) - (dc)", "(ys) - (dc)", "zl - t - 1 mm"], ["(xs) + (dc)", "(ys) + (dc)", "zl + 1 mm"]]}, {"inside": [["(xs) - (dc)", "(-ys) - (dc)", "zl - t - 1 mm"], ["(xs) + (dc)", "(-ys) + (dc)", "zl + 1 mm"]]}, {"inside": [["(-xs) - (dc)", "(ys) - (dc)", "zl - t - 1 mm"], ["(-xs) + (dc)", "(ys) + (dc)", "zl + 1 mm"]]}, {"inside": [["(-xs) - (dc)", "(-ys) - (dc)", "zl - t - 1 mm"], ["(-xs) + (dc)", "(-ys) + (dc)", "zl + 1 mm"]]}]}]}, "eq": "4"}],
["assert.add", {"name": "Feet holes in the floor when asked", "measure": "count", "of": {"kind": "face", "where": [{"madeBy": "Base"}, {"surface": "cylinder"}, {"axis": {"along": "z"}}, {"radius": {"eq": "dc / 2", "tol": "0.001 mm"}}, {"any": [{"inside": [["(footX) - (dc)", "(footY) - (dc)", "-1 mm"], ["(footX) + (dc)", "(footY) + (dc)", "t + 1 mm"]]}, {"inside": [["(footX) - (dc)", "(-footY) - (dc)", "-1 mm"], ["(footX) + (dc)", "(-footY) + (dc)", "t + 1 mm"]]}, {"inside": [["(-footX) - (dc)", "(footY) - (dc)", "-1 mm"], ["(-footX) + (dc)", "(footY) + (dc)", "t + 1 mm"]]}, {"inside": [["(-footX) - (dc)", "(-footY) - (dc)", "-1 mm"], ["(-footX) + (dc)", "(-footY) + (dc)", "t + 1 mm"]]}]}]}, "eq": "if(feet == 1, 4, 0)"}],
["assert.add", {"name": "Lid rests on the return flanges", "measure": "distance", "from": {"kind": "face", "where": [{"madeBy": "Lid"}, {"name": "*copy(1)/*face(0)"}]}, "to": {"kind": "face", "where": [{"madeBy": "Base"}, {"any": [{"name": "*copy(1)/*face(10)"}, {"name": "*copy(1)/*face(12)"}]}]}, "eq": "0 mm", "tol": "0.01 mm"}],
["variable.publish", {"name": "Wi", "label": "Inside width", "description": "Between the base's side walls", "group": "Size", "order": 1, "min": "100 mm", "max": "400 mm", "step": "1 mm", "unit": "mm"}],
["variable.publish", {"name": "Di", "label": "Inside depth", "description": "Between the base's front and back lips (at least room for the screws at the front and the back, with 2 mm between their heads)", "group": "Size", "order": 2, "min": "max(80 mm, 2 * (R + relief + max(8 mm, holeEdge + dc)) + headD + 2 mm)", "max": "300 mm", "step": "1 mm", "unit": "mm"}],
["variable.publish", {"name": "Hi", "label": "Inside height", "description": "From the floor to the underside of the lid", "group": "Size", "order": 3, "min": "30 mm", "max": "200 mm", "step": "1 mm", "unit": "mm"}],
["variable.publish", {"name": "material", "label": "Material", "description": "Sets the minimum bend radius, the K-factor and the die (minimum flange)", "group": "Sheet", "order": 1, "kind": "choice", "choicesFrom": "mats"}],
["variable.publish", {"name": "t", "label": "Thickness", "description": "Sheet thickness", "group": "Sheet", "order": 2, "min": "0.8 mm", "max": "2 mm", "step": "0.1 mm", "unit": "mm"}],
