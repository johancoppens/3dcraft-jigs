["feature.when", {"feature": "FeetHoles", "expr": "feet == 1"}],
["feature.sheetMetal", {"sketch": "BaseSketch", "name": "Base", "thickness": "t", "radius": "R", "kFactor": "K", "relief": {"shape": "reliefShape", "size": "relief"}, "bendRelief": {"shape": "if(reliefShape == 3, 2, reliefShape)", "size": "relief"}, "corner": {"kind": "corner", "gap": "gap"}, "corners": [{"flanges": [0, 2], "kind": "corner", "over": 0}, {"flanges": [0, 3], "kind": "corner", "over": 0}, {"flanges": [1, 2], "kind": "corner", "over": 1}, {"flanges": [1, 3], "kind": "corner", "over": 1}], "cutouts": ["FeetHoles"], "flanges": [{"edge": "e6", "length": "wallL", "angle": "90 deg"}, {"edge": "e8", "length": "wallL", "angle": "90 deg"}, {"edge": "e5", "length": "lipL", "angle": "90 deg"}, {"edge": "e7", "length": "lipL", "angle": "90 deg"}, {"tip": 0, "outline": "ReturnRight", "angle": "90 deg"}, {"tip": 1, "outline": "ReturnLeft", "angle": "90 deg"}]}],
["sketch.create", {"plane": "xy", "offset": "zl", "name": "LidSketch"}],
["sketch.rect", {"sketch": "LidSketch", "from": ["-al", "-bl"], "to": ["al", "bl"]}],
