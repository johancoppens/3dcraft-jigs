["variable.publish", {"name": "corner", "label": "Corners", "description": "How the walls meet at the corners: open (each flange ends at its bend), butt, overlap (the base's walls cover the lips' ends, the lid's front and back walls the skirts') or miter", "group": "Corners", "order": 1, "kind": "choice", "choices": ["Open", "Butt", "Overlap", "Miter"]}],
["variable.publish", {"name": "gap", "label": "Corner gap", "description": "The gap left at a closed corner: at least 0.4 mm (0.015 in, SendCutSend's least gap between flanges), a butt's less than the thickness", "group": "Corners", "order": 2, "min": "0.4 mm", "max": "if(corner == 2, min(2 mm, t - 0.1 mm), 2 mm)", "step": "0.1 mm", "unit": "mm"}],
