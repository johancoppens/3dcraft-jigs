[
["table.set", {"name": "mats", "columns": ["material", "minR", "k", "v", "red", "green", "blue"], "rows": [["Steel DC01", 1.0, 0.42, 8, 125, 133, 140], ["Aluminium 5754", 1.0, 0.38, 6, 185, 190, 196], ["Stainless 304", 2.0, 0.45, 10, 200, 206, 214]]}],
["table.set", {"name": "screws", "columns": ["screw", {"name": "d", "unit": "mm"}, {"name": "clear", "unit": "mm"}, {"name": "head", "unit": "mm"}, {"name": "k", "unit": "mm"}], "rows": [["M3", 3.0, 3.4, 5.6, 1.8], ["M4", 4.0, 4.5, 8.0, 2.4]]}],
["variable.set", {"name": "Wi", "expr": "160 mm"}],
["variable.set", {"name": "Di", "expr": "120 mm"}],
["variable.set", {"name": "Hi", "expr": "50 mm"}],
["variable.set", {"name": "material", "expr": "1"}],
