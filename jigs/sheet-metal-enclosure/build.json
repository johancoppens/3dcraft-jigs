["variable.set", {"name": "wallL", "expr": "Hi - t - 2 * R"}],
["variable.set", {"name": "lipL", "expr": "max(10 mm, minFlange - R - t + 1 mm)"}],
["variable.set", {"name": "retL", "expr": "max(minFlange - R - t + 1 mm, 2 * holeEdge + dc + 1 mm)"}],
["variable.set", {"name": "zl", "expr": "Hi + t"}],
