["variable.publish", {"name": "feet", "label": "Feet holes", "description": "Four holes in the floor's corners, for feet or standoffs", "group": "Options", "order": 2, "kind": "boolean"}],
["document.info", {"title": "Sheet-metal enclosure", "description": "A two-part sheet-metal case for electronics, each part laser cut and bent on a press brake from one sheet: a base (floor, side walls with return flanges, front and back lips) and a lid (top, side skirts, front and back walls) screwed onto the return flanges. Set the inside size, the material (steel DC01, aluminium 5754, stainless 304) and thickness, the bend radius, M3 or M4 screws, vent slots and feet holes, how the corners are closed (open, butt, overlap or miter, and the gap) and the corner reliefs' shape; the bend radius, flange lengths, hole distances, corner reliefs and gaps, the lid's fit and the screws' alignment are checked against the material's table. Every hole is in the flat patterns, with the bend lines: file.export with sheetMetal (see README).", "author": "3DCraft Jigs", "licence": "CC-BY-4.0", "url": "https://github.com/johancoppens/3dcraft-jigs/tree/main/jigs/sheet-metal-enclosure", "tags": ["sheet metal", "enclosure", "electronics", "press brake", "laser cutting", "flat pattern"]}],
["jig.export", {"path": "dist/sheet-metal-enclosure.3dcraftjig"}]
]
