[
["assembly.new", {"units": "mm"}],
["file.save", {"path": "dist/strandbeest-leg.3dcraftasm"}],
["variable.set", {"name": "Ja", "expr": "38.0"}],
["variable.set", {"name": "Jb", "expr": "41.5"}],
["variable.set", {"name": "Jc", "expr": "39.3"}],
["variable.set", {"name": "Jd", "expr": "40.1"}],
["variable.set", {"name": "Je", "expr": "55.8"}],
["variable.set", {"name": "Jf", "expr": "39.4"}],
["variable.set", {"name": "Jg", "expr": "36.7"}],
["variable.set", {"name": "Jh", "expr": "65.7"}],
["variable.set", {"name": "Ji", "expr": "49.0"}],
["variable.set", {"name": "Jj", "expr": "50.0"}],
["variable.set", {"name": "Jk", "expr": "61.9"}],
["variable.set", {"name": "Jl", "expr": "7.8"}],
["variable.set", {"name": "Jm", "expr": "15.0"}],
["variable.set", {"name": "crank", "expr": "15 mm"}],
["variable.set", {"name": "u", "expr": "crank / Jm"}],
["variable.set", {"name": "La", "expr": "Ja * u"}],
["variable.set", {"name": "Lb", "expr": "Jb * u"}],
["variable.set", {"name": "Lc", "expr": "Jc * u"}],
["variable.set", {"name": "Ld", "expr": "Jd * u"}],
["variable.set", {"name": "Le", "expr": "Je * u"}],
["variable.set", {"name": "Lf", "expr": "Jf * u"}],
["variable.set", {"name": "Lg", "expr": "Jg * u"}],
["variable.set", {"name": "Lh", "expr": "Jh * u"}],
["variable.set", {"name": "Li", "expr": "Ji * u"}],
["variable.set", {"name": "Lj", "expr": "Jj * u"}],
["variable.set", {"name": "Lk", "expr": "Jk * u"}],
["variable.set", {"name": "Ll", "expr": "Jl * u"}],
["variable.set", {"name": "Lm", "expr": "Jm * u"}],
["variable.set", {"name": "thick", "expr": "3 mm"}],
["variable.set", {"name": "pitch", "expr": "thick + 1 mm"}],
["variable.set", {"name": "stub", "expr": "10 mm"}],
["variable.set", {"name": "theta0", "expr": "0 deg"}],
["variable.set", {"name": "t", "expr": "0"}],
["variable.set", {"name": "theta", "expr": "theta0 + 360 deg * t"}],
["instance.add", {"source": "build/strandbeest/leg.3dcraftasm", "name": "Leg", "mode": "flexible", "position": [0, 0.0, 0]}],
["instance.add", {"source": "build/strandbeest/pin.3dcraft", "name": "DriveShaft", "params": {"len": "20 mm"}, "position": [0, 30.0, 0], "rotation": [90, 0, 0]}],
["mate.add", {"kind": "revolute", "name": "Drive", "a": "world/y", "b": "DriveShaft/F1:edge(0)", "offset": "0 mm + stub + 20 mm", "angle": "180 deg"}],
["variable.set", {"name": "Drive_angle", "expr": "-theta"}],
["mate.add", {"kind": "fixed", "name": "Coupled", "a": "Leg/PinO/F1:edge(0)", "b": "DriveShaft/F1:edge(1)", "flip": true}],
["variable.set", {"name": "f1Ax", "expr": "Lm * cos((theta + 0 deg))"}],
["variable.set", {"name": "f1Ay", "expr": "Lm * sin((theta + 0 deg))"}],
["variable.set", {"name": "f1Cdd", "expr": "sqrt((-La - f1Ax)^2 + (-Ll - f1Ay)^2)"}],
["variable.set", {"name": "f1Cal", "expr": "(Lj^2 - Lb^2 + f1Cdd^2) / (2 * f1Cdd)"}],
["variable.set", {"name": "f1Cq", "expr": "1 - (f1Cal / Lj)^2"}],
["variable.set", {"name": "f1Cx", "expr": "f1Ax + (f1Cal * (-La - f1Ax) + Lj * sqrt(max(f1Cq, 0)) * (-Ll - f1Ay)) / f1Cdd"}],
["variable.set", {"name": "f1Cy", "expr": "f1Ay + (f1Cal * (-Ll - f1Ay) - Lj * sqrt(max(f1Cq, 0)) * (-La - f1Ax)) / f1Cdd"}],
["variable.set", {"name": "f1Ddd", "expr": "sqrt((f1Cx - -La)^2 + (f1Cy - -Ll)^2)"}],
["variable.set", {"name": "f1Dal", "expr": "(Ld^2 - Le^2 + f1Ddd^2) / (2 * f1Ddd)"}],
["variable.set", {"name": "f1Dq", "expr": "1 - (f1Dal / Ld)^2"}],
["variable.set", {"name": "f1Dx", "expr": "-La + (f1Dal * (f1Cx - -La) - Ld * sqrt(max(f1Dq, 0)) * (f1Cy - -Ll)) / f1Ddd"}],
["variable.set", {"name": "f1Dy", "expr": "-Ll + (f1Dal * (f1Cy - -Ll) + Ld * sqrt(max(f1Dq, 0)) * (f1Cx - -La)) / f1Ddd"}],
["variable.set", {"name": "f1Edd", "expr": "sqrt((-La - f1Ax)^2 + (-Ll - f1Ay)^2)"}],
["variable.set", {"name": "f1Eal", "expr": "(Lk^2 - Lc^2 + f1Edd^2) / (2 * f1Edd)"}],
["variable.set", {"name": "f1Eq", "expr": "1 - (f1Eal / Lk)^2"}],
["variable.set", {"name": "f1Ex", "expr": "f1Ax + (f1Eal * (-La - f1Ax) - Lk * sqrt(max(f1Eq, 0)) * (-Ll - f1Ay)) / f1Edd"}],
["variable.set", {"name": "f1Ey", "expr": "f1Ay + (f1Eal * (-Ll - f1Ay) + Lk * sqrt(max(f1Eq, 0)) * (-La - f1Ax)) / f1Edd"}],
["variable.set", {"name": "f1Fdd", "expr": "sqrt((f1Ex - f1Dx)^2 + (f1Ey - f1Dy)^2)"}],
["variable.set", {"name": "f1Fal", "expr": "(Lf^2 - Lg^2 + f1Fdd^2) / (2 * f1Fdd)"}],
["variable.set", {"name": "f1Fq", "expr": "1 - (f1Fal / Lf)^2"}],
["variable.set", {"name": "f1Fx", "expr": "f1Dx + (f1Fal * (f1Ex - f1Dx) + Lf * sqrt(max(f1Fq, 0)) * (f1Ey - f1Dy)) / f1Fdd"}],
["variable.set", {"name": "f1Fy", "expr": "f1Dy + (f1Fal * (f1Ey - f1Dy) - Lf * sqrt(max(f1Fq, 0)) * (f1Ex - f1Dx)) / f1Fdd"}],
["variable.set", {"name": "f1Gdd", "expr": "sqrt((f1Ex - f1Fx)^2 + (f1Ey - f1Fy)^2)"}],
["variable.set", {"name": "f1Gal", "expr": "(Lh^2 - Li^2 + f1Gdd^2) / (2 * f1Gdd)"}],
["variable.set", {"name": "f1Gq", "expr": "1 - (f1Gal / Lh)^2"}],
["variable.set", {"name": "f1Gx", "expr": "f1Fx + (f1Gal * (f1Ex - f1Fx) + Lh * sqrt(max(f1Gq, 0)) * (f1Ey - f1Fy)) / f1Gdd"}],
["variable.set", {"name": "f1Gy", "expr": "f1Fy + (f1Gal * (f1Ey - f1Fy) - Lh * sqrt(max(f1Gq, 0)) * (f1Ex - f1Fx)) / f1Gdd"}],
["variable.measure", {"name": "g1x", "measure": "sectionCentroid", "of": "Leg/PinG", "plane": "zx", "offset": "-19.5 mm", "axis": "x"}],
["variable.measure", {"name": "g1z", "measure": "sectionCentroid", "of": "Leg/PinG", "plane": "zx", "offset": "-19.5 mm", "axis": "z"}],
["assert.add", {"name": "Leg's foot is where the Jig's circle intersections put it", "measure": "value", "expr": "hypot(g1x - f1Gx, g1z - f1Gy)", "max": "0.001 mm"}],
["assert.add", {"name": "No part overlaps another", "measure": "overlap", "of": {"kind": "body"}, "is": false}],
["document.info", {"title": "Jansen linkage leg (assembly)", "description": "A Jansen linkage leg, after the mechanism of Theo Jansen's Strandbeests, built from one bar part and pins, its joints found by 3DCraft's assembly solver instead of the Jig's circle intersections; a drive shaft turns the crank over the timeline t, and the foot's path is checked against the Jig's.", "author": "3DCraft Jigs", "licence": "CC-BY-4.0", "tags": ["assembly", "linkage", "Jansen linkage", "Theo Jansen", "motion"]}],
["assembly.pack", {}],
["file.save", {"path": "dist/strandbeest-leg.3dcraftasm"}]
]
