["document.info", {"title": "Gridfinity bin", "description": "A storage bin for the Gridfinity system: set the width and depth in 42 mm grid units, the height in 7 mm units, the compartments, and switch the label ledge, the stacking lip and the magnet holes on or off. The base and the lip follow the Gridfinity profiles, so the bin fits any Gridfinity baseplate and stacks on other bins. Print it standing on its feet, without supports. Export it with File > Export... (STL or 3MF). Gridfinity is by Zack Freedman (MIT).", "author": "Johan Coppens", "licence": "CC-BY-4.0", "url": "https://github.com/johancoppens/3dcraft-jigs/tree/main/jigs/gridfinity-bin", "tags": ["Gridfinity", "storage", "bin", "organiser", "3D printing"]}],
