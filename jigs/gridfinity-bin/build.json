["assert.add", {"name": "feet: the bottom of the base profile in every unit (35.6 mm square, 0.8 mm corners, less the holes)", "measure": "area", "of": {"kind": "face", "where": {"in": "Bin", "normal": {"along": "-z"}, "below": {"z": "0.001 mm"}}}, "eq": "gx * gy * (1266.810619 - 4 * if(magnets, 33.183072, if(screws, 7.068583, 0))) * 1 mm^2", "tol": "0.01 * 1 mm^2"}],
