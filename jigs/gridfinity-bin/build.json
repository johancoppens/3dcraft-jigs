["assert.add", {"name": "wall front (back under a front label) is the wall thickness", "measure": "distance", "from": {"kind": "face", "where": {"in": "Bin", "any": [{"normal": {"along": "y"}}, {"normal": {"along": "-y"}}], "inside": [["-1000 mm", "if(label == 3, hy - 0.001 mm, -1000 mm)", "-1000 mm"], ["1000 mm", "if(label == 3, 1000 mm, -hy + 0.001 mm)", "1000 mm"]]}}, "to": {"kind": "face", "where": {"in": "Bin", "madeBy": "LipHollow", "surface": "plane", "any": [{"normal": {"along": "y"}}, {"normal": {"along": "-y"}}]}}, "eq": "wall"}],
["assert.add", {"name": "wall at least the thinnest printable (0.95 mm)", "measure": "count", "of": {"kind": "body", "where": {"name": "Bin"}}, "eq": "if(wall >= 0.95 mm, 1, 0)"}],
["assert.add", {"name": "dividers across: as many as asked", "measure": "count", "of": {"kind": "face", "where": {"in": "Bin", "madeBy": "DivX", "normal": {"along": "x"}}}, "eq": "divx"}],
["assert.add", {"name": "dividers across: equally spaced, inside the bin, below its top", "measure": "count", "of": {"kind": "face", "where": {"in": "Bin", "madeBy": "DivX", "normal": {"along": "x"}, "any": [{"inside": [["(-wi + 1 * (cw + divT)) - 0.01 mm", "-1000 mm", "floorZ - 1 mm"], ["(-wi + 1 * (cw + divT)) + 0.01 mm", "1000 mm", "divTop + 0.001 mm"]]}, {"inside": [["(-wi + 2 * (cw + divT)) - 0.01 mm", "-1000 mm", "floorZ - 1 mm"], ["(-wi + 2 * (cw + divT)) + 0.01 mm", "1000 mm", "divTop + 0.001 mm"]]}, {"inside": [["(-wi + 3 * (cw + divT)) - 0.01 mm", "-1000 mm", "floorZ - 1 mm"], ["(-wi + 3 * (cw + divT)) + 0.01 mm", "1000 mm", "divTop + 0.001 mm"]]}, {"inside": [["(-wi + 4 * (cw + divT)) - 0.01 mm", "-1000 mm", "floorZ - 1 mm"], ["(-wi + 4 * (cw + divT)) + 0.01 mm", "1000 mm", "divTop + 0.001 mm"]]}, {"inside": [["(-wi + 5 * (cw + divT)) - 0.01 mm", "-1000 mm", "floorZ - 1 mm"], ["(-wi + 5 * (cw + divT)) + 0.01 mm", "1000 mm", "divTop + 0.001 mm"]]}, {"inside": [["(-wi + 6 * (cw + divT)) - 0.01 mm", "-1000 mm", "floorZ - 1 mm"], ["(-wi + 6 * (cw + divT)) + 0.01 mm", "1000 mm", "divTop + 0.001 mm"]]}, {"inside": [["(-wi + 7 * (cw + divT)) - 0.01 mm", "-1000 mm", "floorZ - 1 mm"], ["(-wi + 7 * (cw + divT)) + 0.01 mm", "1000 mm", "divTop + 0.001 mm"]]}, {"inside": [["(-wi + 8 * (cw + divT)) - 0.01 mm", "-1000 mm", "floorZ - 1 mm"], ["(-wi + 8 * (cw + divT)) + 0.01 mm", "1000 mm", "divTop + 0.001 mm"]]}, {"inside": [["(-wi + 9 * (cw + divT)) - 0.01 mm", "-1000 mm", "floorZ - 1 mm"], ["(-wi + 9 * (cw + divT)) + 0.01 mm", "1000 mm", "divTop + 0.001 mm"]]}, {"inside": [["(-wi + 10 * (cw + divT)) - 0.01 mm", "-1000 mm", "floorZ - 1 mm"], ["(-wi + 10 * (cw + divT)) + 0.01 mm", "1000 mm", "divTop + 0.001 mm"]]}, {"inside": [["(-wi + 11 * (cw + divT)) - 0.01 mm", "-1000 mm", "floorZ - 1 mm"], ["(-wi + 11 * (cw + divT)) + 0.01 mm", "1000 mm", "divTop + 0.001 mm"]]}]}}, "eq": "divx"}],
["assert.add", {"name": "dividers front to back: as many as asked", "measure": "count", "of": {"kind": "face", "where": {"in": "Bin", "madeBy": "DivY", "normal": {"along": "-y"}}}, "eq": "divy"}],
["assert.add", {"name": "dividers front to back: equally spaced, inside the bin, below its top", "measure": "count", "of": {"kind": "face", "where": {"in": "Bin", "madeBy": "DivY", "normal": {"along": "-y"}, "any": [{"inside": [["-1000 mm", "(di - 1 * (rd + divT)) - 0.01 mm", "floorZ - 1 mm"], ["1000 mm", "(di - 1 * (rd + divT)) + 0.01 mm", "divTop + 0.001 mm"]]}, {"inside": [["-1000 mm", "(di - 2 * (rd + divT)) - 0.01 mm", "floorZ - 1 mm"], ["1000 mm", "(di - 2 * (rd + divT)) + 0.01 mm", "divTop + 0.001 mm"]]}, {"inside": [["-1000 mm", "(di - 3 * (rd + divT)) - 0.01 mm", "floorZ - 1 mm"], ["1000 mm", "(di - 3 * (rd + divT)) + 0.01 mm", "divTop + 0.001 mm"]]}, {"inside": [["-1000 mm", "(di - 4 * (rd + divT)) - 0.01 mm", "floorZ - 1 mm"], ["1000 mm", "(di - 4 * (rd + divT)) + 0.01 mm", "divTop + 0.001 mm"]]}, {"inside": [["-1000 mm", "(di - 5 * (rd + divT)) - 0.01 mm", "floorZ - 1 mm"], ["1000 mm", "(di - 5 * (rd + divT)) + 0.01 mm", "divTop + 0.001 mm"]]}, {"inside": [["-1000 mm", "(di - 6 * (rd + divT)) - 0.01 mm", "floorZ - 1 mm"], ["1000 mm", "(di - 6 * (rd + divT)) + 0.01 mm", "divTop + 0.001 mm"]]}]}}, "eq": "divy"}],
["assert.add", {"name": "label tabs: one per row", "measure": "count", "of": {"kind": "face", "where": {"in": "Bin", "madeBy": "Tab", "normal": {"along": "z"}}}, "eq": "if(labelOn, divy + 1, 0)"}],
["assert.add", {"name": "label tabs: supported down to where the angle asked puts them", "measure": "count", "of": {"kind": "face", "where": {"in": "Bin", "madeBy": "Tab", "surface": "plane", "normal": {"perpendicular": "x"}, "not": {"any": [{"normal": {"along": "y"}}, {"normal": {"along": "-y"}}, {"normal": {"along": "z"}}, {"normal": {"along": "-z"}}]}, "inside": [["-1000 mm", "-1000 mm", "tabLow - 0.001 mm"], ["1000 mm", "1000 mm", "tabTop - tabT + 0.001 mm"]]}}, "eq": "if(labelOn, divy + 1, 0)"}],
["assert.add", {"name": "label tabs: at least 5 mm deep", "measure": "count", "of": {"kind": "body", "where": {"name": "Bin"}}, "eq": "if(tabL >= 5 mm, 1, 0)"}],
["assert.add", {"name": "scoops: a quarter round in every compartment", "measure": "count", "of": {"kind": "face", "where": {"in": "Bin", "madeBy": "Scoop", "surface": "cylinder", "radius": "rs"}}, "eq": "if(scoopOn, divy + 1, 0)"}],
["assert.add", {"name": "stacking: a bin's foot enters nothing (dividers and tabs stay under it)", "measure": "overlap", "of": "Stacked foot", "to": "Bin", "is": false}],
["assert.add", {"name": "stacking: a bin's foot seats on the lip's chamfers", "measure": "clearance", "from": "Stacked foot", "to": "Bin", "eq": "if(lip, 0 mm, sqrt((10 mm)^2 + (2.95 mm - wall)^2))"}],
["variable.publish", {"name": "gx", "label": "Width", "description": "Width in grid units of 42 mm", "group": "Size", "order": 1, "kind": "integer", "min": "1", "max": "6"}],
["variable.publish", {"name": "gy", "label": "Depth", "description": "Depth in grid units of 42 mm", "group": "Size", "order": 2, "kind": "integer", "min": "1", "max": "6"}],
["variable.publish", {"name": "hu", "label": "Height", "description": "Height in units of 7 mm, base included, without the stacking lip (6 is 42 mm)", "group": "Size", "order": 3, "kind": "integer", "min": "2", "max": "15"}],
["variable.publish", {"name": "divx", "label": "Dividers across", "description": "Dividers parallel to the sides: compartments side by side", "group": "Compartments", "order": 1, "kind": "integer", "min": "0", "max": "2 * gx - 1"}],
["variable.publish", {"name": "divy", "label": "Dividers front to back", "description": "Dividers parallel to the front: rows of compartments", "group": "Compartments", "order": 2, "kind": "integer", "min": "0", "max": "gy"}],
["variable.publish", {"name": "label", "label": "Label tab", "description": "A sloping tab along the back or the front of every row, for a label and to grip the bin", "group": "Compartments", "order": 3, "kind": "choice", "choices": ["None", "Back", "Front"]}],
["variable.publish", {"name": "tabA", "label": "Label tab angle", "description": "Slope of the tab's support (36 deg is the standard's; steeper prints more easily but leaves a shorter tab in a low bin)", "group": "Compartments", "order": 4, "min": "30 deg", "max": "max(30 deg, min(60 deg, atan((hu * 7 mm - 9.8 mm - floorX) / 5 mm)))", "step": "1 deg", "unit": "deg"}],
["variable.publish", {"name": "scoop", "label": "Scoop", "description": "A rounded front inside every row, so small parts slide out (left out where a front label leaves less than 3 mm under it)", "group": "Compartments", "order": 5, "kind": "boolean"}],
["variable.publish", {"name": "magnets", "label": "Magnet holes", "description": "Holes for 6 x 2 mm magnets in the corners of every unit (6.5 x 2.4 mm)", "group": "Base", "order": 1, "kind": "boolean"}],
["variable.publish", {"name": "screws", "label": "Screw holes", "description": "M3 holes 6 mm deep in the corners of every unit (with the magnet holes: above them)", "group": "Base", "order": 2, "kind": "boolean"}],
["variable.publish", {"name": "lip", "label": "Stacking lip", "description": "The lip on top that the next bin stands in", "group": "Base", "order": 3, "kind": "boolean"}],
["variable.publish", {"name": "wall", "label": "Wall", "description": "Thickness of the outer walls (with the lip at most 1.8 mm, so the lip's 1.9 mm step stays inside the wall)", "group": "Walls", "order": 1, "min": "0.95 mm", "max": "if(lip, 1.8 mm, 2.5 mm)", "step": "0.05 mm", "unit": "mm"}],
["variable.publish", {"name": "floorX", "label": "Extra floor", "description": "Raises the floor inside above the 7 mm base, for a stiffer bottom or a shallower bin", "group": "Walls", "order": 2, "min": "0 mm", "max": "max(0 mm, min(10 mm, hu * 7 mm - 17 mm))", "step": "0.5 mm", "unit": "mm"}],
["document.info", {"title": "Gridfinity bin", "description": "A storage bin for the Gridfinity system: set the width and depth in 42 mm grid units, the height in 7 mm units, the dividers each way, a label tab at the back or front of every row (and its angle), a scoop for small parts, magnet and screw holes, the stacking lip, the wall and the floor. The base and the lip follow the Gridfinity profiles, so the bin fits every Gridfinity baseplate (and the Gridfinity baseplate Jig) and stacks on other bins. Print it standing on its feet, without supports. Export the body Bin with File > Export... (STL or 3MF). Gridfinity is by Zack Freedman (MIT).", "author": "3DCraft Jigs", "licence": "CC-BY-4.0", "url": "https://github.com/johancoppens/3dcraft-jigs/tree/main/jigs/gridfinity-bin", "tags": ["Gridfinity", "storage", "bin", "organiser", "3D printing"]}],
["jig.export", {"path": "dist/gridfinity-bin.3dcraftjig"}]
]
