["variable.set", {"name": "screws", "expr": "0"}],
["variable.set", {"name": "lip", "expr": "1"}],
["variable.set", {"name": "wall", "expr": "1.2 mm"}],
["variable.set", {"name": "floorX", "expr": "0 mm"}],
["variable.set", {"name": "grid", "expr": "42 mm"}],
["variable.set", {"name": "gap", "expr": "0.5 mm"}],
["variable.set", {"name": "R", "expr": "3.75 mm"}],
["variable.set", {"name": "hx", "expr": "(gx * grid - gap) / 2"}],
["variable.set", {"name": "hy", "expr": "(gy * grid - gap) / 2"}],
["variable.set", {"name": "H", "expr": "hu * 7 mm"}],
["variable.set", {"name": "baseH", "expr": "4.75 mm"}],
["variable.set", {"name": "floorZ", "expr": "7 mm + floorX"}],
["variable.set", {"name": "lipTop", "expr": "H + 4 mm"}],
["variable.set", {"name": "topZ", "expr": "if(lip, lipTop, H)"}],
["variable.set", {"name": "cx0", "expr": "-(gx - 1) * grid / 2"}],
["variable.set", {"name": "cy0", "expr": "-(gy - 1) * grid / 2"}],
["variable.set", {"name": "ri", "expr": "R - wall"}],
["variable.set", {"name": "wi", "expr": "hx - wall"}],
["variable.set", {"name": "di", "expr": "hy - wall"}],
["variable.set", {"name": "divT", "expr": "1.2 mm"}],
["variable.set", {"name": "cw", "expr": "(2 * wi - divx * divT) / (divx + 1)"}],
["variable.set", {"name": "rd", "expr": "(2 * di - divy * divT) / (divy + 1)"}],
["variable.set", {"name": "divTop", "expr": "H - 1 mm"}],
["variable.set", {"name": "tabTop", "expr": "H - 0.6 mm"}],
["variable.set", {"name": "tabT", "expr": "1.2 mm"}],
["variable.set", {"name": "rs0", "expr": "min(15 mm, rd / 2, (H - floorZ) / 2)"}],
["variable.set", {"name": "rsF", "expr": "if(scoop && label == 3, max(0 mm, min(rs0, tabTop - tabT - floorZ - 1 mm - 5 mm * tan(tabA))), 0 mm)"}],
["variable.set", {"name": "tabL", "expr": "min(15.85 mm, rd / 2, (tabTop - tabT - floorZ - 1 mm - rsF) / tan(tabA))"}],
["variable.set", {"name": "tabLow", "expr": "tabTop - tabT - tabL * tan(tabA)"}],
["variable.set", {"name": "labelOn", "expr": "label > 1"}],
["variable.set", {"name": "rs", "expr": "if(label == 3, min(rs0, tabLow - floorZ - 1 mm), rs0)"}],
["variable.set", {"name": "scoopOn", "expr": "scoop && rs >= 3 mm"}],
["variable.set", {"name": "lipLow", "expr": "H - 1.2 mm - (2.6 mm - wall)"}],
["variable.set", {"name": "holesOn", "expr": "magnets || screws"}],
["variable.set", {"name": "stackZ", "expr": "if(lip, H - 0.35 mm, H + 10 mm)"}],
