["document.info", {"title": "Welding table", "description": "A fixture welding table to cut from 1/4 in steel plate: a top plate with a 2 in grid of 16 mm holes on a grid of half-lapped ribs, joined by tabs in slots shaped for plug welds. Set the plate size (capped at 48 x 36 in so it stays quick, also in the browser), your cutter's kerf and the slot clearance. To cut it: File > Export..., choose DXF or SVG and the face set \"Cut sheet\" (file.export {\"path\": \"table.dxf\", \"set\": \"Cut sheet\"}): the plate and every rib on one sheet at true size, kerf included.", "author": "3DCraft Jigs", "licence": "CC-BY-4.0", "url": "https://github.com/johancoppens/3dcraft-jigs/tree/main/jigs/welding-table", "tags": ["welding", "table", "fixture", "laser", "plasma", "sheet"]}],
["jig.export", {"path": "dist/welding-table.3dcraftjig"}]
]
