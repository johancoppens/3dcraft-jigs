[
["table.set", {"name": "systems", "columns": ["system", {"name": "hole", "unit": "mm"}, {"name": "grid", "unit": "mm"}, {"name": "plate", "unit": "mm"}, {"name": "side", "unit": "mm"}, {"name": "rib", "unit": "mm"}, {"name": "leg", "unit": "mm"}], "rows": [["System 16", 16, 50, 12, 100, 10, 80], ["System 28", 28, 100, 25, 200, 15, 100]]}],
["variable.set", {"name": "sys", "expr": "1"}],
["variable.set", {"name": "L", "expr": "1200 mm"}],
["variable.set", {"name": "Wd", "expr": "800 mm"}],
["variable.set", {"name": "ribEvery", "expr": "4"}],
["variable.set", {"name": "clearance", "expr": "0.3 mm"}],
["variable.set", {"name": "frame", "expr": "3"}],
["variable.set", {"name": "tableH", "expr": "900 mm"}],
["variable.set", {"name": "hd", "expr": "systems[sys].hole"}],
["variable.set", {"name": "g", "expr": "systems[sys].grid"}],
["variable.set", {"name": "pt", "expr": "systems[sys].plate"}],
["variable.set", {"name": "sh", "expr": "systems[sys].side"}],
["variable.set", {"name": "rt", "expr": "systems[sys].rib"}],
["variable.set", {"name": "legS", "expr": "systems[sys].leg"}],
["variable.set", {"name": "nX", "expr": "floor(L / g)"}],
["variable.set", {"name": "nY", "expr": "floor(Wd / g)"}],
["variable.set", {"name": "x0", "expr": "(L - (nX - 1) * g) / 2"}],
["variable.set", {"name": "y0", "expr": "(Wd - (nY - 1) * g) / 2"}],
["variable.set", {"name": "rows", "expr": "floor(sh / g)"}],
["variable.set", {"name": "nRx", "expr": "max(0, ceil((nX - 1) / ribEvery) - 1)"}],
["variable.set", {"name": "nRy", "expr": "max(0, ceil((nY - 1) / ribEvery) - 1)"}],
["variable.set", {"name": "xr0", "expr": "x0 + (round((nX - 2) / 2 - (nRx - 1) * ribEvery / 2) + 0.5) * g"}],
["variable.set", {"name": "yr0", "expr": "y0 + (round((nY - 2) / 2 - (nRy - 1) * ribEvery / 2) + 0.5) * g"}],
["variable.set", {"name": "ribStep", "expr": "ribEvery * g"}],
["variable.set", {"name": "rh", "expr": "sh - pt"}],
["variable.set", {"name": "sw", "expr": "rt + clearance"}],
["variable.set", {"name": "legsOn", "expr": "frame >= 2"}],
["variable.set", {"name": "frameOn", "expr": "frame == 3"}],
["variable.set", {"name": "footT", "expr": "10 mm"}],
["variable.set", {"name": "footS", "expr": "legS + 40 mm"}],
["variable.set", {"name": "railS", "expr": "0.75 * legS"}],
["variable.set", {"name": "railZ", "expr": "-tableH + 150 mm"}],
["sketch.create", {"name": "TopSketch", "plane": "xy", "offset": "-pt"}],
["sketch.rect", {"sketch": "TopSketch", "from": ["0 mm", "0 mm"], "to": ["L", "Wd"]}],
["sketch.circle", {"sketch": "TopSketch", "center": ["x0", "y0"], "radius": "hd / 2"}],
["sketch.pattern", {"sketch": "TopSketch", "entities": ["e10"], "count": "nX", "step": ["g", "0 mm"], "count2": "nY", "step2": ["0 mm", "g"]}],
["feature.extrude", {"sketch": "TopSketch", "distance": "pt", "name": "Top"}],
["sketch.create", {"name": "FrontSketch", "plane": "zx"}],
["sketch.rect", {"sketch": "FrontSketch", "from": ["-sh", "0 mm"], "to": ["-pt", "L"]}],
["sketch.circle", {"sketch": "FrontSketch", "center": ["-g / 2", "x0"], "radius": "hd / 2"}],
["sketch.pattern", {"sketch": "FrontSketch", "entities": ["e10"], "count": "nX", "step": ["0 mm", "g"], "count2": "rows", "step2": ["-g", "0 mm"]}],
["feature.extrude", {"sketch": "FrontSketch", "distance": "pt", "name": "Front"}],
["feature.mirror", {"source": "Front", "normal": [0, 1, 0], "point": ["0 mm", "Wd / 2", "0 mm"], "keep": true, "name": "Back"}],
["sketch.create", {"name": "LeftSketch", "plane": "yz"}],
["sketch.rect", {"sketch": "LeftSketch", "from": ["pt", "-sh"], "to": ["Wd - pt", "-pt"]}],
["sketch.circle", {"sketch": "LeftSketch", "center": ["y0", "-g / 2"], "radius": "hd / 2"}],
["sketch.pattern", {"sketch": "LeftSketch", "entities": ["e10"], "count": "nY", "step": ["g", "0 mm"], "count2": "rows", "step2": ["0 mm", "-g"]}],
["feature.extrude", {"sketch": "LeftSketch", "distance": "pt", "name": "Left"}],
["feature.mirror", {"source": "Left", "normal": [1, 0, 0], "point": ["L / 2", "0 mm", "0 mm"], "keep": true, "name": "Right"}],
["feature.block", {"name": "RibY", "size": ["rt", "Wd - 2 * pt", "rh"], "position": ["xr0 - rt / 2", "pt", "-sh"]}],
["feature.block", {"name": "LapY", "size": ["rt + 2 mm", "sw", "rh / 2 + 1 mm"], "position": ["xr0 - rt / 2 - 1 mm", "yr0 - sw / 2", "-pt - rh / 2"]}],
["feature.pattern", {"name": "LapsY", "source": "LapY", "count": "nRy", "step": ["0 mm", "ribStep", "0 mm"]}],
["feature.boolean", {"op": "subtract", "target": "RibY", "tool": "LapsY", "name": "RibYLapped"}],
["feature.pattern", {"name": "RibsY", "source": "RibYLapped", "count": "nRx", "step": ["ribStep", "0 mm", "0 mm"]}],
["feature.block", {"name": "RibX", "size": ["L - 2 * pt", "rt", "rh"], "position": ["pt", "yr0 - rt / 2", "-sh"]}],
["feature.block", {"name": "LapX", "size": ["sw", "rt + 2 mm", "rh / 2 + 1 mm"], "position": ["xr0 - sw / 2", "yr0 - rt / 2 - 1 mm", "-sh - 1 mm"]}],
["feature.pattern", {"name": "LapsX", "source": "LapX", "count": "nRx", "step": ["ribStep", "0 mm", "0 mm"]}],
["feature.boolean", {"op": "subtract", "target": "RibX", "tool": "LapsX", "name": "RibXLapped"}],
["feature.pattern", {"name": "RibsX", "source": "RibXLapped", "count": "nRy", "step": ["0 mm", "ribStep", "0 mm"]}],
["feature.when", {"feature": "RibY", "expr": "nRx >= 1 && nRy >= 1"}],
["feature.when", {"feature": "LapY", "expr": "nRx >= 1 && nRy >= 1"}],
["feature.when", {"feature": "LapsY", "expr": "nRx >= 1 && nRy >= 1"}],
["feature.when", {"feature": "RibYLapped", "expr": "nRx >= 1 && nRy >= 1"}],
["feature.when", {"feature": "RibsY", "expr": "nRx >= 1 && nRy >= 1"}],
["feature.when", {"feature": "RibX", "expr": "nRx >= 1 && nRy >= 1"}],
["feature.when", {"feature": "LapX", "expr": "nRx >= 1 && nRy >= 1"}],
["feature.when", {"feature": "LapsX", "expr": "nRx >= 1 && nRy >= 1"}],
["feature.when", {"feature": "RibXLapped", "expr": "nRx >= 1 && nRy >= 1"}],
["feature.when", {"feature": "RibsX", "expr": "nRx >= 1 && nRy >= 1"}],
["feature.block", {"name": "Leg", "size": ["legS", "legS", "tableH - sh - footT"], "position": ["pt", "pt", "-tableH + footT"]}],
["feature.block", {"name": "Foot", "size": ["footS", "footS", "footT"], "position": ["pt + legS / 2 - footS / 2", "pt + legS / 2 - footS / 2", "-tableH"]}],
["feature.boolean", {"op": "union", "target": "Leg", "tool": "Foot", "name": "LegFoot"}],
["feature.pattern", {"name": "LegRow", "source": "LegFoot", "count": "2", "step": ["L - 2 * pt - legS", "0 mm", "0 mm"]}],
["feature.pattern", {"name": "Legs", "source": "LegRow", "count": "2", "step": ["0 mm", "Wd - 2 * pt - legS", "0 mm"]}],
["feature.block", {"name": "RailX", "size": ["L - 2 * pt - 2 * legS", "railS", "railS"], "position": ["pt + legS", "pt + legS / 2 - railS / 2", "railZ"]}],
["feature.pattern", {"name": "RailsX", "source": "RailX", "count": "2", "step": ["0 mm", "Wd - 2 * pt - legS", "0 mm"]}],
["feature.block", {"name": "RailY", "size": ["railS", "Wd - 2 * pt - 2 * legS", "railS"], "position": ["pt + legS / 2 - railS / 2", "pt + legS", "railZ"]}],
["feature.pattern", {"name": "RailsY", "source": "RailY", "count": "2", "step": ["L - 2 * pt - legS", "0 mm", "0 mm"]}],
["feature.when", {"feature": "Leg", "expr": "legsOn"}],
["feature.when", {"feature": "Foot", "expr": "legsOn"}],
["feature.when", {"feature": "LegFoot", "expr": "legsOn"}],
["feature.when", {"feature": "LegRow", "expr": "legsOn"}],
["feature.when", {"feature": "Legs", "expr": "legsOn"}],
["feature.when", {"feature": "RailX", "expr": "frameOn"}],
["feature.when", {"feature": "RailsX", "expr": "frameOn"}],
["feature.when", {"feature": "RailY", "expr": "frameOn"}],
["feature.when", {"feature": "RailsY", "expr": "frameOn"}],
["body.appearance", {"body": "Top", "color": "#7D858C", "metallic": 0.85, "roughness": 0.4}],
["body.appearance", {"body": "Front", "color": "#7D858C", "metallic": 0.85, "roughness": 0.4}],
["body.appearance", {"body": "Back", "color": "#7D858C", "metallic": 0.85, "roughness": 0.4}],
["body.appearance", {"body": "Left", "color": "#7D858C", "metallic": 0.85, "roughness": 0.4}],
["body.appearance", {"body": "Right", "color": "#7D858C", "metallic": 0.85, "roughness": 0.4}],
["body.appearance", {"body": "RibsX", "color": "#7D858C", "metallic": 0.85, "roughness": 0.4}],
["body.appearance", {"body": "RibsY", "color": "#7D858C", "metallic": 0.85, "roughness": 0.4}],
["body.appearance", {"body": "Legs", "color": "#5B7299", "metallic": 0.3, "roughness": 0.5}],
["body.appearance", {"body": "RailsX", "color": "#5B7299", "metallic": 0.3, "roughness": 0.5}],
["body.appearance", {"body": "RailsY", "color": "#5B7299", "metallic": 0.3, "roughness": 0.5}],
["assert.add", {"name": "holes in the top", "measure": "count", "of": {"kind": "face", "where": {"in": "Top", "hole": true}}, "eq": "nX * nY"}],
["assert.add", {"name": "holes in the sides", "measure": "count", "of": {"kind": "face", "where": {"any": [{"in": "Front"}, {"in": "Back"}, {"in": "Left"}, {"in": "Right"}], "hole": true}}, "eq": "2 * rows * (nX + nY)"}],
["variable.publish", {"name": "sys", "label": "System", "group": "System", "order": 1, "kind": "choice", "choicesFrom": "systems", "description": "System 16: 16 mm holes on a 50 mm grid, 12 mm plate, 100 mm sides. System 28: 28 mm holes on a 100 mm grid, 25 mm plate, 200 mm sides"}],
["variable.publish", {"name": "L", "label": "Length", "group": "Size", "order": 1, "min": "600 mm", "max": "2000 mm", "step": "50 mm", "unit": "mm", "description": "Length of the top (x)"}],
["variable.publish", {"name": "Wd", "label": "Width", "group": "Size", "order": 2, "min": "400 mm", "max": "1200 mm", "step": "50 mm", "unit": "mm", "description": "Width of the top (y)"}],
["variable.publish", {"name": "ribEvery", "label": "Rib spacing", "group": "Ribs", "order": 1, "kind": "integer", "min": "2", "max": "8", "description": "A rib every so many holes, both ways, on the lines between the holes"}],
["variable.publish", {"name": "clearance", "label": "Lap clearance", "group": "Ribs", "order": 2, "min": "0 mm", "max": "1 mm", "step": "0.05 mm", "unit": "mm", "description": "Extra width of the half-lap slots where the ribs cross"}],
["variable.publish", {"name": "frame", "label": "Base", "group": "Base", "order": 1, "kind": "choice", "choices": ["None", "Legs", "Legs and frame"], "description": "Only the block (to put on trestles), four legs with feet, or legs joined by a frame near the floor"}],
["variable.publish", {"name": "tableH", "label": "Working height", "group": "Base", "order": 2, "min": "600 mm", "max": "1000 mm", "step": "10 mm", "unit": "mm", "description": "Height of the top surface above the floor, with legs"}],
["set.define", {"name": "Cut sheet", "kind": "face", "where": {"any": [{"in": "Top", "normal": {"along": "z"}}, {"in": "Front", "normal": {"along": "-y"}}, {"in": "Back", "normal": {"along": "y"}}, {"in": "Left", "normal": {"along": "-x"}}, {"in": "Right", "normal": {"along": "x"}}, {"in": "RibsX", "normal": {"along": "-y"}}, {"in": "RibsY", "normal": {"along": "x"}}]}}],
["document.info", {"title": "Welding table", "description": "A system welding table in the style of the 16 mm and 28 mm block tables: a top plate with a grid of system holes, side plates on all four edges carrying the same grid, half-lapped ribs under the top, and legs with a frame if you want them. Choose the system and the size. To cut the plates: File > Export..., DXF or SVG with the face set \"Cut sheet\" (the top, the four sides and every rib at true size); STEP for the whole table.", "author": "3DCraft Jigs", "licence": "CC-BY-4.0", "url": "https://github.com/johancoppens/3dcraft-jigs/tree/main/jigs/welding-table", "tags": ["welding", "fixture table", "steel", "laser", "plasma"]}],
["jig.export", {"path": "dist/welding-table.3dcraftjig"}]
]
