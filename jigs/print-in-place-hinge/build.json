[
["variable.set", {"name": "length", "expr": "60 mm"}],
["variable.set", {"name": "leafW", "expr": "22 mm"}],
["variable.set", {"name": "thick", "expr": "2.5 mm"}],
["variable.set", {"name": "knuckleD", "expr": "8 mm"}],
["variable.set", {"name": "knuckles", "expr": "5"}],
["variable.set", {"name": "pinD", "expr": "4 mm"}],
["variable.set", {"name": "clearance", "expr": "0.3 mm"}],
["variable.set", {"name": "holes", "expr": "2"}],
["variable.set", {"name": "holeD", "expr": "3.5 mm"}],
["variable.set", {"name": "R", "expr": "knuckleD / 2"}],
["variable.set", {"name": "z0", "expr": "R - 0.3 mm"}],
["variable.set", {"name": "g", "expr": "clearance"}],
["variable.set", {"name": "s", "expr": "(length - (knuckles - 1) * g) / knuckles"}],
["variable.set", {"name": "pitch", "expr": "2 * (s + g)"}],
["variable.set", {"name": "nA", "expr": "ceil(knuckles / 2)"}],
["variable.set", {"name": "nB", "expr": "floor(knuckles / 2)"}],
["variable.set", {"name": "nL", "expr": "floor((knuckles - 1) / 2)"}],
["variable.set", {"name": "h", "expr": "pinD / 2"}],
["variable.set", {"name": "sh", "expr": "h + clearance * sqrt(2)"}],
["variable.set", {"name": "zr", "expr": "R + clearance"}],
["variable.set", {"name": "csD", "expr": "min(holeD / 2, 0.6 * thick)"}],
["variable.set", {"name": "csR", "expr": "holeD / 2 + csD"}],
["variable.set", {"name": "yh", "expr": "(zr + leafW) / 2"}],
["variable.set", {"name": "cr", "expr": "min(3 mm, (leafW - zr) / 3)"}],
["feature.block", {"name": "LeafA", "size": ["length + 2 mm", "leafW + 1 mm", "thick + 1 mm"], "position": ["-1 mm", "-leafW - 1 mm", "-1 mm"]}],
["feature.cylinder", {"name": "KnA", "radius": "R", "height": "s + 1 mm", "axis": [1, 0, 0], "position": ["-0.5 mm", "0 mm", "z0"]}],
["feature.pattern", {"name": "KnucklesA", "source": "KnA", "count": "nA", "step": ["pitch", "0 mm", "0 mm"]}],
["feature.boolean", {"op": "union", "target": "LeafA", "tool": "KnucklesA", "name": "A0"}],
["feature.cylinder", {"name": "ZoneB", "radius": "zr", "height": "s + 2 * g", "axis": [1, 0, 0], "position": ["s", "0 mm", "z0"]}],
["feature.pattern", {"name": "ZonesB", "source": "ZoneB", "count": "nB", "step": ["pitch", "0 mm", "0 mm"]}],
["feature.boolean", {"op": "subtract", "target": "A0", "tool": "ZonesB", "name": "A1"}],
["feature.cone", {"name": "PinR", "radius": "h + 0.5 mm", "height": "h + 0.5 mm", "axis": [1, 0, 0], "position": ["s - 0.5 mm", "0 mm", "z0"]}],
["feature.pattern", {"name": "PinsR", "source": "PinR", "count": "nB", "step": ["pitch", "0 mm", "0 mm"]}],
["feature.boolean", {"op": "union", "target": "A1", "tool": "PinsR", "name": "A2"}],
["feature.cone", {"name": "PinL", "radius": "h + 0.5 mm", "height": "h + 0.5 mm", "axis": [-1, 0, 0], "position": ["pitch + 0.5 mm", "0 mm", "z0"]}],
["feature.pattern", {"name": "PinsL", "source": "PinL", "count": "max(1, nL)", "step": ["pitch", "0 mm", "0 mm"]}],
["feature.when", {"feature": "PinL", "expr": "nL > 0"}],
["feature.when", {"feature": "PinsL", "expr": "nL > 0"}],
["feature.boolean", {"op": "union", "target": "A2", "tool": "PinsL", "name": "A3"}],
["feature.block", {"name": "LeafB", "size": ["length + 2 mm", "leafW + 1 mm", "thick + 1 mm"], "position": ["-1 mm", "0 mm", "-1 mm"]}],
["feature.cylinder", {"name": "KnB", "radius": "R", "height": "s + 1 mm", "axis": [1, 0, 0], "position": ["s + g - 0.5 mm", "0 mm", "z0"]}],
["feature.pattern", {"name": "KnucklesB", "source": "KnB", "count": "nB", "step": ["pitch", "0 mm", "0 mm"]}],
["feature.boolean", {"op": "union", "target": "LeafB", "tool": "KnucklesB", "name": "B0"}],
["feature.cylinder", {"name": "ZoneA", "radius": "zr", "height": "s + 2 * g", "axis": [1, 0, 0], "position": ["-g", "0 mm", "z0"]}],
["feature.pattern", {"name": "ZonesA", "source": "ZoneA", "count": "nA", "step": ["pitch", "0 mm", "0 mm"]}],
["feature.boolean", {"op": "subtract", "target": "B0", "tool": "ZonesA", "name": "B1"}],
["feature.cone", {"name": "SocketR", "radius": "sh - g / 2", "height": "sh - g / 2", "axis": [1, 0, 0], "position": ["s + g / 2", "0 mm", "z0"]}],
["feature.pattern", {"name": "SocketsR", "source": "SocketR", "count": "nB", "step": ["pitch", "0 mm", "0 mm"]}],
["feature.boolean", {"op": "subtract", "target": "B1", "tool": "SocketsR", "name": "B2"}],
["feature.cone", {"name": "SocketL", "radius": "sh - g / 2", "height": "sh - g / 2", "axis": [-1, 0, 0], "position": ["pitch - g / 2", "0 mm", "z0"]}],
["feature.pattern", {"name": "SocketsL", "source": "SocketL", "count": "max(1, nL)", "step": ["pitch", "0 mm", "0 mm"]}],
["feature.when", {"feature": "SocketL", "expr": "nL > 0"}],
["feature.when", {"feature": "SocketsL", "expr": "nL > 0"}],
["feature.boolean", {"op": "subtract", "target": "B2", "tool": "SocketsL", "name": "B3"}],
["feature.cylinder", {"name": "HoleA", "radius": "holeD / 2", "height": "thick + 3 mm", "position": ["length / holes / 2", "-yh", "-2 mm"]}],
["feature.cone", {"name": "SinkA", "radius": "csR + 1 mm", "height": "csR + 1 mm", "axis": [0, 0, -1], "position": ["length / holes / 2", "-yh", "thick + 1 mm"]}],
["feature.boolean", {"op": "union", "target": "HoleA", "tool": "SinkA", "name": "ScrewA"}],
["feature.pattern", {"name": "ScrewsA", "source": "ScrewA", "count": "holes", "step": ["length / holes", "0 mm", "0 mm"]}],
["feature.boolean", {"op": "subtract", "target": "A3", "tool": "ScrewsA", "name": "A4"}],
["feature.cylinder", {"name": "HoleB", "radius": "holeD / 2", "height": "thick + 3 mm", "position": ["length / holes / 2", "yh", "-2 mm"]}],
["feature.cone", {"name": "SinkB", "radius": "csR + 1 mm", "height": "csR + 1 mm", "axis": [0, 0, -1], "position": ["length / holes / 2", "yh", "thick + 1 mm"]}],
["feature.boolean", {"op": "union", "target": "HoleB", "tool": "SinkB", "name": "ScrewB"}],
["feature.pattern", {"name": "ScrewsB", "source": "ScrewB", "count": "holes", "step": ["length / holes", "0 mm", "0 mm"]}],
["feature.boolean", {"op": "subtract", "target": "B3", "tool": "ScrewsB", "name": "B4"}],
["sketch.create", {"name": "OutlineSketch", "plane": "xy"}],
["sketch.path", {"sketch": "OutlineSketch", "start": ["length / 2 + (length / 2)", "-leafW + cr"], "segments": [{"line": ["length / 2 + (length / 2)", "leafW - cr"]}, {"arc": ["length / 2 + (length / 2 - cr)", "leafW"], "center": ["length / 2 + (length / 2 - cr)", "leafW - cr"]}, {"line": ["length / 2 + (-length / 2 + cr)", "leafW"]}, {"arc": ["length / 2 + (-length / 2)", "leafW - cr"], "center": ["length / 2 + (-length / 2 + cr)", "leafW - cr"]}, {"line": ["length / 2 + (-length / 2)", "-leafW + cr"]}, {"arc": ["length / 2 + (-length / 2 + cr)", "-leafW"], "center": ["length / 2 + (-length / 2 + cr)", "-leafW + cr"]}, {"line": ["length / 2 + (length / 2 - cr)", "-leafW"]}, {"arc": "start", "center": ["length / 2 + (length / 2 - cr)", "-leafW + cr"]}]}],
["feature.extrude", {"sketch": "OutlineSketch", "distance": "knuckleD + 2 mm", "name": "Outline"}],
["feature.boolean", {"op": "intersect", "target": "A4", "tool": "Outline", "keepTool": true, "name": "Leaf A"}],
["feature.boolean", {"op": "intersect", "target": "B4", "tool": "Outline", "name": "Leaf B"}],
["body.appearance", {"body": "Leaf A", "color": "#C2694B", "roughness": 0.6}],
["body.appearance", {"body": "Leaf B", "color": "#8FA98A", "roughness": 0.6}],
["assert.add", {"name": "two leaves", "measure": "count", "of": {"kind": "body"}, "eq": "2"}],
["assert.add", {"name": "leaves apart", "measure": "interference", "of": ["Leaf A", "Leaf B"]}],
["variable.publish", {"name": "length", "label": "Length", "description": "Length of the hinge along its axis", "group": "Size", "order": 1, "min": "40 mm", "max": "200 mm", "step": "1 mm", "unit": "mm"}],
["variable.publish", {"name": "leafW", "label": "Leaf width", "description": "Width of each leaf, from the axis to its edge", "group": "Size", "order": 2, "min": "knuckleD / 2 + clearance + 2 * holeD + 4 mm", "max": "80 mm", "step": "0.5 mm", "unit": "mm"}],
["variable.publish", {"name": "thick", "label": "Leaf thickness", "description": "Thickness of the leaves; at most the axis height, so the hinge folds flat", "group": "Size", "order": 3, "min": "1.5 mm", "max": "knuckleD / 2 - 0.5 mm", "step": "0.1 mm", "unit": "mm"}],
["variable.publish", {"name": "knuckleD", "label": "Knuckle diameter", "description": "Outside diameter of the knuckles", "group": "Knuckles", "order": 1, "min": "6 mm", "max": "16 mm", "step": "0.5 mm", "unit": "mm"}],
["variable.publish", {"name": "knuckles", "label": "Knuckles", "description": "Number of knuckles; leaf A has the first, the third and so on", "group": "Knuckles", "order": 2, "kind": "integer", "min": "2", "max": "floor((length + clearance) / (pinD + clearance + 3 mm))"}],
["variable.publish", {"name": "pinD", "label": "Pin diameter", "description": "Base diameter of the 45 degree conical pins between the knuckles", "group": "Knuckles", "order": 3, "min": "2 mm", "max": "min(knuckleD - 3 mm, 8 mm)", "step": "0.1 mm", "unit": "mm"}],
["variable.publish", {"name": "clearance", "label": "Clearance", "description": "Gap between the moving parts (printer tuning): 0.3 mm suits most printers", "group": "Knuckles", "order": 4, "min": "0.15 mm", "max": "0.8 mm", "step": "0.05 mm", "unit": "mm"}],
["variable.publish", {"name": "holes", "label": "Screw holes", "description": "Countersunk screw holes in each leaf", "group": "Screws", "order": 1, "kind": "integer", "min": "1", "max": "6"}],
["variable.publish", {"name": "holeD", "label": "Screw diameter", "description": "Hole diameter; the countersink is 90 degrees", "group": "Screws", "order": 2, "min": "2 mm", "max": "5 mm", "step": "0.1 mm", "unit": "mm"}],
["document.info", {"title": "Print-in-place hinge", "description": "A hinge that prints in one piece and turns straight off the bed: set its length, leaf width and thickness, the knuckles and their conical pins, the clearance between the moving parts, and countersunk screw holes. The pins and their sockets are 45 degree cones, so it prints flat without supports. Export both leaves together with File > Export... (STL or 3MF) and print them as they lie.", "author": "Johan Coppens", "licence": "CC-BY-4.0", "url": "https://github.com/johancoppens/3dcraft-jigs/tree/main/jigs/print-in-place-hinge", "tags": ["hinge", "print in place", "mechanism", "3D printing"]}],
["jig.export", {"path": "dist/print-in-place-hinge.3dcraftjig"}]
]
