[
["table.set", {"name": "sheets", "columns": ["sheet", {"name": "short", "unit": "mm"}, {"name": "long", "unit": "mm"}], "rows": [["A5", 148, 210], ["A4", 210, 297], ["A3", 297, 420], ["A2", 420, 594], ["A1", 594, 841], ["US Letter", 215.9, 279.4], ["US Tabloid", 279.4, 431.8], ["Art board 500 x 700", 500, 700], ["Laser bed 400 x 600", 400, 600]]}],
["variable.set", {"name": "fold_percent", "expr": "50"}],
["variable.set", {"name": "rows", "expr": "8"}],
["variable.set", {"name": "columns", "expr": "10"}],
["variable.set", {"name": "sector_angle", "expr": "70 deg"}],
["variable.set", {"name": "sheet", "expr": "2"}],
["variable.set", {"name": "landscape", "expr": "1"}],
["variable.set", {"name": "margin", "expr": "10 mm"}],
["variable.set", {"name": "paper_weight", "expr": "160"}],
["variable.set", {"name": "thick_panels", "expr": "0"}],
["variable.set", {"name": "panel_thickness", "expr": "1.5 mm"}],
["variable.set", {"name": "panel_gap", "expr": "4 mm"}],
["variable.set", {"name": "laser_kerf", "expr": "0.15 mm"}],
["variable.set", {"name": "sheet_width", "expr": "if(landscape, sheets[sheet].long, sheets[sheet].short)"}],
["variable.set", {"name": "sheet_height", "expr": "if(landscape, sheets[sheet].short, sheets[sheet].long)"}],
["variable.set", {"name": "pattern_width", "expr": "sheet_width - 2 * margin"}],
["variable.set", {"name": "pattern_height", "expr": "sheet_height - 2 * margin"}],
["variable.set", {"name": "row_height", "expr": "pattern_height / rows"}],
["variable.set", {"name": "zigzag_offset", "expr": "row_height / tan(sector_angle)"}],
["variable.set", {"name": "cell_width", "expr": "(pattern_width - zigzag_offset) / columns"}],
["variable.set", {"name": "zigzag_edge", "expr": "row_height / sin(sector_angle)"}],
["variable.set", {"name": "flat_area", "expr": "rows * columns * cell_width * row_height"}],
["variable.set", {"name": "smallest_cell", "expr": "10 mm"}],
["variable.set", {"name": "rows_max", "expr": "min(14, floor(pattern_height / smallest_cell))"}],
["variable.set", {"name": "columns_max", "expr": "min(16, floor((pattern_width - zigzag_offset) / smallest_cell))"}],
["variable.set", {"name": "angle_max", "expr": "if(rows * columns > 144, 70 deg, 80 deg)"}],
["variable.set", {"name": "narrowest_cell", "expr": "min(row_height, cell_width * sin(sector_angle))"}],
["variable.set", {"name": "panel_clearance", "expr": "panel_gap / 2"}],
["variable.set", {"name": "drawn_clearance", "expr": "panel_clearance - laser_kerf / 2"}],
["variable.set", {"name": "panel_stop_gap", "expr": "0.05 * panel_gap"}],
["variable.set", {"name": "panel_half_diagonal", "expr": "sqrt(panel_clearance^2 + panel_thickness^2)"}],
["variable.set", {"name": "tilt_stop", "expr": "if(thick_panels, acos(panel_stop_gap / (2 * panel_half_diagonal)) - atan(panel_thickness / panel_clearance), 90 deg)"}],
["variable.set", {"name": "facet_tilt", "expr": "fold_percent / 100 * tilt_stop"}],
["variable.set", {"name": "fold_angle", "expr": "if(fold_percent >= 100 && !thick_panels, 180 deg, 2 * atan(tan(facet_tilt) * cos(sector_angle)))"}],
["variable.set", {"name": "zigzag_fold_angle", "expr": "2 * facet_tilt"}],
["variable.set", {"name": "in_plane_turn", "expr": "sector_angle - atan(tan(sector_angle) * cos(facet_tilt))"}],
["variable.set", {"name": "anchor_column", "expr": "2 * floor(columns / 4) + 1"}],
["variable.set", {"name": "anchor_row", "expr": "2 * floor(rows / 4)"}],
["variable.set", {"name": "anchor_x", "expr": "(anchor_column + 0.5) * cell_width + 0.5 * zigzag_offset"}],
["variable.set", {"name": "anchor_y", "expr": "(anchor_row + 0.5) * row_height"}],
["variable.set", {"name": "not_folded_flat", "expr": "fold_angle < 180 deg"}],
["variable.set", {"name": "folded_depth", "expr": "cell_width * sin(sector_angle) * sin(facet_tilt)"}],
["variable.set", {"name": "straight_run", "expr": "sqrt(max(0 mm^2, cell_width^2 - folded_depth^2))"}],
["variable.set", {"name": "zigzag_run", "expr": "zigzag_edge * cos(sector_angle) * cell_width / straight_run"}],
["variable.set", {"name": "zigzag_pitch", "expr": "sqrt(max(0 mm^2, zigzag_edge^2 - zigzag_run^2))"}],
["variable.set", {"name": "folded_length", "expr": "columns * straight_run + zigzag_run"}],
["variable.set", {"name": "folded_width", "expr": "rows * zigzag_pitch"}],
["variable.set", {"name": "mountain_pieces_zigzag", "expr": "floor(columns / 2) * rows"}],
["variable.set", {"name": "valley_pieces_zigzag", "expr": "floor((columns - 1) / 2) * rows"}],
["variable.set", {"name": "valley_pieces_straight", "expr": "floor(rows / 2) * ceil(columns / 2) + floor((rows - 1) / 2) * floor(columns / 2)"}],
["variable.set", {"name": "mountain_pieces_straight", "expr": "(rows - 1) * columns - valley_pieces_straight"}],
["variable.set", {"name": "mountain_length", "expr": "mountain_pieces_zigzag * zigzag_edge + mountain_pieces_straight * cell_width"}],
["variable.set", {"name": "valley_length", "expr": "valley_pieces_zigzag * zigzag_edge + valley_pieces_straight * cell_width"}],
["variable.set", {"name": "paper_bulk", "expr": "1.25"}],
["variable.set", {"name": "paper_thickness", "expr": "paper_weight * paper_bulk * (0.001 mm)"}],
["variable.set", {"name": "pack_layers", "expr": "rows * min(columns, 2 * ceil(zigzag_edge / (2 * cell_width * cos(sector_angle))))"}],
["variable.set", {"name": "pack_thickness_paper", "expr": "pack_layers * paper_thickness"}],
["sketch.create", {"plane": "xy", "name": "Crease pattern"}],
