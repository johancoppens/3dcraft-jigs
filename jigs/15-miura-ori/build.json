["assert.add", {"name": "Folded length along the straight creases by the closed form", "measure": "extent", "of": {"body": "Miura-ori", "follow": true}, "axis": "x", "eq": "folded_length", "tol": "0.001 mm", "when": "not_folded_flat"}],
