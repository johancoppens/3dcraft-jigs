["variable.output", {"name": "hinge_gap_now", "expr": "if(thick_panels, 2 * (panel_clearance * cos(facet_tilt) - panel_thickness * sin(facet_tilt)), 0 mm)", "label": "Thick panels: gap left at the tightest zigzag crease now (0 for paper)", "unit": "mm"}],
["variable.publish", {"name": "fold_percent", "label": "Fold", "description": "Drag it: 0 is the flat sheet. Paper: 100 is folded flat, and at 50 the zigzag creases stand at a right angle; at exactly 100 the pack lies down on the sketch plane, turned, because 3DCraft does not move a flat-folded body (at 99 it stands on edge). Thick panels: 100 is as far as the panels go, and 50 is half of that tilt, so the creases then stand at less than a right angle.", "group": "Fold", "order": 1, "min": "0", "max": "100", "step": "1"}],
