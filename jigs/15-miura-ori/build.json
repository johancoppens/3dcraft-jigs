["assert.add", {"name": "Kawasaki holds at every interior vertex", "measure": "kawasakiFails", "of": "Miura-ori", "eq": "0"}],
["assert.add", {"name": "Maekawa holds at every interior vertex", "measure": "maekawaFails", "of": "Miura-ori", "eq": "0"}],
["assert.add", {"name": "The pattern folds flat (an order of the layers exists)", "measure": "flatFoldable", "of": "Miura-ori", "is": true}],
["assert.add", {"name": "Mountain creases: the pieces of the stated lengths (measured)", "measure": "count", "of": {"kind": "edge", "where": {"all": [{"madeBy": "Miura-ori"}, {"any": [{"all": [{"any": [{"name": "*startEdge(e21*"}, {"name": "*startEdge(e24*"}]}, {"length": "zigzag_edge"}]}, {"all": [{"any": [{"name": "*startEdge(e36*"}, {"name": "*startEdge(e39*"}]}, {"length": "cell_width"}]}]}]}}, "eq": "mountain_pieces_zigzag + mountain_pieces_straight"}],
