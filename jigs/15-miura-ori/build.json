["variable.output", {"name": "size_folded_width", "expr": "if(not_folded_flat, folded_width, pack_thickness_paper)", "label": "Now: width of the fold (at 100, the thickness of the pack)", "unit": "mm"}],
["variable.output", {"name": "size_folded_depth", "expr": "folded_depth", "label": "Now: depth of the fold (at 100, the width of the pack)", "unit": "mm"}],
