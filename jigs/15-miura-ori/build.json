["sketch.pattern", {"sketch": "Crease pattern", "entities": ["e30"], "count": "floor((columns - 1) / 2)", "step": ["2 * cell_width", "0 mm"], "count2": "floor(rows / 2)", "step2": ["0 mm", "2 * row_height"]}],
