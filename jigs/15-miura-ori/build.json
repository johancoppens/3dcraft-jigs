["document.info", {"title": "Miura-ori fold panel", "author": "3DCraft Jigs", "licence": "CC-BY-4.0", "description": "A Miura-ori sheet that folds and unfolds with one slider, from flat to folded flat. Pick the sheet, the rows and columns and the parallelogram angle; the pattern fills the sheet. Paper, or rigid panels on a fabric hinge that fold as far as the panels allow. To cut and score: File > Export, Crease pattern of Miura-ori, as SVG or DXF, with the mountains and valleys on separate layers. For the panels: File > Export, Sheet of set Panels cut sheet.", "tags": ["origami", "miura-ori", "fold", "paper", "laser", "thick panels"]}],
