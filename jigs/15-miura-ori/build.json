["sketch.pattern", {"sketch": "Crease pattern", "entities": ["e33"], "count": "ceil(columns / 2)", "step": ["2 * cell_width", "0 mm"], "count2": "floor(rows / 2)", "step2": ["0 mm", "2 * row_height"]}],
["sketch.line", {"sketch": "Crease pattern", "from": ["cell_width + zigzag_offset", "row_height"], "to": ["2 * cell_width + zigzag_offset", "row_height"], "construction": true}],
["sketch.pattern", {"sketch": "Crease pattern", "entities": ["e36"], "count": "floor(columns / 2)", "step": ["2 * cell_width", "0 mm"], "count2": "floor(rows / 2)", "step2": ["0 mm", "2 * row_height"]}],
