["assert.add", {"name": "Every cell is in the folded sheet (area in closed form)", "measure": "area", "of": {"body": "Miura-ori", "follow": true}, "eq": "flat_area", "tol": "flat_area * 1e-6"}],
["assert.add", {"name": "Folded depth by the closed form a sin(angle) sin(tilt)", "measure": "extent", "of": {"body": "Miura-ori", "follow": true}, "axis": "z", "eq": "if(not_folded_flat, folded_depth, 0 mm)", "tol": "0.001 mm"}],
