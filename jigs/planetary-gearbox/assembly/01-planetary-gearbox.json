[
["assembly.new", {"units": "mm", "tolerance": 0.001}],
["file.save", {"path": "dist/planetary-gearbox.3dcraftasm"}],
["variable.set", {"name": "moduleSize", "expr": "4"}],
["variable.set", {"name": "module", "expr": "1.5 mm"}],
["variable.set", {"name": "Zs", "expr": "12"}],
["variable.set", {"name": "Zr", "expr": "48"}],
["variable.set", {"name": "w", "expr": "10 mm"}],
["variable.set", {"name": "backlash", "expr": "0.1 mm"}],
["variable.set", {"name": "Zp", "expr": "(Zr - Zs) / 2"}],
["variable.set", {"name": "pTurn", "expr": "if(mod(Zp, 2) == 0, 180 deg / Zp, 0 deg)"}],
["variable.set", {"name": "rTurn", "expr": "if(mod(Zp, 2) == 0, 180 deg / Zr, 0 deg)"}],
["variable.set", {"name": "tc", "expr": "max(3 mm, 2 * module)"}],
["variable.set", {"name": "zTop", "expr": "w + 0.5 mm + 2 * tc + 4 mm"}],
["variable.set", {"name": "jn", "expr": "backlash * cos(20 deg)"}],
["instance.add", {"source": "dist/planetary-gearbox.3dcraftjig", "body": "Ring", "name": "Ring", "params": {"moduleSize": "moduleSize", "N": "3", "Zs": "Zs", "Zr": "Zr", "w": "w", "backlash": "backlash"}}],
["instance.add", {"source": "dist/planetary-gearbox.3dcraftjig", "body": "Carrier", "name": "Carrier", "params": {"moduleSize": "moduleSize", "N": "3", "Zs": "Zs", "Zr": "Zr", "w": "w", "backlash": "backlash"}}],
["instance.add", {"source": "dist/planetary-gearbox.3dcraftjig", "body": "Sun", "name": "Sun", "params": {"moduleSize": "moduleSize", "N": "3", "Zs": "Zs", "Zr": "Zr", "w": "w", "backlash": "backlash"}}],
["instance.add", {"source": "dist/planetary-gearbox.3dcraftjig", "body": "Planet1", "name": "Planet1", "params": {"moduleSize": "moduleSize", "N": "3", "Zs": "Zs", "Zr": "Zr", "w": "w", "backlash": "backlash"}}],
["instance.add", {"source": "dist/planetary-gearbox.3dcraftjig", "body": "Planet2", "name": "Planet2", "params": {"moduleSize": "moduleSize", "N": "3", "Zs": "Zs", "Zr": "Zr", "w": "w", "backlash": "backlash"}}],
["instance.add", {"source": "dist/planetary-gearbox.3dcraftjig", "body": "Planet3", "name": "Planet3", "params": {"moduleSize": "moduleSize", "N": "3", "Zs": "Zs", "Zr": "Zr", "w": "w", "backlash": "backlash"}}],
["mate.add", {"kind": "fixed", "name": "RingHeld", "a": "world/z", "b": "Ring/F13:copy(0)/F6:startEdge(e15)", "angle": "rTurn", "flip": true}],
["mate.add", {"kind": "revolute", "name": "Output", "a": "world/z", "b": "Carrier/F23:between[F23:copy(1)/F22:face(0),F23:copy(1)/F22:face(2)]", "offset": "zTop", "flip": true}],
["mate.add", {"kind": "revolute", "name": "SunOnCarrier", "a": "Carrier/F23:between[F23:copy(1)/F22:face(0),F23:copy(1)/F22:face(2)]", "b": "Sun/F2:startEdge(e15)", "offset": "-zTop", "flip": true}],
["mate.add", {"kind": "revolute", "name": "Pin1", "a": "Carrier/F23:between[F23:copy(0)/F21:copy(1)/F20:copy(0)/F19:copy(1)/F17:face(0),F23:copy(0)/F21:copy(1)/F20:copy(0)/F19:copy(1)/F17:face(1)]", "b": "Planet1/F7:copy(0)/F4:startEdge(e15)", "angle": "pTurn + 0 * 360 deg / 3 * Zs / Zp", "flip": true}],
["mate.add", {"kind": "revolute", "name": "Pin2", "a": "Carrier/F23:between[F23:copy(0)/F21:copy(1,1,1)/F17:face(0),F23:copy(0)/F21:copy(1,1,1)/F17:face(1)]", "b": "Planet2/F8:copy(0)/F4:startEdge(e15)", "angle": "pTurn + 1 * 360 deg / 3 * Zs / Zp", "flip": true}],
["mate.add", {"kind": "revolute", "name": "Pin3", "a": "Carrier/F23:between[F23:copy(0)/F21:copy(1,2,1)/F17:face(0),F23:copy(0)/F21:copy(1,2,1)/F17:face(1)]", "b": "Planet3/F9:copy(0)/F4:startEdge(e15)", "angle": "pTurn + 2 * 360 deg / 3 * Zs / Zp", "flip": true}],
["coupling.add", {"kind": "gear", "name": "SunPlanet1", "mates": ["SunOnCarrier", "Pin1"], "value": "Zp / Zs"}],
["coupling.add", {"kind": "gear", "name": "PlanetRing1", "mates": ["Pin1", "Output"], "value": "Zr / Zp"}],
["coupling.add", {"kind": "gear", "name": "SunPlanet2", "mates": ["SunOnCarrier", "Pin2"], "value": "Zp / Zs"}],
["coupling.add", {"kind": "gear", "name": "PlanetRing2", "mates": ["Pin2", "Output"], "value": "Zr / Zp"}],
["coupling.add", {"kind": "gear", "name": "SunPlanet3", "mates": ["SunOnCarrier", "Pin3"], "value": "Zp / Zs"}],
["coupling.add", {"kind": "gear", "name": "PlanetRing3", "mates": ["Pin3", "Output"], "value": "Zr / Zp"}],
["variable.set", {"name": "t", "expr": "0"}],
["variable.set", {"name": "SunOnCarrier_angle", "expr": "360 deg * t"}],
["variable.measure", {"name": "p1x", "measure": "sectionCentroid", "of": "Planet1", "plane": "xy", "offset": "w / 2", "axis": "x"}],
["variable.measure", {"name": "p1y", "measure": "sectionCentroid", "of": "Planet1", "plane": "xy", "offset": "w / 2", "axis": "y"}],
["variable.output", {"name": "carrierTurn", "expr": "atan2(p1y, p1x)"}],
["variable.output", {"name": "willisError", "expr": "abs(atan2(sin(carrierTurn - SunOnCarrier_angle * Zs / Zr), cos(carrierTurn - SunOnCarrier_angle * Zs / Zr)))"}],
["assert.add", {"name": "Carrier turns as Willis' formula says (sun on housing / carrier = 1 + Zr / Zs)", "measure": "value", "expr": "willisError", "max": "0.01 deg"}],
["assert.add", {"name": "Sun and planet 1 mesh with the backlash (0.3 to 0.7 jn)", "measure": "clearance", "from": "Sun", "to": "Planet1", "min": "0.3 * jn", "max": "0.7 * jn"}],
["assert.add", {"name": "Planet 1 and the ring mesh with the backlash (0.3 to 0.7 jn)", "measure": "clearance", "from": "Planet1", "to": "Ring", "min": "0.3 * jn", "max": "0.7 * jn"}],
["assert.add", {"name": "No part overlaps another", "measure": "overlap", "of": ["Ring", "Carrier", "Sun", "Planet1", "Planet2", "Planet3"], "is": false}],
["document.info", {"title": "Planetary gearbox (assembly)", "description": "The planetary-gearbox Jig's sun, three planets, ring and carrier as an assembly: revolute joints, the meshes as gear couplings, the sun driven by the timeline t; Willis' formula and the backlash checked over the motion.", "author": "3DCraft Jigs", "licence": "CC-BY-4.0", "tags": ["assembly", "gears", "planetary", "motion"]}],
["assembly.pack", {}],
["file.save", {"path": "dist/planetary-gearbox.3dcraftasm"}]
]
