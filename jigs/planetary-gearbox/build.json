["variable.publish", {"name": "backlash", "label": "Backlash", "description": "Play between meshing teeth on the pitch circle; 0.1 to 0.2 mm for a 3D print", "group": "Size", "order": 2, "min": "0.05 mm", "max": "0.3 mm", "step": "0.01 mm", "unit": "mm"}],
["document.info", {"title": "Planetary gearbox", "description": "A planetary gear set with true involute teeth: a sun, 3 to 6 planets, an internal ring gear and a carrier with pins and an output shaft, each its own body. Choose the module, the sun's teeth and the ring's size among those that fit (outputs ringTeeth and planetTeeth); the planets' teeth are (ring - sun) / 2. Every ring offered keeps the set assemblable ((sun + ring) / planets whole), the planets clear of each other and the ring's tips clear of the planets' feet, and assertions check that on the model. Reduction with the ring held: 1 + ring / sun (variable ratio). Export STL or 3MF to print (choose the bodies), STEP for CAD.", "author": "Johan Coppens", "licence": "CC-BY-4.0", "url": "https://github.com/johancoppens/3dcraft-jigs/tree/main/jigs/planetary-gearbox", "tags": ["gear", "planetary", "epicyclic", "involute", "gearbox", "3D printing", "mechanism"]}],
["jig.export", {"path": "dist/planetary-gearbox.3dcraftjig"}]
]
