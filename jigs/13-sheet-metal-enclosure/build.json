"offset": "cover_plane_z"
}
],
[
"sketch.path",
{
"sketch": "Side vents",
"start": [
"((side_vent_flat_low + side_vent_flat_high) / 2) - ((side_vent_flat_low - side_vent_flat_high) / 2)",
"side_vent_y0 - vent_width / 2"
],
"closed": false,
"segments": [
{
"line": [
"((side_vent_flat_low + side_vent_flat_high) / 2) + ((side_vent_flat_low - side_vent_flat_high) / 2)",
"side_vent_y0 - vent_width / 2"
]
},
{
"arc": [
"((side_vent_flat_low + side_vent_flat_high) / 2) + ((side_vent_flat_low - side_vent_flat_high) / 2)",
"side_vent_y0 + vent_width / 2"
],
"center": [
"((side_vent_flat_low + side_vent_flat_high) / 2) + ((side_vent_flat_low - side_vent_flat_high) / 2)",
"side_vent_y0"
