"plane": "xy",
"offset": "cover_plane_z"
}
],
[
"sketch.path",
{
"sketch": "Top vents",
"start": [
"(top_vent_x0) + vent_width / 2",
"(top_vent_y0) - (top_vent_row_half)"
],
"closed": false,
"segments": [
{
"line": [
"(top_vent_x0) + vent_width / 2",
"(top_vent_y0) + (top_vent_row_half)"
]
},
{
"arc": [
"(top_vent_x0) - vent_width / 2",
"(top_vent_y0) + (top_vent_row_half)"
],
"center": [
"top_vent_x0",
"(top_vent_y0) + (top_vent_row_half)"
]
},
{
"line": [
"(top_vent_x0) - vent_width / 2",
"(top_vent_y0) - (top_vent_row_half)"
]
},
{
"arc": "start",
"center": [
"top_vent_x0",
"(top_vent_y0) - (top_vent_row_half)"
]
}
]
}
],
[
"sketch.pattern",
{
"sketch": "Top vents",
"entities": [
