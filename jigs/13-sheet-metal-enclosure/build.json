"variable.set",
{
"name": "board_width",
"expr": "160 mm"
}
],
[
"variable.set",
{
"name": "board_depth",
"expr": "100 mm"
}
],
[
"variable.set",
{
"name": "tallest_part",
"expr": "25 mm"
}
],
[
"variable.set",
{
"name": "board_count",
"expr": "1"
}
],
[
"variable.set",
{
"name": "standoff_height",
"expr": "8 mm"
}
],
[
"variable.set",
{
"name": "room_around",
"expr": "10 mm"
}
],
[
"variable.set",
{
"name": "hole_inset",
"expr": "4 mm"
}
],
[
"variable.set",
{
"name": "material",
"expr": "1"
}
],
[
"variable.set",
{
"name": "sheet_choice",
"expr": "2"
}
],
[
"variable.set",
{
"name": "connector_count",
"expr": "3"
}
],
[
"variable.set",
{
"name": "connector_diameter",
"expr": "12 mm"
}
],
[
"variable.set",
{
"name": "vents",
"expr": "3"
}
],
[
"variable.set",
{
"name": "board_thickness",
"expr": "1.6 mm"
}
],
[
"variable.set",
{
"name": "stack_gap",
"expr": "3 mm"
}
],
[
"variable.set",
{
"name": "head_room",
"expr": "2 mm"
}
],
[
"variable.set",
{
"name": "cover_fit",
"expr": "0.5 mm"
}
],
[
"variable.set",
{
"name": "sheet_thickness",
"expr": "sheet_stock[sheet_choice].gauge"
}
],
[
"variable.set",
{
"name": "die_opening",
"expr": "if(material == 3, sheet_stock[sheet_choice].vee_stainless, sheet_stock[sheet_choice].vee_plain)"
}
],
[
"variable.set",
{
"name": "leg_minimum",
"expr": "if(material == 3, sheet_stock[sheet_choice].leg_stainless, sheet_stock[sheet_choice].leg_plain)"
}
],
[
"variable.set",
{
"name": "shop_radius",
"expr": "if(material == 1, sheet_stock[sheet_choice].radius_steel, if(material == 2, sheet_stock[sheet_choice].radius_aluminium, sheet_stock[sheet_choice].radius_stainless))"
}
],
[
"variable.set",
{
"name": "minimum_radius",
"expr": "if(sheet_thickness <= 1.5 mm, materials[material].min_radius_thin, materials[material].min_radius_thick) * sheet_thickness"
}
],
[
"variable.set",
{
"name": "inner_radius",
"expr": "max(shop_radius, minimum_radius)"
}
],
[
"variable.set",
{
"name": "k_factor",
"expr": "materials[material].k_tight + (materials[material].k_open - materials[material].k_tight) * max(0, min(1, (inner_radius / sheet_thickness - 0.5) / 1.5))"
}
],
[
"variable.set",
{
"name": "bend_allowance",
"expr": "pi / 2 * (inner_radius + k_factor * sheet_thickness)"
}
],
[
"variable.set",
{
"name": "hole_edge_minimum",
"expr": "max(2.5 * sheet_thickness + inner_radius, leg_minimum)"
}
],
[
"variable.set",
{
"name": "relief_size",
"expr": "inner_radius + sheet_thickness + 0.5 mm"
}
],
[
"variable.set",
{
"name": "fastener_row",
"expr": "if(sheet_thickness >= 2 mm, 2, 1)"
}
],
[
"variable.set",
{
"name": "shank_diameter",
"expr": "fasteners[fastener_row].shank_diameter"
}
],
[
"variable.set",
{
"name": "clearance_hole",
"expr": "fasteners[fastener_row].clearance_hole"
}
],
[
"variable.set",
{
"name": "mount_hole",
"expr": "fasteners[1].clearance_hole"
}
],
[
"variable.set",
{
"name": "nut_hole",
"expr": "fasteners[fastener_row].nut_hole"
}
],
[
"variable.set",
{
"name": "nut_height",
"expr": "fasteners[fastener_row].nut_height"
}
],
[
"variable.set",
{
"name": "nut_width",
"expr": "fasteners[fastener_row].nut_width"
}
],
[
"variable.set",
{
"name": "head_diameter",
"expr": "fasteners[fastener_row].head_diameter"
}
],
[
"variable.set",
{
"name": "head_height",
"expr": "fasteners[fastener_row].head_height"
}
],
[
"variable.set",
{
"name": "stack_pitch",
"expr": "board_thickness + tallest_part + stack_gap"
}
],
[
"variable.set",
{
"name": "content_height",
"expr": "standoff_height + board_count * (board_thickness + tallest_part) + (board_count - 1) * stack_gap"
}
],
[
"variable.set",
{
"name": "room_used",
"expr": "max(room_around, inner_radius + 1 mm, hole_edge_minimum + inner_radius + mount_hole / 2 - hole_inset)"
}
],
[
"variable.set",
{
"name": "inside_width",
"expr": "board_width + 2 * room_used"
}
],
[
"variable.set",
{
"name": "inside_depth",
"expr": "board_depth + 2 * room_used"
}
],
[
"variable.set",
{
"name": "return_length",
"expr": "2 * hole_edge_minimum + nut_hole + 1 mm"
}
],
[
"variable.set",
{
"name": "inside_height_floor",
"expr": "sheet_thickness + 2 * inner_radius + max(2 * hole_edge_minimum + 6 mm, return_length + inner_radius + 10 mm)"
}
],
[
"variable.set",
{
"name": "inside_height",
"expr": "max(content_height + head_room + nut_height + sheet_thickness, inside_height_floor)"
}
],
[
"variable.set",
{
"name": "floor_half_width",
"expr": "inside_width / 2"
}
],
[
"variable.set",
{
"name": "floor_half_depth",
"expr": "inside_depth / 2 - inner_radius"
}
],
[
"variable.set",
{
"name": "wall_length",
"expr": "inside_height - sheet_thickness - 2 * inner_radius"
}
],
[
"variable.set",
{
"name": "return_half_span",
"expr": "floor_half_width - relief_size - max(2 mm, 2 * sheet_thickness)"
}
],
[
"variable.set",
{
"name": "screw_margin",
"expr": "max(8 mm, hole_edge_minimum + inner_radius + clearance_hole)"
}
],
[
"variable.set",
{
"name": "screw_span",
"expr": "2 * (return_half_span - screw_margin)"
}
],
[
"variable.set",
{
"name": "screw_count",
"expr": "max(2, floor(screw_span / (100 mm)) + 2)"
}
],
[
"variable.set",
{
"name": "screw_step",
"expr": "screw_span / (screw_count - 1)"
}
],
[
"variable.set",
{
"name": "screw_y",
"expr": "inside_depth / 2 - inner_radius - return_length / 2"
}
],
[
"variable.set",
{
"name": "connector_pitch",
"expr": "connector_diameter + 14 mm"
}
],
[
"variable.set",
{
"name": "connector_x0",
"expr": "-(max(connector_count, 1) - 1) * connector_pitch / 2"
}
],
[
"variable.set",
{
"name": "connector_flat_y",
"expr": "floor_half_depth + bend_allowance + wall_length / 2"
}
],
[
"variable.set",
{
"name": "connector_row_limit",
"expr": "2 * (floor_half_width - relief_size - hole_edge_minimum) - connector_diameter"
}
],
[
"variable.set",
{
"name": "connector_max",
"expr": "max(0, min(8, floor(connector_row_limit / connector_pitch) + 1))"
}
],
[
"variable.set",
{
"name": "cover_plane_z",
"expr": "sheet_thickness + inside_height"
}
],
[
"variable.set",
{
"name": "cover_half_width",
"expr": "inside_width / 2 + cover_fit - inner_radius"
}
],
[
"variable.set",
{
"name": "cover_half_depth",
"expr": "inside_depth / 2 + sheet_thickness"
}
],
[
"variable.set",
{
"name": "skirt_length",
"expr": "cover_plane_z - inner_radius"
}
],
[
"variable.set",
{
"name": "vent_width",
"expr": "max(4 mm, 2 * sheet_thickness)"
}
],
[
"variable.set",
{
"name": "vent_pitch",
"expr": "2 * vent_width + 2 mm"
}
],
[
"variable.set",
{
"name": "top_vent_zone",
"expr": "2 * (cover_half_width - hole_edge_minimum) - vent_width"
}
],
[
"variable.set",
{
"name": "top_vent_count",
"expr": "max(1, floor(top_vent_zone / vent_pitch) + 1)"
}
],
[
"variable.set",
{
"name": "top_vent_x0",
"expr": "-(top_vent_count - 1) * vent_pitch / 2"
}
],
[
"variable.set",
{
"name": "top_vent_half",
"expr": "inside_depth / 2 - inner_radius - return_length - hole_edge_minimum"
}
],
[
"variable.set",
{
"name": "side_vent_count",
"expr": "max(1, floor((2 * (cover_half_depth - 2 * vent_width) - vent_width) / vent_pitch) + 1)"
}
],
[
"variable.set",
{
"name": "side_vent_y0",
"expr": "-(side_vent_count - 1) * vent_pitch / 2"
}
],
[
"variable.set",
{
"name": "side_vent_low",
"expr": "sheet_thickness + 3 mm + vent_width / 2"
}
],
[
"variable.set",
{
"name": "side_vent_high",
"expr": "min(side_vent_low + 28 mm, cover_plane_z - inner_radius - hole_edge_minimum - vent_width / 2 - 1 mm)"
}
],
[
"variable.set",
{
"name": "vent_bridge",
"expr": "vent_pitch - vent_width"
}
],
[
"variable.set",
{
"name": "top_vent_length",
"expr": "2 * top_vent_half + vent_width"
}
],
[
"variable.set",
{
"name": "top_vent_rows",
"expr": "max(1, ceil((top_vent_length + vent_bridge) / (13 * vent_bridge + vent_width)))"
}
],
[
"variable.set",
{
"name": "top_vent_outer",
"expr": "(top_vent_length - (top_vent_rows - 1) * vent_bridge) / top_vent_rows"
}
],
[
"variable.set",
{
"name": "top_vent_row_half",
"expr": "(top_vent_outer - vent_width) / 2"
}
],
[
"variable.set",
{
"name": "top_vent_y0",
"expr": "-(top_vent_rows - 1) * (top_vent_outer + vent_bridge) / 2"
}
],
[
"variable.set",
{
"name": "top_vents_on",
"expr": "if(vents >= 2, if(top_vent_half > 6 mm, if(top_vent_zone > 0 mm, 1, 0), 0), 0)"
}
],
[
"variable.set",
{
"name": "side_vents_on",
"expr": "if(vents == 3, if(side_vent_high > side_vent_low + 6 mm, 1, 0), 0)"
}
],
[
"variable.set",
{
"name": "side_vent_flat_low",
"expr": "cover_half_width + bend_allowance + (cover_plane_z - inner_radius - side_vent_low)"
}
],
[
"variable.set",
{
"name": "side_vent_flat_high",
"expr": "cover_half_width + bend_allowance + (cover_plane_z - inner_radius - side_vent_high)"
}
],
[
"variable.set",
{
"name": "mount_x",
"expr": "board_width / 2 - hole_inset"
}
],
[
"variable.set",
{
"name": "mount_y",
"expr": "board_depth / 2 - hole_inset"
}
],
[
"variable.set",
{
"name": "foot_x",
"expr": "mount_x - 11 mm"
}
],
[
"variable.set",
{
"name": "foot_y",
"expr": "mount_y"
}
],
