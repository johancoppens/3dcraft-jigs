["document.info", {"title": "Electronics enclosure", "description": "A box for a circuit board with a lid: set the board's size and its mounting holes (standoffs for M2 to M3 screws or heat-set inserts), the room above it, the walls and two port cut-outs (USB-C, micro-USB, DC jack, toggle or slide switch) on any side. The lid screws onto corner posts or snaps in. Box and lid are laid out side by side to print, the lid upside down. Export it with File > Export... (STL or 3MF).", "author": "Johan Coppens", "licence": "CC-BY-4.0", "url": "https://github.com/johancoppens/3dcraft-jigs/tree/main/jigs/electronics-enclosure", "tags": ["enclosure", "electronics", "PCB", "box", "3D printing"]}],
