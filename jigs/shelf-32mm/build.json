["document.info", {"title": "32 mm shelf system (IKEA compatible)", "description": "A bookcase or wardrobe carcass on the European 32 mm system: the sides drilled for 5 mm shelf pins on a 32 mm pitch, 37 mm from the front and the back edge, so IKEA-compatible shelf pins and fittings fit. Choose a real IKEA carcass size (BILLY, PAX) or your own, the panel thickness, adjustable shelves, a fixed middle shelf, a back in a groove or a rebate and a plinth. To cut it: File > Export..., DXF or SVG with the face set \"Cut sheet\" (every panel, the sides with their holes and back slot) or \"Side drilling\" (one side, a drilling template). IKEA is a trademark of Inter IKEA Systems B.V.; this Jig is not affiliated with or endorsed by IKEA.", "author": "Johan Coppens", "licence": "CC-BY-4.0", "url": "https://github.com/johancoppens/3dcraft-jigs/tree/main/jigs/shelf-32mm", "tags": ["furniture", "cabinet", "bookcase", "32 mm system", "CNC", "woodworking"]}],
["jig.export", {"path": "dist/shelf-32mm.3dcraftjig"}]
