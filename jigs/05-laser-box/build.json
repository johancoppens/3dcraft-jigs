["variable.set", {"name": "expected_inside_depth", "expr": "if(size_basis == 1, depth, depth - 2*sheet_thickness)"}],
["variable.set", {"name": "expected_inside_height", "expr": "if(size_basis == 1, height, height - sheet_thickness - 2*has_lid*sheet_thickness)"}],
["variable.set", {"name": "cut_length", "expr": "2*((2*(outer_width+wall_height) + sheet_thickness*(finger_count_wide+1) + 2*sheet_thickness*(finger_count_high-1))+8*beam_offset)+if(lid_style == 4, (pi-2)*thumb_radius, 0 mm)+2*((2*(outer_depth+wall_height) + sheet_thickness*(finger_count_deep-3) + 2*sheet_thickness*(finger_count_high-3))+8*beam_offset)+((2*(outer_width+outer_depth) + 2*sheet_thickness*(finger_count_wide-1) + 2*sheet_thickness*(finger_count_deep-1))+8*beam_offset)+mortise_count_across*2*((tab_length_wide - 2 * beam_offset)+mortise_width)+mortise_count_along*2*((tab_length_deep - 2 * beam_offset)+mortise_width)+has_lid*(2*(outer_width+outer_depth)-8*lid_corner_radius+2*pi*lid_corner_radius+2*pi*beam_offset+2*((outer_width-sheet_thickness-lid_gap)-(sheet_thickness+lid_gap)+(outer_depth-sheet_thickness-lid_gap)-(sheet_thickness+lid_gap))+8*beam_offset+2*((outer_width-sheet_thickness-lid_gap-frame_rail)-(sheet_thickness+lid_gap+frame_rail)+(outer_depth-sheet_thickness-lid_gap-frame_rail)-(sheet_thickness+lid_gap+frame_rail))-8*beam_offset+if(lid_style == 2, pi*(round_grip_diameter-2*beam_offset), if(lid_style == 3, 2*(slot_grip_length-slot_grip_width)+pi*(slot_grip_width-2*beam_offset), 0 mm)))+(compartments_deep-1)*(2*((outer_width-sheet_thickness-divider_gap/2)-(sheet_thickness+divider_gap/2)+divider_height)+8*beam_offset+2*(compartments_wide-1)*slot_depth+2*sheet_thickness*tab_count_wide)+(compartments_wide-1)*(2*((outer_depth-sheet_thickness-divider_gap/2)-(sheet_thickness+divider_gap/2)+divider_height)+8*beam_offset+2*(compartments_deep-1)*slot_depth+2*sheet_thickness*tab_count_deep)"}],
["variable.measure", {"name": "measured_inside_width", "measure": "distance", "from": "Left side", "to": "Right side", "label": "Inside width", "unit": "mm"}],
["variable.measure", {"name": "measured_box_depth", "measure": "extent", "of": "Left side", "axis": "y", "label": "Measured: box depth over the side panel", "unit": "mm"}],
["variable.output", {"name": "measured_inside_depth", "expr": "measured_box_depth - 2*sheet_thickness - 2*beam_offset", "label": "Inside depth", "unit": "mm"}],
["variable.measure", {"name": "measured_floor_to_rim", "measure": "distance", "from": {"kind": "face", "where": {"in": "Bottom", "name": "*endCap*"}}, "to": {"kind": "face", "where": {"in": "Back", "name": "*offset(e33))"}}, "label": "Measured: floor to rim", "unit": "mm"}],
["variable.output", {"name": "inside_height", "expr": "measured_floor_to_rim - beam_offset - has_lid*sheet_thickness", "label": "Inside height (floor to lid frame, or to the rim of a tray)", "unit": "mm"}],
["variable.output", {"name": "inside_volume", "expr": "measured_inside_width*measured_inside_depth*inside_height", "label": "Inside volume", "unit": "cm^3"}],
["variable.output", {"name": "compartment_width", "expr": "divider_pitch_wide - sheet_thickness", "label": "Compartment width, clear", "unit": "mm"}],
["variable.output", {"name": "compartment_depth", "expr": "divider_pitch_deep - sheet_thickness", "label": "Compartment depth, clear", "unit": "mm"}],
["variable.output", {"name": "fingers_along_width", "expr": "finger_count_wide", "label": "Fingers along the width"}],
["variable.output", {"name": "fingers_along_depth", "expr": "finger_count_deep", "label": "Fingers along the depth"}],
["variable.output", {"name": "fingers_up_the_corner", "expr": "finger_count_high", "label": "Fingers up the corners"}],
["variable.output", {"name": "actual_finger_width", "expr": "min(finger_pitch_wide,finger_pitch_deep,finger_pitch_high)", "label": "Smallest finger as cut", "unit": "mm"}],
["variable.output", {"name": "parts_to_cut", "expr": "parts_count", "label": "Parts to cut"}],
["variable.output", {"name": "total_cut_length", "expr": "cut_length", "label": "Total cut length", "unit": "m"}],
["variable.measure", {"name": "total_material_volume", "measure": "volume", "label": "Material volume"}],
["variable.output", {"name": "box_mass", "expr": "total_material_volume*680 kg/(1 m^3)", "label": "Mass (birch plywood)", "unit": "g"}],
["assert.add", {"name": "Back panel symmetric: odd finger count along the width", "measure": "symmetric", "of": "Back", "plane": {"point": ["outer_width/2", "0 mm", "0 mm"], "normal": [1, 0, 0]}, "is": true, "tol": "0.01 mm"}],
["assert.add", {"name": "Side panel symmetric: odd finger count along the depth", "measure": "symmetric", "of": "Left side", "plane": {"point": ["0 mm", "outer_depth/2", "0 mm"], "normal": [0, 1, 0]}, "is": true, "tol": "0.01 mm"}],
["assert.add", {"name": "Finger along the width at least the sheet", "measure": "distance", "from": {"kind": "face", "where": {"in": "Back", "name": "*offset(e5))"}}, "to": {"kind": "face", "where": {"in": "Back", "name": "*offset(e9))"}}, "min": "sheet_thickness-2*beam_offset"}],
["assert.add", {"name": "Finger up the corners at least the sheet", "measure": "distance", "from": {"kind": "face", "where": {"in": "Back", "name": "*offset(e24))"}}, "to": {"kind": "face", "where": {"in": "Back", "name": "*offset(e28))"}}, "min": "sheet_thickness-2*beam_offset"}],
["assert.add", {"name": "Finger along the depth at least the sheet", "measure": "distance", "from": {"kind": "face", "where": {"in": "Bottom", "name": "*offset(e20))"}}, "to": {"kind": "face", "where": {"in": "Bottom", "name": "*offset(e24))"}}, "min": "sheet_thickness-2*beam_offset"}],
["assert.add", {"name": "Back panel in closed form", "measure": "volume", "of": "Back", "eq": "front_panel_volume", "tol": "0.5"}],
["assert.add", {"name": "Side panel in closed form", "measure": "volume", "of": "Right side", "eq": "side_panel_volume", "tol": "0.5"}],
["assert.add", {"name": "Bottom panel in closed form, mortises included", "measure": "volume", "of": "Bottom", "eq": "bottom_panel_volume", "tol": "0.5"}],
["assert.add", {"name": "Inside width as asked", "measure": "value", "expr": "measured_inside_width", "eq": "expected_inside_width", "tol": "0.001 mm"}],
["assert.add", {"name": "Inside depth as asked", "measure": "value", "expr": "measured_inside_depth", "eq": "expected_inside_depth", "tol": "0.001 mm"}],
["assert.add", {"name": "Inside height as asked", "measure": "value", "expr": "inside_height", "eq": "expected_inside_height", "tol": "0.001 mm"}],
["assert.add", {"name": "Inside volume in closed form", "measure": "value", "expr": "inside_volume", "eq": "expected_inside_width*expected_inside_depth*expected_inside_height", "tol": "1"}],
["assert.add", {"name": "Locating frame fits inside the walls with its gap", "measure": "extent", "of": "Lid frame", "axis": "x", "eq": "inner_width-2*lid_gap+2*beam_offset", "tol": "0.001 mm", "when": "has_lid"}],
["assert.add", {"name": "Dividers clear the lid frame", "measure": "distance", "from": {"kind": "body", "where": {"name": "Divider*"}}, "to": "Lid frame", "min": "0.45 mm - beam_offset", "when": "has_lid && (compartments_wide > 1 || compartments_deep > 1)"}],
["assert.add", {"name": "Slot in the across divider at least the sheet", "measure": "distance", "from": {"kind": "face", "where": {"in": "Divider across 1", "name": "*:side(e5)"}}, "to": {"kind": "face", "where": {"in": "Divider across 1", "name": "*:side(e8)"}}, "min": "sheet_thickness-2*beam_offset", "when": "compartments_deep >= 2 && compartments_wide >= 2"}],
["assert.add", {"name": "Slot in the along divider at least the sheet", "measure": "distance", "from": {"kind": "face", "where": {"in": "Divider along 1", "name": "*:side(e5)"}}, "to": {"kind": "face", "where": {"in": "Divider along 1", "name": "*:side(e8)"}}, "min": "sheet_thickness-2*beam_offset", "when": "compartments_deep >= 2 && compartments_wide >= 2"}],
["assert.add", {"name": "Floor mortise at least the sheet", "measure": "distance", "from": {"kind": "face", "where": {"in": "Bottom", "name": "*:side(e3)"}}, "to": {"kind": "face", "where": {"in": "Bottom", "name": "*:side(e7)"}}, "min": "sheet_thickness-2*beam_offset", "when": "compartments_deep >= 2 || compartments_wide >= 2"}],
["assert.add", {"name": "Divider tabs reach through the floor", "measure": "boxMin", "of": {"kind": "body", "where": {"name": "Divider*"}}, "axis": "z", "max": "0.001 mm - beam_offset", "when": "compartments_deep >= 2 || compartments_wide >= 2"}],
