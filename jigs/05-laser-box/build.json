["document.info", {"title": "Laser-cut box", "description": "A finger-jointed box from plywood sheet, sized from what goes in it or where it must fit, with compartments tabbed through the floor and a lid that stays put. Set your sheet's measured thickness and your laser's kerf. To cut it, File > Export..., choose DXF or SVG and the face set \"Cut sheet\" (or cut.export with copies); set the sheet width to your bed: every part once, true size, kerf and joint fit already in the outlines.", "author": "3DCraft Jigs", "licence": "CC-BY-4.0", "tags": ["laser cutting", "finger joint", "box", "plywood", "kerf"]}],
