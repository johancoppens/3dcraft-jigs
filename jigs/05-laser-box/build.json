["assert.add", {"name": "Compartments deep enough for a finger", "measure": "distance", "from": {"kind": "face", "where": {"in": "Front", "name": "*endCap*"}}, "to": {"kind": "body", "where": {"name": "Divider across 1"}}, "min": "min_compartment", "when": "compartments_deep >= 2"}],
["assert.add", {"name": "Compartments wide enough for a finger", "measure": "distance", "from": "Left side", "to": {"kind": "body", "where": {"name": "Divider along 1"}}, "min": "min_compartment", "when": "compartments_wide >= 2"}],
["assert.add", {"name": "Parts to cut", "measure": "count", "of": {"kind": "body"}, "eq": "parts_count"}],
["assert.add", {"name": "Cut sheet has every part once", "measure": "count", "of": {"set": "Cut sheet"}, "eq": "parts_count"}],
["variable.publish", {"name": "size_basis", "label": "Sizes are measured", "group": "Size", "order": 1, "kind": "choice", "choices": ["Inside: what goes in the box", "Outside: where the box must fit"], "description": "Choose whether width, depth and height are the room inside the box or the box's outside size"}],
["variable.publish", {"name": "width", "label": "Width", "group": "Size", "order": 2, "min": "max(50 mm, min_inner_width_for_grip + if(size_basis == 2, 2*sheet_thickness, 0 mm))", "max": "400 mm", "step": "1 mm", "unit": "mm", "description": "Along the front, inside or outside as chosen above; a lid with a hole or a slot needs room for a fingertip in the lid frame"}],
["variable.publish", {"name": "depth", "label": "Depth", "group": "Size", "order": 3, "min": "max(50 mm, min_inner_depth_for_grip + if(size_basis == 2, 2*sheet_thickness, 0 mm))", "max": "400 mm", "step": "1 mm", "unit": "mm", "description": "Front to back, inside or outside as chosen above"}],
["variable.publish", {"name": "height", "label": "Height (inside: floor to lid frame; outside: whole box)", "group": "Size", "order": 4, "min": "15 mm + 5*sheet_thickness", "max": "250 mm", "step": "1 mm", "unit": "mm", "description": "Inside: from the floor to the underside of the lid's frame, or the rim of an open tray. Outside: the whole box, lid included"}],
["variable.publish", {"name": "sheet_thickness", "label": "Sheet thickness, measured", "group": "Sheet and laser", "order": 5, "min": "1.5 mm", "max": "6 mm", "step": "0.05 mm", "unit": "mm", "description": "Measure your sheet with calipers: 3 mm plywood is rarely exactly 3 mm, and every joint follows this"}],
["variable.publish", {"name": "kerf", "label": "Laser kerf", "group": "Sheet and laser", "order": 6, "min": "0 mm", "max": "0.4 mm", "step": "0.01 mm", "unit": "mm", "description": "The width your beam burns away; every outline is moved out by half of it, so the part comes out true size"}],
["variable.publish", {"name": "joint_fit", "label": "Joint fit", "group": "Sheet and laser", "order": 7, "kind": "choice", "choicesFrom": "joint_fits", "description": "How the fingers should go together: press fit needs no glue but a test cut, loose fit goes together by hand"}],
["variable.publish", {"name": "finger_width", "label": "Finger width", "group": "Joints", "order": 8, "min": "2*sheet_thickness", "max": "40 mm", "step": "0.5 mm", "unit": "mm", "description": "The wanted finger width; every edge gets the nearest odd number of equal fingers, so the real width is close to it (see the outputs)"}],
["variable.publish", {"name": "compartments_wide", "label": "Compartments across", "group": "Compartments", "order": 9, "kind": "integer", "min": "1", "max": "min(4, floor((inner_width + sheet_thickness) / (min_compartment + sheet_thickness)))", "step": "1", "description": "How many compartments side by side, at most 4 and each at least 30 mm clear; more than one adds dividers with tabs through the floor"}],
