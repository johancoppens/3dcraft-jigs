[
["table.set", {"name": "joint_fits", "columns": ["fit", {"name": "clearance", "unit": "mm"}], "rows": [["Press fit, no glue", 0], ["Snug fit, glued", 0.05], ["Loose fit, hand assembled", 0.1]]}],
["variable.set", {"name": "size_basis", "expr": "1"}],
["variable.set", {"name": "width", "expr": "180 mm"}],
["variable.set", {"name": "depth", "expr": "120 mm"}],
["variable.set", {"name": "height", "expr": "60 mm"}],
["variable.set", {"name": "sheet_thickness", "expr": "3 mm"}],
["variable.set", {"name": "kerf", "expr": "0.15 mm"}],
["variable.set", {"name": "joint_fit", "expr": "2"}],
["variable.set", {"name": "finger_width", "expr": "12 mm"}],
["variable.set", {"name": "compartments_wide", "expr": "3"}],
["variable.set", {"name": "compartments_deep", "expr": "2"}],
["variable.set", {"name": "lid_style", "expr": "2"}],
["variable.set", {"name": "lid_open", "expr": "70"}],
["variable.set", {"name": "has_lid", "expr": "if(lid_style > 1, 1, 0)"}],
["variable.set", {"name": "outer_width", "expr": "if(size_basis == 1, width + 2 * sheet_thickness, width)"}],
["variable.set", {"name": "outer_depth", "expr": "if(size_basis == 1, depth + 2 * sheet_thickness, depth)"}],
["variable.set", {"name": "wall_height", "expr": "if(size_basis == 1, height + sheet_thickness + has_lid * sheet_thickness, height - has_lid * sheet_thickness)"}],
["variable.set", {"name": "inner_width", "expr": "outer_width - 2 * sheet_thickness"}],
["variable.set", {"name": "inner_depth", "expr": "outer_depth - 2 * sheet_thickness"}],
["variable.set", {"name": "inner_height", "expr": "wall_height - sheet_thickness - has_lid * sheet_thickness"}],
["variable.set", {"name": "span_high", "expr": "wall_height - sheet_thickness"}],
["variable.set", {"name": "finger_count_wide", "expr": "max(3, 2 * round((inner_width / finger_width - 1) / 2) + 1)"}],
["variable.set", {"name": "finger_count_deep", "expr": "max(3, 2 * round((inner_depth / finger_width - 1) / 2) + 1)"}],
["variable.set", {"name": "finger_count_high", "expr": "max(3, 2 * round((span_high / finger_width - 1) / 2) + 1)"}],
["variable.set", {"name": "finger_pitch_wide", "expr": "inner_width / finger_count_wide"}],
["variable.set", {"name": "finger_pitch_deep", "expr": "inner_depth / finger_count_deep"}],
["variable.set", {"name": "finger_pitch_high", "expr": "span_high / finger_count_high"}],
["variable.set", {"name": "fit_clearance", "expr": "joint_fits[joint_fit].clearance"}],
["variable.set", {"name": "beam_offset", "expr": "(kerf - fit_clearance) / 2"}],
["variable.set", {"name": "divider_gap", "expr": "0.4 mm"}],
["variable.set", {"name": "divider_height", "expr": "inner_height - 0.5 mm"}],
["variable.set", {"name": "divider_slot", "expr": "sheet_thickness + divider_gap"}],
["variable.set", {"name": "slot_depth", "expr": "divider_height / 2 + 0.2 mm"}],
["variable.set", {"name": "divider_pitch_wide", "expr": "(inner_width + sheet_thickness) / compartments_wide"}],
["variable.set", {"name": "divider_pitch_deep", "expr": "(inner_depth + sheet_thickness) / compartments_deep"}],
["variable.set", {"name": "min_compartment", "expr": "30 mm"}],
["variable.set", {"name": "tab_count_wide", "expr": "max(2, compartments_wide)"}],
["variable.set", {"name": "tab_count_deep", "expr": "max(2, compartments_deep)"}],
["variable.set", {"name": "tab_pitch_wide", "expr": "divider_pitch_wide * compartments_wide / tab_count_wide"}],
["variable.set", {"name": "tab_pitch_deep", "expr": "divider_pitch_deep * compartments_deep / tab_count_deep"}],
["variable.set", {"name": "tab_length_wide", "expr": "min(tab_pitch_wide / 3, 30 mm)"}],
["variable.set", {"name": "tab_length_deep", "expr": "min(tab_pitch_deep / 3, 30 mm)"}],
["variable.set", {"name": "mortise_width", "expr": "sheet_thickness + 2 * fit_clearance - kerf"}],
["variable.set", {"name": "divider_top", "expr": "sheet_thickness + divider_height"}],
["variable.set", {"name": "lid_gap", "expr": "0.3 mm"}],
["variable.set", {"name": "lid_corner_radius", "expr": "min(4 mm, inner_width / 12)"}],
["variable.set", {"name": "frame_rail", "expr": "clamp(2.5 * sheet_thickness, 6 mm, 12 mm)"}],
["variable.set", {"name": "fingertip_width", "expr": "18 mm"}],
["variable.set", {"name": "grip_margin", "expr": "3 mm"}],
["variable.set", {"name": "grip_room_wide", "expr": "inner_width - 2 * lid_gap - 2 * frame_rail - 2 * grip_margin"}],
["variable.set", {"name": "grip_room_deep", "expr": "inner_depth - 2 * lid_gap - 2 * frame_rail - 2 * grip_margin"}],
["variable.set", {"name": "round_grip_diameter", "expr": "min(22 mm, grip_room_wide, grip_room_deep)"}],
["variable.set", {"name": "slot_grip_width", "expr": "min(22 mm, grip_room_deep, grip_room_wide / 1.5)"}],
["variable.set", {"name": "slot_grip_length", "expr": "min(2.5 * slot_grip_width, grip_room_wide)"}],
["variable.set", {"name": "min_inner_width_for_grip", "expr": "if(lid_style == 2, fingertip_width, if(lid_style == 3, 1.5 * fingertip_width, 0 mm)) + if(lid_style == 2 || lid_style == 3, 2 * lid_gap + 2 * frame_rail + 2 * grip_margin, 0 mm)"}],
["variable.set", {"name": "min_inner_depth_for_grip", "expr": "if(lid_style == 2 || lid_style == 3, fingertip_width + 2 * lid_gap + 2 * frame_rail + 2 * grip_margin, 0 mm)"}],
["variable.set", {"name": "thumb_radius", "expr": "clamp(wall_height / 4, 6 mm, 12 mm)"}],
["variable.set", {"name": "lid_lift", "expr": "lid_open / 100 * (0.75 * outer_depth + 20 mm)"}],
["variable.set", {"name": "lid_slide", "expr": "lid_open / 100 * 0.4 * outer_depth"}],
