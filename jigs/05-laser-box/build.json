["variable.set", {"name": "front_panel_volume", "expr": "sheet_thickness*((outer_width*wall_height - sheet_thickness*finger_pitch_wide*(finger_count_wide+1)/2 - sheet_thickness*finger_pitch_high*(finger_count_high-1))+(2*(outer_width+wall_height) + sheet_thickness*(finger_count_wide+1) + 2*sheet_thickness*(finger_count_high-1))*beam_offset+4*beam_offset^2)"}],
["variable.set", {"name": "side_panel_volume", "expr": "sheet_thickness*((outer_depth*wall_height - sheet_thickness*(outer_depth-finger_pitch_deep*(finger_count_deep-1)/2) - 2*sheet_thickness*(span_high-finger_pitch_high*(finger_count_high-1)/2))+(2*(outer_depth+wall_height) + sheet_thickness*(finger_count_deep-3) + 2*sheet_thickness*(finger_count_high-3))*beam_offset+4*beam_offset^2)"}],
["variable.set", {"name": "bottom_panel_volume", "expr": "sheet_thickness*((outer_width*outer_depth - 4*sheet_thickness^2 - sheet_thickness*finger_pitch_wide*(finger_count_wide-1) - sheet_thickness*finger_pitch_deep*(finger_count_deep-1))+(2*(outer_width+outer_depth) + 2*sheet_thickness*(finger_count_wide-1) + 2*sheet_thickness*(finger_count_deep-1))*beam_offset+4*beam_offset^2-mortise_area)"}],
["variable.set", {"name": "parts_count", "expr": "5 + 2*has_lid + (compartments_wide - 1) + (compartments_deep - 1)"}],
