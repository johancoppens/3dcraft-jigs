"variable.set",
{
"name": "housing_radius",
"expr": "housing_diameter / 2"
}
],
[
"variable.set",
{
"name": "teeth_step",
"expr": "if(mod(planet_count, 2) == 0, planet_count, 2 * planet_count)"
}
],
[
"variable.set",
{
"name": "ring_teeth_fit",
"expr": "min(125, floor((housing_diameter - 2 * wall_min - 3 * tooth_module) / tooth_module))"
}
],
[
"variable.set",
{
"name": "total_teeth",
"expr": "teeth_step * floor(ring_teeth_fit * reduction / (reduction - 1) / teeth_step)"
}
],
[
"variable.set",
{
"name": "sun_teeth",
"expr": "round(total_teeth / reduction)"
}
],
[
"variable.set",
{
"name": "planet_teeth",
"expr": "total_teeth / 2 - sun_teeth"
}
],
[
"variable.set",
{
"name": "ring_teeth",
"expr": "total_teeth - sun_teeth"
}
],
[
"variable.set",
{
"name": "ratio_actual",
"expr": "total_teeth / sun_teeth"
}
],
[
"variable.set",
{
"name": "center_distance",
"expr": "tooth_module * (sun_teeth + planet_teeth) / 2"
}
],
[
"variable.set",
{
"name": "sun_undercut_limit",
"expr": "1.02 - sun_teeth * sin(pressure_angle)^2 / 2"
}
],
[
"variable.set",
{
"name": "planet_undercut_limit",
"expr": "1.02 - planet_teeth * sin(pressure_angle)^2 / 2"
}
],
[
"variable.set",
{
"name": "sun_shift",
"expr": "max(sun_undercut_limit, 0) - max(planet_undercut_limit, 0)"
}
],
[
"variable.set",
{
"name": "planet_shift",
"expr": "-sun_shift"
}
],
[
"variable.set",
{
"name": "ring_shift",
"expr": "planet_shift"
}
],
[
"variable.set",
{
"name": "housing_diameter_max",
"expr": "200 mm"
}
],
[
"variable.set",
{
"name": "teeth_step_bound",
"expr": "10"
}
],
[
"variable.set",
{
"name": "sun_teeth_min",
"expr": "max(12, ceil(2 * (shaft_bore_radius + sun_wall_min) / tooth_module + 2.5))"
}
],
[
"variable.set",
{
"name": "planet_teeth_min",
"expr": "max(14, ceil(2 * (5 mm + planet_wall_min) / tooth_module + 2.5))"
}
],
[
"variable.set",
{
"name": "ring_teeth_most",
"expr": "min(125, floor((housing_diameter_max - 2 * wall_min - 3 * tooth_module) / tooth_module))"
}
],
[
"variable.set",
{
"name": "planet_term",
"expr": "2 * (planet_teeth_min + 0.5) / (ring_teeth_most - teeth_step_bound)"
}
],
[
"variable.set",
{
"name": "reduction_low_planet",
"expr": "if(planet_term < 0.995, (2 - planet_term) / (1 - planet_term), 9.5)"
}
],
[
"variable.set",
{
"name": "reduction_high_sun",
"expr": "1 + (ring_teeth_most - teeth_step_bound) / (sun_teeth_min + 0.5)"
}
],
[
"variable.set",
{
"name": "total_teeth_term",
"expr": "(70 + teeth_step_bound) / ring_teeth_most"
}
],
[
"variable.set",
{
"name": "reduction_high_total",
"expr": "if(total_teeth_term > 1, total_teeth_term / (total_teeth_term - 1), 99)"
}
],
[
"variable.set",
{
"name": "reduction_min",
"expr": "ceil(10 * max(3.2, reduction_low_planet)) / 10"
}
],
[
"variable.set",
{
"name": "reduction_max",
"expr": "max(reduction_min, floor(10 * min(9.5, min(reduction_high_sun, reduction_high_total))) / 10)"
}
],
[
"variable.set",
{
"name": "ring_teeth_needed",
"expr": "ceil(max(2 * (planet_teeth_min + 0.5) * (reduction - 1) / (reduction - 2) + teeth_step_bound, max((sun_teeth_min + 0.5) * (reduction - 1) + teeth_step_bound, (70 + teeth_step_bound) * (reduction - 1) / reduction)))"
}
],
[
"variable.set",
{
"name": "housing_min_gears",
"expr": "2 * wall_min + 3 * tooth_module + tooth_module * ring_teeth_needed"
}
],
[
"variable.set",
{
"name": "housing_min_motor",
"expr": "motors[motor].bolt_spacing * sqrt(2) + motors[motor].screw_head + 8 mm"
}
],
[
"variable.set",
{
"name": "housing_diameter_min",
"expr": "ceil(max(max(housing_min_gears, housing_min_motor), 60 mm) / 1 mm) * 1 mm"
}
],
[
"variable.set",
{
"name": "planets_4_total",
"expr": "4 * floor(ring_teeth_fit * reduction / (reduction - 1) / 4)"
}
],
[
"variable.set",
{
"name": "planets_4_sun",
"expr": "round(planets_4_total / reduction)"
}
],
[
"variable.set",
{
"name": "planets_4_planet",
"expr": "planets_4_total / 2 - planets_4_sun"
}
],
[
"variable.set",
{
"name": "planets_4_shift",
"expr": "max(1.02 - planets_4_sun * sin(pressure_angle)^2 / 2, 0) - max(1.02 - planets_4_planet * sin(pressure_angle)^2 / 2, 0)"
}
],
[
"variable.set",
{
"name": "planets_4_gap",
"expr": "tooth_module * (planets_4_sun + planets_4_planet) * sin(180 deg / 4) - tooth_module * planets_4_planet - 2 * tooth_module * (1 - planets_4_shift)"
}
],
[
"variable.set",
{
"name": "planets_5_total",
"expr": "10 * floor(ring_teeth_fit * reduction / (reduction - 1) / 10)"
}
],
[
"variable.set",
{
"name": "planets_5_sun",
"expr": "round(planets_5_total / reduction)"
}
],
[
"variable.set",
{
"name": "planets_5_planet",
"expr": "planets_5_total / 2 - planets_5_sun"
}
],
[
"variable.set",
{
"name": "planets_5_shift",
"expr": "max(1.02 - planets_5_sun * sin(pressure_angle)^2 / 2, 0) - max(1.02 - planets_5_planet * sin(pressure_angle)^2 / 2, 0)"
}
],
[
"variable.set",
{
"name": "planets_5_gap",
"expr": "tooth_module * (planets_5_sun + planets_5_planet) * sin(180 deg / 5) - tooth_module * planets_5_planet - 2 * tooth_module * (1 - planets_5_shift)"
}
],
[
"variable.set",
{
"name": "planets_6_total",
"expr": "6 * floor(ring_teeth_fit * reduction / (reduction - 1) / 6)"
}
],
[
"variable.set",
{
"name": "planets_6_sun",
"expr": "round(planets_6_total / reduction)"
}
],
[
"variable.set",
{
"name": "planets_6_planet",
"expr": "planets_6_total / 2 - planets_6_sun"
}
],
[
"variable.set",
{
"name": "planets_6_shift",
"expr": "max(1.02 - planets_6_sun * sin(pressure_angle)^2 / 2, 0) - max(1.02 - planets_6_planet * sin(pressure_angle)^2 / 2, 0)"
}
],
[
"variable.set",
{
"name": "planets_6_gap",
"expr": "tooth_module * (planets_6_sun + planets_6_planet) * sin(180 deg / 6) - tooth_module * planets_6_planet - 2 * tooth_module * (1 - planets_6_shift)"
}
],
[
"variable.set",
{
"name": "planet_count_max",
"expr": "if(planets_4_gap >= 1 mm, if(planets_5_gap >= 1 mm, if(planets_6_gap >= 1 mm, 6, 5), 4), 3)"
}
],
[
"variable.set",
{
"name": "sun_pitch_radius",
"expr": "tooth_module * sun_teeth / 2"
}
],
[
"variable.set",
{
"name": "sun_base_radius",
"expr": "sun_pitch_radius * cos(pressure_angle)"
}
],
[
"variable.set",
{
"name": "sun_tip_radius",
"expr": "sun_pitch_radius + tooth_module * (rack_addendum + sun_shift)"
}
],
[
"variable.set",
{
"name": "sun_root_radius",
"expr": "sun_pitch_radius - tooth_module * (rack_dedendum - sun_shift)"
}
],
[
"variable.set",
{
"name": "sun_tooth_half",
"expr": "(pi / 2 + 2 * sun_shift * tan(pressure_angle)) / sun_teeth - backlash / 2 / (2 * sun_pitch_radius)"
}
],
[
"variable.set",
{
"name": "sun_offset",
"expr": "-sun_tooth_half - (tan(pressure_angle) - pressure_angle / 1 rad)"
}
],
[
"variable.set",
{
"name": "sun_foot_radius",
"expr": "sqrt(sun_root_radius^2 + 2 * sun_root_radius * root_fillet)"
}
],
[
"variable.set",
{
"name": "sun_flank_radius",
"expr": "max(sun_base_radius, sun_foot_radius + 0.06 mm)"
}
],
[
"variable.set",
{
"name": "sun_tooth_t0",
"expr": "sqrt((sun_flank_radius / sun_base_radius)^2 - 1)"
}
],
[
"variable.set",
{
"name": "sun_tooth_ta",
"expr": "sqrt((sun_tip_radius / sun_base_radius)^2 - 1)"
}
],
[
"variable.set",
{
"name": "sun_flank_angle",
"expr": "sun_offset + sun_tooth_t0 - atan(sun_tooth_t0) / 1 rad"
}
],
[
"variable.set",
{
"name": "sun_foot_x",
"expr": "sun_foot_radius * cos(sun_flank_angle * 1 rad)"
}
],
[
"variable.set",
{
"name": "sun_foot_y",
"expr": "sun_foot_radius * sin(sun_flank_angle * 1 rad)"
}
],
[
"variable.set",
{
"name": "sun_fillet_centre_a",
"expr": "sun_flank_angle - atan(root_fillet / sun_foot_radius) / 1 rad"
}
],
[
"variable.set",
{
"name": "sun_fillet_centre_r",
"expr": "sqrt(sun_foot_radius^2 + root_fillet^2)"
}
],
[
"variable.set",
{
"name": "sun_fillet_x",
"expr": "sun_fillet_centre_r * cos(sun_fillet_centre_a * 1 rad)"
}
],
[
"variable.set",
{
"name": "sun_fillet_y",
