}
],
[
"variable.set",
{
"name": "sun_root_x",
"expr": "sun_fillet_x * sun_root_radius / (sun_root_radius + root_fillet)"
}
],
[
"variable.set",
{
"name": "sun_root_y",
"expr": "sun_fillet_y * sun_root_radius / (sun_root_radius + root_fillet)"
}
],
[
"variable.set",
{
"name": "sun_tooth_step",
"expr": "360 deg / sun_teeth"
}
],
[
"variable.set",
{
"name": "planet_pitch_radius",
"expr": "tooth_module * planet_teeth / 2"
}
],
[
"variable.set",
{
"name": "planet_base_radius",
