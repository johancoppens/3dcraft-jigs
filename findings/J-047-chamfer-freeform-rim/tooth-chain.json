}
],
[
"variable.set",
{
"name": "planet_bearing_row",
"expr": "if(planet_bearings[5].outside / 2 <= planet_bearing_room, 5, if(planet_bearings[4].outside / 2 <= planet_bearing_room, 4, if(planet_bearings[3].outside / 2 <= planet_bearing_room, 3, if(planet_bearings[2].outside / 2 <= planet_bearing_room, 2, 1))))"
}
],
