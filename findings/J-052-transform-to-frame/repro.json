[
["variable.set",{"name":"xdir_x","expr":"0"}],
["variable.set",{"name":"xdir_y","expr":"0.6"}],
["variable.set",{"name":"xdir_z","expr":"0.8"}],
["variable.set",{"name":"zdir_x","expr":"0"}],
["variable.set",{"name":"zdir_y","expr":"-0.8"}],
["variable.set",{"name":"zdir_z","expr":"0.6"}],
