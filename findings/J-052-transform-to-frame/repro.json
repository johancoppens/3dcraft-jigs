["feature.block",{"size":["100 mm","20 mm","10 mm"],"name":"Master"}],
["feature.transform",{"source":"Master","keep":true,"angle":"turn_angle","axis":["ydir_z - zdir_y","zdir_x - xdir_z","xdir_y - ydir_x"],"translate":["500 mm","0 mm","0 mm"],"name":"Placed by hand-written matrix to axis-angle"}],
